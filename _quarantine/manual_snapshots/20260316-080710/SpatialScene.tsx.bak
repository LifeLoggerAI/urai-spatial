"use client";

import { Canvas } from "@react-three/fiber";
import { Suspense, useEffect } from "react";
import Starfield from "@/spatial/scene/Starfield";
import CameraRig from "@/spatial/components/CameraRig";
import { useSceneStore } from "@/spatial/state/sceneStore";
import MemorySphere from "@/spatial/scene/MemorySphere";

function HudButton({
  label,
  active,
  onClick,
}: {
  label: string;
  active: boolean;
  onClick: () => void;
}) {
  return (
    <button
      onClick={onClick}
      style={{
        padding: "10px 14px",
        borderRadius: 10,
        border: active ? "1px solid rgba(255,255,255,0.45)" : "1px solid rgba(255,255,255,0.18)",
        background: active ? "rgba(255,255,255,0.16)" : "rgba(255,255,255,0.06)",
        color: "white",
        cursor: "pointer",
        fontSize: 13,
        letterSpacing: "0.02em",
        backdropFilter: "blur(8px)",
      }}
    >
      {label}
    </button>
  );
}

function FocusPanel() {
  const mode = useSceneStore((s) => s.mode);
  const selectedStar = useSceneStore((s) => s.selectedStar);
  const setDetailOpen = useSceneStore((s) => s.setDetailOpen);

  if (mode !== "focus" || !selectedStar) return null;

  return (
    <div
      style={{
        position: "absolute",
        top: 18,
        right: 18,
        zIndex: 120,
        width: 320,
        padding: 16,
        borderRadius: 16,
        background: "rgba(255,255,255,0.06)",
        border: "1px solid rgba(255,255,255,0.14)",
        backdropFilter: "blur(12px)",
        color: "white",
        fontFamily: "Arial, sans-serif",
        pointerEvents: "auto",
      }}
      onPointerDown={(e) => e.stopPropagation()}
    >
      <div style={{ fontSize: 11, opacity: 0.68, textTransform: "uppercase", letterSpacing: "0.14em" }}>
        Focused Memory
      </div>

      <div style={{ marginTop: 10, display: "flex", alignItems: "center", gap: 10 }}>
        <span
          style={{
            width: 14,
            height: 14,
            borderRadius: 999,
            background: selectedStar.color,
            display: "inline-block",
            boxShadow: `0 0 16px ${selectedStar.color}`,
            flex: "0 0 auto",
          }}
        />
        <div>
          <div style={{ fontSize: 22, fontWeight: 600, lineHeight: 1.1 }}>{selectedStar.signature}</div>
          <div style={{ marginTop: 4, fontSize: 12, opacity: 0.72 }}>{selectedStar.label}</div>
        </div>
      </div>

      <div style={{ marginTop: 12, fontSize: 13, opacity: 0.82, lineHeight: 1.5 }}>
        {selectedStar.summary}
      </div>

      <div
        style={{
          marginTop: 14,
          display: "grid",
          gridTemplateColumns: "92px 1fr",
          rowGap: 8,
          columnGap: 8,
          fontSize: 13,
        }}
      >
        <div style={{ opacity: 0.65 }}>Chapter</div>
        <div>{selectedStar.chapter}</div>

        <div style={{ opacity: 0.65 }}>Timeband</div>
        <div>{selectedStar.timeband}</div>

        <div style={{ opacity: 0.65 }}>Intensity</div>
        <div>{selectedStar.size.toFixed(2)}</div>

        <div style={{ opacity: 0.65 }}>Color</div>
        <div>{selectedStar.color}</div>
      </div>

      <div style={{ marginTop: 14, display: "flex", gap: 8 }}>
        <button
          onClick={() => setDetailOpen(true)}
          style={{
            padding: "10px 14px",
            borderRadius: 10,
            border: "1px solid rgba(255,255,255,0.25)",
            background: "rgba(255,255,255,0.10)",
            color: "white",
            cursor: "pointer",
            fontSize: 13,
          }}
        >
          Open Memory
        </button>
      </div>

      <div style={{ marginTop: 14, fontSize: 12, opacity: 0.68 }}>
        Press Esc or click empty space to exit focus
      </div>
    </div>
  );
}

function MemoryDetailModal() {
  const detailOpen = useSceneStore((s) => s.detailOpen);
  const selectedStar = useSceneStore((s) => s.selectedStar);
  const setDetailOpen = useSceneStore((s) => s.setDetailOpen);

  if (!detailOpen || !selectedStar) return null;

  return (
    <div
      style={{
        position: "absolute",
        inset: 0,
        zIndex: 200,
        background: "rgba(0,0,0,0.46)",
        backdropFilter: "blur(8px)",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        padding: 24,
      }}
      onPointerDown={() => setDetailOpen(false)}
    >
      <div
        style={{
          width: "min(760px, 92vw)",
          borderRadius: 20,
          border: "1px solid rgba(255,255,255,0.14)",
          background: "rgba(8,12,20,0.88)",
          boxShadow: "0 20px 80px rgba(0,0,0,0.45)",
          color: "white",
          fontFamily: "Arial, sans-serif",
          overflow: "hidden",
        }}
        onPointerDown={(e) => e.stopPropagation()}
      >
        <div
          style={{
            padding: "18px 20px",
            borderBottom: "1px solid rgba(255,255,255,0.10)",
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between",
            gap: 12,
          }}
        >
          <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
            <span
              style={{
                width: 14,
                height: 14,
                borderRadius: 999,
                background: selectedStar.color,
                display: "inline-block",
                boxShadow: `0 0 16px ${selectedStar.color}`,
              }}
            />
            <div>
              <div style={{ fontSize: 11, opacity: 0.66, textTransform: "uppercase", letterSpacing: "0.14em" }}>
                Memory Detail
              </div>
              <div style={{ marginTop: 4, fontSize: 24, fontWeight: 600 }}>
                {selectedStar.signature}
              </div>
            </div>
          </div>

          <button
            onClick={() => setDetailOpen(false)}
            style={{
              padding: "8px 12px",
              borderRadius: 10,
              border: "1px solid rgba(255,255,255,0.16)",
              background: "rgba(255,255,255,0.06)",
              color: "white",
              cursor: "pointer",
              fontSize: 13,
            }}
          >
            Close
          </button>
        </div>

        <div style={{ padding: 20, display: "grid", gap: 18 }}>
          <div>
            <div style={{ fontSize: 12, opacity: 0.64, textTransform: "uppercase", letterSpacing: "0.12em" }}>
              Node
            </div>
            <div style={{ marginTop: 6, fontSize: 18, fontWeight: 600 }}>{selectedStar.label}</div>
          </div>

          <div>
            <div style={{ fontSize: 12, opacity: 0.64, textTransform: "uppercase", letterSpacing: "0.12em" }}>
              Summary
            </div>
            <div style={{ marginTop: 8, fontSize: 14, lineHeight: 1.7, opacity: 0.88 }}>
              {selectedStar.summary}
            </div>
          </div>

          <div
            style={{
              display: "grid",
              gridTemplateColumns: "repeat(2, minmax(0, 1fr))",
              gap: 14,
            }}
          >
            <div
              style={{
                padding: 14,
                borderRadius: 14,
                background: "rgba(255,255,255,0.04)",
                border: "1px solid rgba(255,255,255,0.08)",
              }}
            >
              <div style={{ fontSize: 12, opacity: 0.64, textTransform: "uppercase", letterSpacing: "0.12em" }}>
                Chapter
              </div>
              <div style={{ marginTop: 8, fontSize: 16, fontWeight: 600 }}>{selectedStar.chapter}</div>
            </div>

            <div
              style={{
                padding: 14,
                borderRadius: 14,
                background: "rgba(255,255,255,0.04)",
                border: "1px solid rgba(255,255,255,0.08)",
              }}
            >
              <div style={{ fontSize: 12, opacity: 0.64, textTransform: "uppercase", letterSpacing: "0.12em" }}>
                Timeband
              </div>
              <div style={{ marginTop: 8, fontSize: 16, fontWeight: 600 }}>{selectedStar.timeband}</div>
            </div>

            <div
              style={{
                padding: 14,
                borderRadius: 14,
                background: "rgba(255,255,255,0.04)",
                border: "1px solid rgba(255,255,255,0.08)",
              }}
            >
              <div style={{ fontSize: 12, opacity: 0.64, textTransform: "uppercase", letterSpacing: "0.12em" }}>
                Intensity
              </div>
              <div style={{ marginTop: 8, fontSize: 16, fontWeight: 600 }}>{selectedStar.size.toFixed(2)}</div>
            </div>

            <div
              style={{
                padding: 14,
                borderRadius: 14,
                background: "rgba(255,255,255,0.04)",
                border: "1px solid rgba(255,255,255,0.08)",
              }}
            >
              <div style={{ fontSize: 12, opacity: 0.64, textTransform: "uppercase", letterSpacing: "0.12em" }}>
                Color
              </div>
              <div style={{ marginTop: 8, fontSize: 16, fontWeight: 600 }}>{selectedStar.color}</div>
            </div>
          </div>

          <div
            style={{
              padding: 16,
              borderRadius: 16,
              background: "rgba(255,255,255,0.04)",
              border: "1px solid rgba(255,255,255,0.08)",
            }}
          >
            <div style={{ fontSize: 12, opacity: 0.64, textTransform: "uppercase", letterSpacing: "0.12em" }}>
              Narrative Placeholder
            </div>
            <div style={{ marginTop: 8, fontSize: 14, lineHeight: 1.7, opacity: 0.88 }}>
              This is the first Tier 2 memory detail surface. It is ready to be replaced with real memory text,
              event summaries, transcript fragments, symbolic tags, and replay entry points.
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}

export default function SpatialScene() {
  const { mode, setMode, selectedStar, setSelectedStar, detailOpen, setDetailOpen } = useSceneStore();

  useEffect(() => {
    const onKeyDown = (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        if (detailOpen) {
          setDetailOpen(false);
          return;
        }

        setSelectedStar(null);
        setMode("lifemap");
      }
    };

    window.addEventListener("keydown", onKeyDown);
    return () => window.removeEventListener("keydown", onKeyDown);
  }, [detailOpen, setDetailOpen, setMode, setSelectedStar]);

  const exitFocus = () => {
    setDetailOpen(false);
    setSelectedStar(null);
    setMode("lifemap");
  };

  return (
    <div
      style={{
        width: "100vw",
        height: "100vh",
        background:
          mode === "lifemap"
            ? "radial-gradient(circle at center, #050816 0%, #010104 55%, #000000 100%)"
            : mode === "focus"
              ? "radial-gradient(circle at center, #0a1020 0%, #02050b 50%, #000000 100%)"
              : "radial-gradient(circle at center, #08111f 0%, #03060c 42%, #000000 100%)",
        position: "relative",
        overflow: "hidden",
      }}
    >
      {mode === "focus" && !detailOpen ? (
        <div
          style={{
            position: "absolute",
            inset: 0,
            zIndex: 40,
            pointerEvents: "auto",
          }}
          onPointerDown={() => exitFocus()}
        />
      ) : null}

      <Canvas
        style={{ position: "relative", zIndex: 10 }}
        camera={{ position: [0, 120, 240], fov: 60 }}
      >
        <Suspense fallback={null}>
          <ambientLight intensity={0.72} />
          <pointLight position={[0, 40, 40]} intensity={1.15} />
          <pointLight position={[0, -30, -60]} intensity={0.25} />
          <CameraRig />
          <Starfield />
          <MemorySphere />
        </Suspense>
      </Canvas>

      <div
        style={{
          position: "absolute",
          top: 18,
          left: 18,
          zIndex: 120,
          display: "flex",
          flexDirection: "column",
          gap: 12,
          fontFamily: "Arial, sans-serif",
          color: "white",
          pointerEvents: "auto",
        }}
        onPointerDown={(e) => e.stopPropagation()}
      >
        <div
          style={{
            padding: "10px 12px",
            borderRadius: 12,
            background: "rgba(255,255,255,0.06)",
            border: "1px solid rgba(255,255,255,0.14)",
            backdropFilter: "blur(10px)",
            width: "fit-content",
          }}
        >
          <div style={{ fontSize: 11, opacity: 0.72, textTransform: "uppercase", letterSpacing: "0.12em" }}>
            URAI Tier 1
          </div>
          <div style={{ marginTop: 4, fontSize: 22, fontWeight: 600 }}>
            {mode === "home" ? "Home" : mode === "lifemap" ? "LifeMap" : "Focus"}
          </div>
          {selectedStar ? (
            <div style={{ marginTop: 6, fontSize: 12, opacity: 0.72 }}>
              Selected: {selectedStar.label}
            </div>
          ) : (
            <div style={{ marginTop: 6, fontSize: 12, opacity: 0.72 }}>
              {mode === "lifemap" ? "Click any star" : "Enter LifeMap to select"}
            </div>
          )}
        </div>

        <div style={{ display: "flex", gap: 8 }}>
          <HudButton
            label="Home"
            active={mode === "home"}
            onClick={() => {
              setDetailOpen(false);
              setSelectedStar(null);
              setMode("home");
            }}
          />
          <HudButton
            label="LifeMap"
            active={mode === "lifemap"}
            onClick={() => {
              setDetailOpen(false);
              setSelectedStar(null);
              setMode("lifemap");
            }}
          />
          <HudButton
            label="Clear Focus"
            active={mode === "focus"}
            onClick={() => {
              setDetailOpen(false);
              setSelectedStar(null);
              setMode("lifemap");
            }}
          />
        </div>
      </div>

      <FocusPanel />
      <MemoryDetailModal />
    </div>
  );
}
