{
  "hosting": {
    "public": "urai-tier1/out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "redirects": [],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      },
      {
        "source": "/release-fingerprint.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/stripe/create-checkout-session",
        "function": {
          "functionId": "createStripeCheckout",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/stripe/create-portal-session",
        "function": {
          "functionId": "createStripeCustomerPortal",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/entitlement",
        "function": {
          "functionId": "getStripeEntitlement",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/stripe/webhook",
        "function": {
          "functionId": "handleStripeWebhook",
          "region": "us-central1"
        }
      }
    ]
  }
}
