      "verification_ref": "fix/spatial-release-gate-guards"
    }
  },
  "unlockRule": "Do not mark the PR ready, merge, update URAI_SPATIAL_TIER_LOCK_AUDIT.md to LOCKED, or production deploy until all required checks pass, workflow/manual evidence is attached to the PR, and signoffs.md has no Status: PENDING entries.",
  "lastUpdated": "2026-05-08"
}
