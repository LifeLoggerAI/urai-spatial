import { create } from "zustand";
import type { SceneMode } from "@/spatial/types";

type SceneState = {
  mode: SceneMode;
  selectedStarId: string | null;
  hoveredStar: string | null;

  setMode: (mode: SceneMode) => void;
  goHome: () => void;
  returnHome: () => void;
  enterSky: () => void;
  enterLifeMap: () => void;
  enterGround: () => void;
  enterReplay: () => void;
  escape: () => void;

  selectStar: (id: string) => void;
  clearSelection: () => void;
  hoverStar: (id: string | null) => void;
};

const HOME_STATE = {
  mode: "home" as SceneMode,
  selectedStarId: null,
  hoveredStar: null,
};

export const useSceneStore = create<SceneState>((set, get) => ({
  ...HOME_STATE,

  setMode: (mode) => set({ mode }),

  goHome: () => set({ ...HOME_STATE }),

  returnHome: () => set({ ...HOME_STATE }),

  enterSky: () => set({ mode: "sky" }),

  enterLifeMap: () => set({ mode: "lifemap" }),

  enterGround: () => set({ mode: "ground" }),

  enterReplay: () => set({ mode: "replay" }),

  escape: () => {
    const { mode } = get();
    if (mode === "replay") return set({ mode: "lifemap" });
    if (mode === "lifemap") return set({ mode: "sky" });
    if (mode === "sky") return set({ mode: "home" });
    return set({ ...HOME_STATE });
  },

  selectStar: (id) => set({ selectedStarId: id }),

  clearSelection: () => set({ selectedStarId: null }),

  hoverStar: (id) => set({ hoveredStar: id }),
}));
