'use client';

import React from "react";

export type ReplayDatumProps = {
  label: React.ReactNode;
  value: React.ReactNode;
  className?: string;
};

export function ReplayDatum({ label, value, className = "" }: ReplayDatumProps) {
  return (
    <div className={["grid grid-cols-[88px_1fr] gap-3 text-sm", className].join(" ")}>
      <div className="text-slate-400">{label}</div>
      <div className="text-slate-100">{value}</div>
    </div>
  );
}

export default ReplayDatum;
