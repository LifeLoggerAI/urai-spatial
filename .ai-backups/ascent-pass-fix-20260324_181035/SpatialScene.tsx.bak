"use client";

import * as THREE from "three";
import { Canvas, useFrame, useThree } from "@react-three/fiber";
import { Html } from "@react-three/drei";
import { useMemo, useRef, useState } from "react";
import type { CSSProperties } from "react";
import HomeEnvironment from "./HomeEnvironment";
import Orb from "./Orb";
import Starfield, { type SpatialStar } from "./Starfield";

type ScenePhase = "home" | "ascent" | "lifemap" | "focus" | "replay";

type StarPoint = SpatialStar & {
  summary: string;
};

function hashUnit(seed: number): number {
  const x = Math.sin(seed * 12.9898) * 43758.5453123;
  return x - Math.floor(x);
}

function lerp(a: number, b: number, t: number): number {
  return a + (b - a) * t;
}

function clamp01(v: number): number {
  return Math.max(0, Math.min(1, v));
}

function generateStars(): StarPoint[] {
  const stars: StarPoint[] = [];
  const total = 84;

  for (let i = 0; i < total; i += 1) {
    const u1 = hashUnit(1000 + i * 17);
    const u2 = hashUnit(2000 + i * 29);
    const u3 = hashUnit(3000 + i * 31);
    const u4 = hashUnit(4000 + i * 13);
    const u5 = hashUnit(5000 + i * 23);

    const band: "near" | "mid" | "far" =
      i < 18 ? "near" :
      i < 50 ? "mid" :
      "far";

    const radius =
      band === "near" ? lerp(9.5, 15.5, u1) :
      band === "mid" ? lerp(17, 28, u1) :
      lerp(28, 45, u1);

    const theta = u2 * Math.PI * 2;
    const tilt =
      band === "near" ? lerp(-4.5, 6.2, u3) :
      band === "mid" ? lerp(-7.2, 8.3, u3) :
      lerp(-10, 10.5, u3);

    const position: [number, number, number] = [
      Math.cos(theta) * radius * lerp(0.8, 1.18, u4),
      tilt,
      -radius * lerp(0.92, 1.52, u5),
    ];

    const color =
      band === "near" ? "#e3ebff" :
      band === "mid" ? "#9eb4ff" :
      "#6079df";

    stars.push({
      id: `star-${i + 1}`,
      position,
      size:
        band === "near" ? lerp(0.08, 0.14, u5) :
        band === "mid" ? lerp(0.055, 0.095, u5) :
        lerp(0.035, 0.07, u5),
      color,
      band,
      title: `Memory ${i + 1}`,
      chapter: band === "near" ? "current" : band === "mid" ? "lifemap" : "archive",
      summary:
        band === "near"
          ? "Near-band active memory node"
          : band === "mid"
            ? "Mid-band navigable memory node"
            : "Far-band atmospheric archive node",
    });
  }

  return stars;
}

function CameraRig({
  phase,
  selected,
  hovered,
  transitionT,
}: {
  phase: ScenePhase;
  selected: StarPoint | null;
  hovered: StarPoint | null;
  transitionT: number;
}) {
  const { camera, pointer } = useThree();
  const lookRef = useRef(new THREE.Vector3(0, -1.2, -10));

  useFrame(() => {
    const cam = camera as THREE.PerspectiveCamera;

    let targetPos = new THREE.Vector3(0.38, 1.0, 9.2);
    let targetLook = new THREE.Vector3(0.1, -1.45, -12.2);
    let targetFov = 53;

    if (phase === "ascent") {
      targetPos = new THREE.Vector3(
        lerp(0.38, -0.24, transitionT),
        lerp(1.0, 0.46, transitionT),
        lerp(9.2, 2.6, transitionT)
      );
      targetLook = new THREE.Vector3(
        lerp(0.1, pointer.x * 0.45, transitionT),
        lerp(-1.45, pointer.y * 0.16, transitionT),
        lerp(-12.2, -18.5, transitionT)
      );
      targetFov = lerp(53, 47, transitionT);
    } else if (phase === "lifemap") {
      targetPos = new THREE.Vector3(
        pointer.x * 0.7,
        0.44 + pointer.y * 0.34,
        2.25
      );
      targetLook = new THREE.Vector3(
        pointer.x * 1.4,
        pointer.y * 0.55,
        -19.5
      );
      targetFov = 46;
    } else if (phase === "focus" && selected) {
      targetPos = new THREE.Vector3(
        selected.position[0] * 0.14 + 0.82,
        selected.position[1] * 0.09 + 0.22,
        Math.abs(selected.position[2]) * 0.18 + 1.35
      );
      targetLook = new THREE.Vector3(
        selected.position[0] * 0.96,
        selected.position[1] * 0.96,
        selected.position[2]
      );
      targetFov = 40;
    } else if (phase === "replay" && selected) {
      targetPos = new THREE.Vector3(
        selected.position[0] * 0.04 - 0.46,
        selected.position[1] * 0.04 + 0.08,
        Math.abs(selected.position[2]) * 0.06 + 0.68
      );
      targetLook = new THREE.Vector3(
        selected.position[0],
        selected.position[1],
        selected.position[2]
      );
      targetFov = 34;
    } else if (hovered && phase === "lifemap") {
      targetLook = new THREE.Vector3(
        hovered.position[0] * 0.12,
        hovered.position[1] * 0.08,
        hovered.position[2] * 0.65
      );
    }

    const posEase =
      phase === "replay" ? 0.038 :
      phase === "focus" ? 0.052 :
      phase === "ascent" ? 0.06 :
      0.05;

    const lookEase =
      phase === "replay" ? 0.03 :
      phase === "focus" ? 0.05 :
      0.055;

    cam.position.x = lerp(cam.position.x, targetPos.x, posEase);
    cam.position.y = lerp(cam.position.y, targetPos.y, posEase);
    cam.position.z = lerp(cam.position.z, targetPos.z, posEase);

    lookRef.current.x = lerp(lookRef.current.x, targetLook.x, lookEase);
    lookRef.current.y = lerp(lookRef.current.y, targetLook.y, lookEase);
    lookRef.current.z = lerp(lookRef.current.z, targetLook.z, lookEase);

    cam.lookAt(lookRef.current);
    cam.fov = lerp(cam.fov, targetFov, 0.05);
    cam.updateProjectionMatrix();
  });

  return null;
}

function SceneContent() {
  const stars = useMemo(() => generateStars(), []);
  const [phase, setPhase] = useState<ScenePhase>("home");
  const [hoveredId, setHoveredId] = useState<string | null>(null);
  const [selectedId, setSelectedId] = useState<string | null>(null);
  const [transitionT, setTransitionT] = useState(0);

  const selected = useMemo(
    () => stars.find((star) => star.id === selectedId) ?? null,
    [selectedId, stars]
  );
  const hovered = useMemo(
    () => stars.find((star) => star.id === hoveredId) ?? null,
    [hoveredId, stars]
  );

  useFrame((_, delta) => {
    if (phase === "ascent") {
      const next = clamp01(transitionT + delta * 0.55);
      setTransitionT(next);
      if (next >= 0.999) {
        setPhase("lifemap");
      }
    } else if (phase === "home") {
      if (transitionT !== 0) setTransitionT(0);
    } else {
      if (transitionT !== 1) setTransitionT(1);
    }
  });

  const worldBlend = phase === "home" ? 1 : phase === "ascent" ? 1 - transitionT * 0.82 : 0;
  const ascentBlend = phase === "ascent" ? transitionT : 0;
  const travel = phase === "home" ? 0 : phase === "ascent" ? transitionT : 1;
  const orbOpacity = phase === "home" ? 1 : phase === "ascent" ? 1 - transitionT * 0.92 : 0;
  const vignetteOpacity =
    phase === "replay" ? 0.55 :
    phase === "focus" ? 0.2 :
    0.06;

  return (
    <>
      <ambientLight intensity={phase === "home" ? 0.6 : phase === "ascent" ? 0.5 : phase === "lifemap" ? 0.28 : 0.14} />
      <directionalLight position={[4, 5, 6]} intensity={phase === "home" ? 0.85 : phase === "ascent" ? 0.65 : 0.35} color="#dfe8ff" />
      <pointLight position={[0.4, 0.2, -7.8]} intensity={phase === "home" ? 5.5 : phase === "ascent" ? 3.1 : phase === "focus" ? 2.2 : 1.4} color="#a7bbff" />

      <CameraRig phase={phase} selected={selected} hovered={hovered} transitionT={transitionT} />

      <HomeEnvironment worldBlend={worldBlend} ascentBlend={ascentBlend} />

      <group position={[0.35 - travel * 0.2, -0.12 + travel * 0.1, -8.9 - travel * 2.1]}>
        <Orb
          visible={orbOpacity > 0.01}
          position={[0, 0.22, 0]}
          intensity={1.1}
          orbScale={1.16 - travel * 0.18}
          opacity={orbOpacity}
        />
      </group>

      <Starfield
        stars={stars}
        phase={phase}
        selectedId={selectedId}
        hoveredId={hoveredId}
        travel={travel}
        onHover={setHoveredId}
        onSelect={(id) => {
          setSelectedId(id);
          setPhase("focus");
        }}
      />

      {selected ? (
        <group position={selected.position}>
          <mesh>
            <sphereGeometry args={[phase === "replay" ? 0.84 : 0.36, 28, 28]} />
            <meshBasicMaterial
              color="#f4f7ff"
              transparent
              opacity={phase === "replay" ? 0.94 : 0.76}
              blending={THREE.AdditiveBlending}
              depthWrite={false}
            />
          </mesh>

          <mesh>
            <sphereGeometry args={[phase === "replay" ? 2.7 : 1.28, 28, 28]} />
            <meshBasicMaterial
              color={phase === "replay" ? "#9db1ff" : "#8ca5ff"}
              transparent
              opacity={phase === "replay" ? 0.24 : 0.14}
              blending={THREE.AdditiveBlending}
              depthWrite={false}
            />
          </mesh>
        </group>
      ) : null}

      {phase === "focus" && selected ? (
        <mesh position={[selected.position[0], selected.position[1], selected.position[2] - 1.6]}>
          <ringGeometry args={[1.2, 2.9, 64]} />
          <meshBasicMaterial
            color="#4d69d8"
            transparent
            opacity={0.08}
            blending={THREE.AdditiveBlending}
            depthWrite={false}
            side={THREE.DoubleSide}
          />
        </mesh>
      ) : null}

      {phase === "replay" ? (
        <>
          <mesh position={[0, 0, -8.5]}>
            <sphereGeometry args={[34, 24, 24]} />
            <meshBasicMaterial
              color="#090c17"
              transparent
              opacity={0.38}
              side={THREE.BackSide}
            />
          </mesh>
          <mesh position={[0, 0, -6.4]}>
            <planeGeometry args={[32, 20]} />
            <meshBasicMaterial
              color="#364a96"
              transparent
              opacity={0.055}
              blending={THREE.AdditiveBlending}
              depthWrite={false}
            />
          </mesh>
        </>
      ) : null}

      <Html fullscreen>
        <div
          style={{
            position: "absolute",
            inset: 0,
            pointerEvents: "none",
            display: "flex",
            flexDirection: "column",
            justifyContent: "space-between",
            padding: "20px",
            color: "rgba(233,238,255,0.92)",
            fontFamily: "ui-sans-serif, system-ui, sans-serif",
            background:
              phase === "replay"
                ? "radial-gradient(circle at 50% 50%, rgba(110,136,255,0.08), rgba(0,0,0,0) 42%), linear-gradient(180deg, rgba(2,4,10,0.38), rgba(2,4,10,0.58))"
                : phase === "focus"
                  ? "radial-gradient(circle at 50% 50%, rgba(100,122,255,0.04), rgba(0,0,0,0) 38%), linear-gradient(180deg, rgba(2,4,10,0.15), rgba(2,4,10,0.3))"
                  : "linear-gradient(180deg, rgba(2,4,10,0.1), rgba(2,4,10,0.22))",
          }}
        >
          <div style={{ display: "flex", justifyContent: "space-between", gap: 12, alignItems: "flex-start" }}>
            <div style={{ pointerEvents: "auto", display: "flex", gap: 8, flexWrap: "wrap" }}>
              <button
                onClick={() => {
                  setPhase("home");
                  setSelectedId(null);
                  setHoveredId(null);
                  setTransitionT(0);
                }}
                style={buttonStyle}
              >
                Home
              </button>

              <button
                onClick={() => {
                  setSelectedId(null);
                  setHoveredId(null);
                  setTransitionT(0);
                  setPhase("ascent");
                }}
                style={buttonStyle}
              >
                Enter LifeMap
              </button>

              <button
                onClick={() => {
                  if (selected) setPhase("focus");
                }}
                style={buttonStyle}
              >
                Focus
              </button>

              <button
                onClick={() => {
                  if (selected) setPhase("replay");
                }}
                style={buttonStyle}
              >
                Replay
              </button>
            </div>

            <div
              style={{
                maxWidth: 420,
                textAlign: "right",
                fontSize: 12,
                letterSpacing: "0.12em",
                textTransform: "uppercase",
                opacity: 0.74,
              }}
            >
              {phase}
            </div>
          </div>

          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-end", gap: 16 }}>
            <div style={{ maxWidth: 560 }}>
              <div style={{ fontSize: 13, opacity: 0.68, letterSpacing: "0.12em", textTransform: "uppercase" }}>
                {selected ? selected.chapter : phase === "home" ? "arrival" : phase === "ascent" ? "transition" : "navigation"}
              </div>
              <div style={{ fontSize: 28, lineHeight: 1.1, marginTop: 6 }}>
                {selected ? selected.title : phase === "home" ? "UrAi" : phase === "ascent" ? "Ascent" : "LifeMap"}
              </div>
              <div style={{ fontSize: 14, lineHeight: 1.45, marginTop: 10, opacity: 0.8 }}>
                {selected
                  ? selected.summary
                  : phase === "home"
                    ? "Grounded home state with a world anchor and visible pre-flight atmosphere."
                    : phase === "ascent"
                      ? "Camera-led travel with near, mid, and far parallax carrying the scene forward into memory space."
                      : "Deterministic starfield with stronger depth separation and reduced shell-swap feel."}
              </div>
            </div>

            <div style={{ pointerEvents: "auto", display: "flex", gap: 8 }}>
              {selected ? (
                <>
                  <button
                    onClick={() => setPhase(phase === "replay" ? "focus" : "replay")}
                    style={buttonStyle}
                  >
                    {phase === "replay" ? "Focus View" : "Replay View"}
                  </button>

                  <button
                    onClick={() => {
                      setPhase("lifemap");
                    }}
                    style={buttonStyle}
                  >
                    Return
                  </button>
                </>
              ) : (
                <button
                  onClick={() => {
                    setTransitionT(0);
                    setPhase("ascent");
                  }}
                  style={buttonStyle}
                >
                  Begin Ascent
                </button>
              )}
            </div>
          </div>

          <div
            style={{
              position: "absolute",
              inset: 0,
              background: `radial-gradient(circle at 50% 50%, rgba(0,0,0,0) 32%, rgba(0,0,0,${vignetteOpacity}) 100%)`,
              pointerEvents: "none",
            }}
          />
        </div>
      </Html>
    </>
  );
}

const buttonStyle: CSSProperties = {
  appearance: "none",
  border: "1px solid rgba(173, 191, 255, 0.28)",
  background: "rgba(10, 14, 28, 0.55)",
  color: "rgba(238, 242, 255, 0.94)",
  borderRadius: 999,
  padding: "10px 14px",
  fontSize: 12,
  letterSpacing: "0.08em",
  textTransform: "uppercase",
  cursor: "pointer",
  backdropFilter: "blur(10px)",
};

export default function SpatialScene() {
  return (
    <div
      style={{
        position: "relative",
        width: "100%",
        height: "100%",
        minHeight: "100dvh",
        overflow: "hidden",
        background: "#02030a",
      }}
    >
      <Canvas
        dpr={[1, 1.75]}
        gl={{ antialias: true, alpha: false }}
        camera={{ position: [0.38, 1.0, 9.2], fov: 53, near: 0.1, far: 240 }}
      >
        <SceneContent />
      </Canvas>
    </div>
  );
}
