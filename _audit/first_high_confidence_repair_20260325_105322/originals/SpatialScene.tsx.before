"use client";

import React, { useCallback, useEffect, useMemo, useRef, useState } from "react";
import { Canvas, ThreeEvent, useFrame } from "@react-three/fiber";
import * as THREE from "three";

type SceneMode = "home" | "lifemap" | "focus" | "replay";
type TransitionPhase = "idle" | "ascend" | "descend" | "focus" | "replay";

type StarNode = {
  id: string;
  position: [number, number, number];
  size: number;
  color: string;
  title: string;
  label: string;
  summary: string;
  detail: string;
  chapter: string;
  signature: string;
  timeband: string;
  isReplay: boolean;
};

const STAR_SEED = 19830414;
const STAR_COUNT = 42;
const TRANSITION_MS = 900;

function mulberry32(seed: number) {
  let t = seed >>> 0;
  return function next() {
    t += 0x6d2b79f5;
    let r = Math.imul(t ^ (t >>> 15), 1 | t);
    r ^= r + Math.imul(r ^ (r >>> 7), 61 | r);
    return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
  };
}

function buildSpatialStars(seed: number, count: number): StarNode[] {
  const rnd = mulberry32(seed);
  const colors = ["#dbeafe", "#bfdbfe", "#c7d2fe", "#93c5fd", "#a5b4fc", "#e0f2fe"];
  const chapters = ["Threshold", "Recovery", "Forge", "Signal", "Orbit", "Recall"];
  const timebands = ["childhood", "origin", "breakthrough", "winter", "summer", "present"];
  const out: StarNode[] = [];

  for (let i = 0; i < count; i += 1) {
    const ring = 10 + rnd() * 22;
    const theta = rnd() * Math.PI * 2;
    const phi = (rnd() - 0.5) * 1.4;

    const x = Math.cos(theta) * ring + (rnd() - 0.5) * 2.4;
    const y = Math.sin(phi) * 12 + (rnd() - 0.5) * 1.6;
    const z = Math.sin(theta) * ring + (rnd() - 0.5) * 8;

    out.push({
      id: `star-${i + 1}`,
      position: [Number(x.toFixed(4)), Number(y.toFixed(4)), Number(z.toFixed(4))],
      size: Number((0.08 + rnd() * 0.22).toFixed(4)),
      color: colors[i % colors.length],
      title: `Memory ${i + 1}`,
      label: `Star ${i + 1}`,
      summary: `Anchor ${i + 1} across the URAI life map.`,
      detail: `Locked memory node used to stabilize Home, LifeMap, Focus, and Replay as one continuous world.`,
      chapter: chapters[i % chapters.length],
      signature: `SIG-${String(i + 1).padStart(2, "0")}`,
      timeband: timebands[i % timebands.length],
      isReplay: i % 3 === 0,
    });
  }

  out[0] = {
    ...out[0],
    title: "Forge",
    label: "Forge",
    summary: "Primary focus/replay anchor.",
    detail: "Primary focus and replay target used for the authority lock pass.",
    chapter: "Forge",
    signature: "FORGE-ANCHOR",
    timeband: "present",
    isReplay: true,
    size: 0.32,
  };

  return out;
}

function vec3(x: number, y: number, z: number) {
  return new THREE.Vector3(x, y, z);
}

function modeLabel(mode: SceneMode, selectedStar: StarNode | null) {
  if ((mode === "focus" || mode === "replay") && selectedStar?.title) return selectedStar.title.toUpperCase();
  return mode.toUpperCase();
}

function lowerLabel(mode: SceneMode, selectedStar: StarNode | null) {
  if ((mode === "focus" || mode === "replay") && selectedStar?.title) return selectedStar.title;
  return mode;
}

function useStableStars() {
  return useMemo(() => buildSpatialStars(STAR_SEED, STAR_COUNT), []);
}

function useSceneController(stars: StarNode[]) {
  const [mode, setMode] = useState<SceneMode>("home");
  const [transitionPhase, setTransitionPhase] = useState<TransitionPhase>("idle");
  const [selectedStar, setSelectedStar] = useState<StarNode | null>(null);
  const timerRef = useRef<number | null>(null);

  const clearTimer = useCallback(() => {
    if (timerRef.current !== null) {
      window.clearTimeout(timerRef.current);
      timerRef.current = null;
    }
  }, []);

  const runPhase = useCallback(
    (phase: TransitionPhase, finalMode: SceneMode, finalStar: StarNode | null, ms = TRANSITION_MS) => {
      clearTimer();
      setTransitionPhase(phase);
      timerRef.current = window.setTimeout(() => {
        setMode(finalMode);
        setSelectedStar(finalStar);
        setTransitionPhase("idle");
        timerRef.current = null;
      }, ms);
    },
    [clearTimer]
  );

  const enterLifeMap = useCallback(() => {
    if (mode === "lifemap" && transitionPhase === "idle") return;
    runPhase("ascend", "lifemap", null);
  }, [mode, transitionPhase, runPhase]);

  const returnHome = useCallback(() => {
    runPhase("descend", "home", null);
  }, [runPhase]);

  const focusStar = useCallback(
    (star: StarNode) => {
      setSelectedStar(star);
      runPhase("focus", "focus", star);
    },
    [runPhase]
  );

  const enterReplay = useCallback(() => {
    if (!selectedStar) return;
    runPhase("replay", "replay", selectedStar);
  }, [runPhase, selectedStar]);

  const exitReplay = useCallback(() => {
    if (!selectedStar) {
      setMode("lifemap");
      setTransitionPhase("idle");
      return;
    }
    runPhase("focus", "focus", selectedStar, 550);
  }, [runPhase, selectedStar]);

  const exitFocus = useCallback(() => {
    clearTimer();
    setMode("lifemap");
    setTransitionPhase("idle");
  }, [clearTimer]);

  useEffect(() => {
    return () => clearTimer();
  }, [clearTimer]);

  useEffect(() => {
    function onKeyDown(event: KeyboardEvent) {
      if (event.key === "Escape") {
        if (mode === "replay") {
          event.preventDefault();
          exitReplay();
          return;
        }
        if (mode === "focus") {
          event.preventDefault();
          exitFocus();
          return;
        }
        if (mode === "lifemap") {
          event.preventDefault();
          returnHome();
          return;
        }
      }

      if ((event.key === "Enter" || event.key === " ") && mode === "home") {
        event.preventDefault();
        enterLifeMap();
        return;
      }

      if (event.key.toLowerCase() === "r" && mode === "focus" && selectedStar?.isReplay) {
        event.preventDefault();
        enterReplay();
      }

      if (event.key === "Backspace" && mode === "focus") {
        event.preventDefault();
        exitFocus();
      }
    }

    window.addEventListener("keydown", onKeyDown);
    return () => window.removeEventListener("keydown", onKeyDown);
  }, [mode, selectedStar, enterLifeMap, enterReplay, exitFocus, exitReplay, returnHome]);

  useEffect(() => {
    if (!selectedStar && stars.length > 0) {
      setSelectedStar(stars[0]);
    }
  }, [selectedStar, stars]);

  return {
    mode,
    transitionPhase,
    selectedStar,
    setSelectedStar,
    enterLifeMap,
    returnHome,
    focusStar,
    enterReplay,
    exitReplay,
    exitFocus,
  };
}

function CameraRig({
  mode,
  selectedStar,
  transitionPhase,
}: {
  mode: SceneMode;
  selectedStar: StarNode | null;
  transitionPhase: TransitionPhase;
}) {
  const lookAtRef = useRef(new THREE.Vector3(0, 0, 0));
  const desiredPos = useRef(new THREE.Vector3(0, 0.4, 12));
  const desiredLook = useRef(new THREE.Vector3(0, 0, 0));
  const tmpOrbit = useRef(new THREE.Vector3());

  useFrame(({ camera }) => {
    const t = performance.now() * 0.001;

    if (mode === "home") {
      desiredPos.current.set(0, 0.3, 12);
      desiredLook.current.set(0, 0.2, 0);
    } else if (mode === "lifemap") {
      desiredPos.current.set(0, 1.8, 38);
      desiredLook.current.set(0, 0, 0);
    } else if (selectedStar) {
      const [sx, sy, sz] = selectedStar.position;
      const starVec = vec3(sx, sy, sz);
      const dir = starVec.clone().normalize();
      const focusDistance = mode === "replay" ? 4.8 : 6.4;
      desiredPos.current.copy(starVec.clone().add(dir.multiplyScalar(focusDistance)));
      desiredLook.current.copy(starVec);

      if (mode === "replay") {
        tmpOrbit.current.set(
          Math.sin(t * 0.55) * 0.55,
          Math.cos(t * 0.38) * 0.28,
          Math.cos(t * 0.52) * 0.48
        );
        desiredPos.current.add(tmpOrbit.current);
      }
    }

    const phaseBoost = transitionPhase === "ascend" || transitionPhase === "descend" ? 0.085 : 0.065;
    camera.position.lerp(desiredPos.current, phaseBoost);
    lookAtRef.current.lerp(desiredLook.current, phaseBoost);
    camera.lookAt(lookAtRef.current);
  });

  return null;
}

function Atmosphere({
  mode,
  transitionPhase,
}: {
  mode: SceneMode;
  transitionPhase: TransitionPhase;
}) {
  const fog = useMemo(() => new THREE.FogExp2("#02040a", 0.035), []);
  useFrame(({ scene }) => {
    const sceneAny = scene as THREE.Scene;
    if (mode === "home") {
      sceneAny.background = new THREE.Color("#02040a");
      fog.color.set("#02040a");
      fog.density = transitionPhase === "ascend" ? 0.03 : 0.038;
    } else if (mode === "lifemap") {
      sceneAny.background = new THREE.Color("#01030a");
      fog.color.set("#01030a");
      fog.density = 0.016;
    } else if (mode === "focus") {
      sceneAny.background = new THREE.Color("#01020a");
      fog.color.set("#01020a");
      fog.density = 0.022;
    } else {
      sceneAny.background = new THREE.Color("#000108");
      fog.color.set("#000108");
      fog.density = 0.028;
    }
    sceneAny.fog = fog;
  });
  return null;
}

function Orb({
  mode,
  transitionPhase,
  onActivate,
}: {
  mode: SceneMode;
  transitionPhase: TransitionPhase;
  onActivate: () => void;
}) {
  const meshRef = useRef<THREE.Mesh>(null);
  const glowRef = useRef<THREE.Mesh>(null);
  const matRef = useRef<THREE.MeshBasicMaterial>(null);
  const glowMatRef = useRef<THREE.MeshBasicMaterial>(null);

  useFrame(() => {
    const mesh = meshRef.current;
    const glow = glowRef.current;
    const mat = matRef.current;
    const glowMat = glowMatRef.current;
    if (!mesh || !glow || !mat || !glowMat) return;

    const t = performance.now() * 0.001;
    const homeVisible = mode === "home" || transitionPhase === "descend";
    const targetOpacity = homeVisible ? 0.98 : 0.0;
    const targetScale = mode === "home" ? 1.0 : transitionPhase === "descend" ? 0.72 : 0.18;
    const pulse = 1 + Math.sin(t * 1.2) * 0.03;

    mat.opacity = THREE.MathUtils.lerp(mat.opacity, targetOpacity, 0.08);
    glowMat.opacity = THREE.MathUtils.lerp(glowMat.opacity, targetOpacity * 0.18, 0.08);

    mesh.scale.lerp(new THREE.Vector3(targetScale * pulse, targetScale * pulse, targetScale * pulse), 0.08);
    glow.scale.lerp(new THREE.Vector3(targetScale * 2.4, targetScale * 2.4, targetScale * 2.4), 0.08);

    mesh.rotation.y += 0.003;
    mesh.rotation.x += 0.0012;
    glow.rotation.z -= 0.0018;

    const visible = mat.opacity > 0.01 || glowMat.opacity > 0.01;
    mesh.visible = visible;
    glow.visible = visible;
  });

  return (
    <group position={[0, 0.2, 0]}>
      <mesh
        ref={meshRef}
        onClick={(event: ThreeEvent<MouseEvent>) => {
          event.stopPropagation();
          if (mode === "home") onActivate();
        }}
      >
        <sphereGeometry args={[0.55, 32, 32]} />
        <meshBasicMaterial ref={matRef} color="#f3f4f6" transparent opacity={0.98} />
      </mesh>

      <mesh ref={glowRef} rotation={[-Math.PI / 2, 0, 0]}>
        <ringGeometry args={[0.82, 1.72, 48]} />
        <meshBasicMaterial
          ref={glowMatRef}
          color="#dbeafe"
          transparent
          opacity={0.18}
          side={THREE.DoubleSide}
          depthWrite={false}
        />
      </mesh>
    </group>
  );
}

function Ground({ mode }: { mode: SceneMode }) {
  const matRef = useRef<THREE.MeshBasicMaterial>(null);

  useFrame(() => {
    const mat = matRef.current;
    if (!mat) return;
    const targetOpacity = mode === "home" ? 0.22 : 0.06;
    mat.opacity = THREE.MathUtils.lerp(mat.opacity, targetOpacity, 0.06);
  });

  return (
    <mesh rotation={[-Math.PI / 2, 0, 0]} position={[0, -1.2, 0]}>
      <circleGeometry args={[12, 64]} />
      <meshBasicMaterial ref={matRef} color="#6b7280" transparent opacity={0.22} />
    </mesh>
  );
}

function FocusAnchor({
  selectedStar,
  mode,
}: {
  selectedStar: StarNode | null;
  mode: SceneMode;
}) {
  const groupRef = useRef<THREE.Group>(null);

  useFrame(() => {
    if (!groupRef.current || !selectedStar || (mode !== "focus" && mode !== "replay")) return;
    const t = performance.now() * 0.001;
    groupRef.current.rotation.y += mode === "replay" ? 0.01 : 0.004;
    groupRef.current.position.y = selectedStar.position[1] + Math.sin(t * 1.1) * 0.06;
  });

  if (!selectedStar || (mode !== "focus" && mode !== "replay")) return null;

  return (
    <group ref={groupRef} position={selectedStar.position}>
      <mesh>
        <sphereGeometry args={[selectedStar.size * (mode === "replay" ? 3.2 : 2.4), 24, 24]} />
        <meshBasicMaterial
          color={selectedStar.color}
          transparent
          opacity={mode === "replay" ? 0.18 : 0.12}
          depthWrite={false}
        />
      </mesh>
      <mesh rotation={[-Math.PI / 2, 0, 0]}>
        <ringGeometry args={[selectedStar.size * 3.1, selectedStar.size * 4.6, 40]} />
        <meshBasicMaterial
          color={selectedStar.color}
          transparent
          opacity={mode === "replay" ? 0.22 : 0.14}
          side={THREE.DoubleSide}
          depthWrite={false}
        />
      </mesh>
    </group>
  );
}

function StarField({
  stars,
  mode,
  selectedStar,
  isTransitioning,
  onSelect,
}: {
  stars: StarNode[];
  mode: SceneMode;
  selectedStar: StarNode | null;
  isTransitioning: boolean;
  onSelect: (star: StarNode) => void;
}) {
  const root = useRef<THREE.Group>(null);
  const [hoveredId, setHoveredId] = useState<string | null>(null);

  useFrame((state, delta) => {
    if (!root.current) return;
    const targetVisible = mode === "home" ? 0 : 1;
    const current = root.current.userData.opacity ?? 0;
    const next = THREE.MathUtils.lerp(current, targetVisible, 1 - Math.exp(-3.8 * delta));
    root.current.userData.opacity = next;
    root.current.visible = next > 0.004;
    root.current.rotation.y = THREE.MathUtils.lerp(
      root.current.rotation.y,
      mode === "replay" ? 0.045 : mode === "focus" ? 0.022 : 0,
      1 - Math.exp(-1.8 * delta)
    );
    root.current.position.y = Math.sin(state.clock.getElapsedTime() * 0.18) * 0.04 * next;

    for (const child of root.current.children) {
      const mesh = child as THREE.Group;
      mesh.visible = next > 0.004;
    }
  });

  return (
    <group ref={root} visible={mode !== "home"}>
      {stars.map((star) => {
        const isSelected = selectedStar?.id === star.id;
        const isHovered = hoveredId === star.id;
        const scale = isSelected ? 1.9 : isHovered ? 1.4 : 1;
        const haloScale = isSelected ? 4.4 : isHovered ? 3.1 : 2.2;
        const opacity = isSelected ? 1 : 0.88;
        const haloOpacity = isSelected ? 0.2 : isHovered ? 0.13 : 0.07;
        const interactive = mode === "lifemap" && !isTransitioning;

        return (
          <group key={star.id} position={star.position}>
            <mesh
              scale={scale}
              onPointerOver={(event) => {
                if (!interactive) return;
                event.stopPropagation();
                setHoveredId(star.id);
                document.body.style.cursor = "pointer";
              }}
              onPointerOut={() => {
                setHoveredId((current) => (current === star.id ? null : current));
                document.body.style.cursor = "default";
              }}
              onClick={(event) => {
                if (!interactive) return;
                event.stopPropagation();
                onSelect(star);
              }}
            >
              <sphereGeometry args={[star.size, 18, 18]} />
              <meshBasicMaterial
                color={star.color}
                transparent
                opacity={opacity}
                blending={THREE.AdditiveBlending}
                depthWrite={false}
              />
            </mesh>

            <mesh rotation={[-Math.PI / 2, 0, 0]}>
              <ringGeometry args={[star.size * 1.8, star.size * haloScale, 32]} />
              <meshBasicMaterial
                color={star.color}
                transparent
                opacity={haloOpacity}
                side={THREE.DoubleSide}
                depthWrite={false}
              />
            </mesh>
          </group>
        );
      })}
    </group>
  );
}

function Hud({
  mode,
  transitionPhase,
  selectedStar,
  onAscend,
  onHome,
  onReplay,
  onExitReplay,
  onExitFocus,
}: {
  mode: SceneMode;
  transitionPhase: TransitionPhase;
  selectedStar: StarNode | null;
  onAscend: () => void;
  onHome: () => void;
  onReplay: () => void;
  onExitReplay: () => void;
  onExitFocus: () => void;
}) {
  const isTransitioning = transitionPhase !== "idle";
  const primaryLabel =
    mode === "home"
      ? "Enter LifeMap"
      : mode === "lifemap"
      ? "Return Home"
      : mode === "focus"
      ? selectedStar?.isReplay
        ? "Enter Replay"
        : "Back to LifeMap"
      : "Exit Replay";

  const primaryAction =
    mode === "home"
      ? onAscend
      : mode === "lifemap"
      ? onHome
      : mode === "focus"
      ? selectedStar?.isReplay
        ? onReplay
        : onExitFocus
      : onExitReplay;

  return (
    <div className="pointer-events-none absolute inset-0 z-20">
      <div className="absolute left-0 right-0 top-0 flex items-start justify-between p-6">
        <div className="max-w-xl rounded-3xl border border-white/10 bg-black/30 px-5 py-4 text-white shadow-[0_18px_64px_rgba(0,0,0,0.34)] backdrop-blur-xl">
          <div className="text-[10px] uppercase tracking-[0.34em] text-white/55">URAI Experience Canon</div>
          <div className="mt-2 text-2xl font-medium tracking-[0.06em] text-white/95">
            {modeLabel(mode, selectedStar)}
          </div>
          <div className="mt-2 text-sm text-white/70">
            {mode === "home" && "Grounded entry state. Click the orb or press Enter to ascend."}
            {mode === "lifemap" && "Memory field unlocked. Select a star to enter focus."}
            {mode === "focus" && selectedStar && `${selectedStar.summary} Press Esc to return.`}
            {mode === "replay" && selectedStar && `${selectedStar.detail} Press Esc to leave replay.`}
          </div>
        </div>

        <div className="rounded-3xl border border-white/10 bg-black/30 px-5 py-4 text-right text-white shadow-[0_18px_64px_rgba(0,0,0,0.34)] backdrop-blur-xl">
          <div className="text-[10px] uppercase tracking-[0.28em] text-white/45">Mode</div>
          <div className="mt-2 text-base text-white/92">{lowerLabel(mode, selectedStar)}</div>
          <div className="mt-2 text-xs text-white/60">phase: {transitionPhase}</div>
        </div>
      </div>

      <div className="absolute bottom-0 left-0 right-0 flex items-end justify-between p-6">
        <div className="max-w-lg rounded-3xl border border-white/10 bg-black/30 px-5 py-4 text-white shadow-[0_18px_64px_rgba(0,0,0,0.34)] backdrop-blur-xl">
          <div className="text-[10px] uppercase tracking-[0.28em] text-white/45">Selected Anchor</div>
          <div className="mt-2 text-lg text-white/94">{selectedStar?.title ?? "None"}</div>
          <div className="mt-1 text-sm text-white/68">
            {selectedStar ? `${selectedStar.chapter} · ${selectedStar.signature} · ${selectedStar.timeband}` : "No active memory."}
          </div>
        </div>

        <div className="pointer-events-auto flex gap-3">
          <button
            type="button"
            disabled={isTransitioning}
            onClick={primaryAction}
            className="rounded-2xl border border-white/10 bg-white/10 px-4 py-2 text-sm text-white/90 transition hover:bg-white/15 disabled:cursor-not-allowed disabled:opacity-40"
          >
            {primaryLabel}
          </button>

          {mode === "focus" && (
            <button
              type="button"
              disabled={isTransitioning}
              onClick={onExitFocus}
              className="rounded-2xl border border-white/10 bg-white/10 px-4 py-2 text-sm text-white/90 transition hover:bg-white/15 disabled:cursor-not-allowed disabled:opacity-40"
            >
              Exit Focus
            </button>
          )}

          {mode === "replay" && (
            <button
              type="button"
              disabled={isTransitioning}
              onClick={onExitReplay}
              className="rounded-2xl border border-white/10 bg-white/10 px-4 py-2 text-sm text-white/90 transition hover:bg-white/15 disabled:cursor-not-allowed disabled:opacity-40"
            >
              Exit Replay
            </button>
          )}
        </div>
      </div>
    </div>
  );
}

export default function SpatialScene() {
  const stars = useStableStars();
  const controller = useSceneController(stars);
  const isTransitioning = controller.transitionPhase !== "idle";

  return (
    <div className="relative h-screen w-screen overflow-hidden bg-[#02040a]">
      <Canvas
        camera={{ position: [0, 0.3, 12], fov: 44, near: 0.1, far: 200 }}
        gl={{ antialias: true, alpha: false }}
        dpr={[1, 1.75]}
      >
        <ambientLight intensity={0.75} />
        <pointLight position={[0, 4, 6]} intensity={0.8} />
        <pointLight position={[0, -2, -16]} intensity={0.28} color="#93c5fd" />

        <Atmosphere mode={controller.mode} transitionPhase={controller.transitionPhase} />
        <CameraRig
          mode={controller.mode}
          selectedStar={controller.selectedStar}
          transitionPhase={controller.transitionPhase}
        />

        <Ground mode={controller.mode} />
        <Orb
          mode={controller.mode}
          transitionPhase={controller.transitionPhase}
          onActivate={controller.enterLifeMap}
        />
        <StarField
          stars={stars}
          mode={controller.mode}
          selectedStar={controller.selectedStar}
          isTransitioning={isTransitioning}
          onSelect={controller.focusStar}
        />
        <FocusAnchor selectedStar={controller.selectedStar} mode={controller.mode} />
      </Canvas>

      <Hud
        mode={controller.mode}
        transitionPhase={controller.transitionPhase}
        selectedStar={controller.selectedStar}
        onAscend={controller.enterLifeMap}
        onHome={controller.returnHome}
        onReplay={controller.enterReplay}
        onExitReplay={controller.exitReplay}
        onExitFocus={controller.exitFocus}
      />
    </div>
  );
}
