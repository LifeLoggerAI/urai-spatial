"use client";

import type { ComponentProps } from "react";
import { Color } from "three";

type OrbProps = Omit<ComponentProps<"group">, "scale"> & {
  intensity?: number;
  orbScale?: number;
  opacity?: number;
};

export default function Orb({
  intensity = 1,
  orbScale = 1,
  opacity = 0.92,
  children,
  ...props
}: OrbProps) {
  const glow = new Color().setRGB(
    0.28 * intensity,
    0.54 * intensity,
    1.0 * intensity
  );

  return (
    <group {...props} scale={orbScale}>
      <mesh>
        <sphereGeometry args={[0.18, 32, 32]} />
        <meshBasicMaterial color={glow} transparent opacity={opacity} />
      </mesh>
      <mesh scale={1.7}>
        <sphereGeometry args={[0.18, 32, 32]} />
        <meshBasicMaterial
          color={glow}
          transparent
          opacity={Math.min(0.28 * intensity, 0.42)}
        />
      </mesh>
      <mesh scale={2.7}>
        <sphereGeometry args={[0.18, 32, 32]} />
        <meshBasicMaterial
          color={glow}
          transparent
          opacity={Math.min(0.12 * intensity, 0.18)}
        />
      </mesh>
      {children}
    </group>
  );
}
