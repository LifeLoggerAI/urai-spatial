}

function SceneField({
  phase,
  stars,
  selectedId,
  hoveredId,
  onHover,
  onSelect,
}: {
  phase: ScenePhase;
  stars: StarPoint[];
  selectedId: string | null;
  hoveredId: string | null;
  onHover: (id: string | null) => void;
  onSelect: (id: string) => void;
}) {
  const selected = stars.find((s) => s.id === selectedId) ?? null;
  const orbVisible = phase === "home";
  const mapGlow = phase === "lifemap" ? 0.22 : phase === "focus" ? 0.14 : phase === "replay" ? 0.09 : 0.05;

  return (
    <>
      <SceneEnvironment phase={phase} />
      <CameraRig phase={phase} progress={1} selected={selected} />
      <SkyShell phase={phase} />

      <ambientLight intensity={0.72} />
      <directionalLight position={[5, 6, 8]} intensity={0.85} color="#dfe9ff" />
      <pointLight position={[0, 0.12, 1.05]} intensity={orbVisible ? 12 : 2.5} color="#82b8ff" />
      <pointLight position={[0, 1.5, -10]} intensity={2.2 + mapGlow} color="#9ab5ff" />

      <Ground visible={orbVisible} />
      <Orb visible={orbVisible} position={[0, 0.15, 1.15]} intensity={1.15} orbScale={1} />

      <mesh position={[0, phase === "home" ? -0.55 : -0.22, phase === "home" ? -0.5 : -7.8]} rotation={[-Math.PI / 2, 0, 0]}>
        <ringGeometry args={[1.3, phase === "home" ? 6.8 : 10.5, 72]} />
        <meshBasicMaterial color="#2d56a8" transparent opacity={phase === "home" ? 0.05 : 0.04} />
      </mesh>

      {stars.map((star) => (
        <StarNode
          key={star.id}
          star={star}
          phase={phase}
          selected={selectedId === star.id}
          hovered={hoveredId === star.id}
          onHover={onHover}
          onSelect={onSelect}
        />
      ))}

      {selected ? <SelectedBeacon star={selected} phase={phase} /> : null}
    </>
  );
}

function Overlay({
  phase,
  selected,
}: {
  phase: ScenePhase;
  selected: StarPoint | null;
}) {
  const title =
    phase === "home"
      ? "URAI"
      : phase === "lifemap"
        ? "LifeMap"
        : phase === "focus"
          ? selected?.title ?? "Focus"
          : `Replay • ${selected?.title ?? "Memory"}`;

  const body =
    phase === "home"
      ? "A deterministic spatial core with a grounded home scene, owned sky, and cinematic entry into the LifeMap."
      : phase === "lifemap"
        ? "The field is live. Select a point to enter a memory anchor."
        : phase === "focus"
          ? selected?.summary ?? "Focus locked. Press R for replay."
          : "Replay holds a single thread.";

  const hint =
    phase === "home"
      ? "Press Enter or F, or click to enter the LifeMap."
      : phase === "lifemap"
        ? "Click a star to focus. Press Esc to return."
        : phase === "focus"
          ? "Press R for replay. Press Esc to return to the map."
          : "Replay mode. Esc steps back.";

  return (
    <div
      style={{
        position: "fixed",
        inset: 0,
        pointerEvents: "none",
        color: "#eef4ff",
        fontFamily:
          'ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
      }}
    >
      <div
        style={{
          position: "absolute",
          inset: 0,
          background:
            phase === "replay"
              ? "radial-gradient(circle at 50% 48%, rgba(40,64,124,0.14), rgba(2,3,10,0.14) 36%, rgba(2,3,10,0.38) 100%)"
              : "none",
        }}
      />

      <div
        style={{
          position: "absolute",
          top: 24,
          left: 24,
          maxWidth: 540,
        }}
      >
        <div
          style={{
            fontSize: 11,
            letterSpacing: "0.26em",
            textTransform: "uppercase",
            opacity: 0.62,
            marginBottom: 8,
          }}
        >
          Spatial Core
        </div>

        <div
          style={{
            fontSize: phase === "home" ? 35 : 32,
            lineHeight: 1.02,
            fontWeight: 600,
            marginBottom: 10,
          }}
        >
          {title}
        </div>

        <div
          style={{
            fontSize: 14,
            lineHeight: 1.5,
            opacity: 0.76,
            maxWidth: 500,
          }}
        >
          {body}
        </div>
      </div>

      <div
        style={{
          position: "absolute",
          left: 24,
          bottom: 24,
          display: "grid",
          gap: 6,
          opacity: 0.78,
          fontSize: 13,
          lineHeight: 1.35,
        }}
      >
        <div>{hint}</div>
        <div>
          Phase: <strong>{phase}</strong>
          {selected ? (
            <>
              {" "}
              • Selected: <strong>{selected.title}</strong>
            </>
          ) : null}
        </div>
      </div>

      {phase === "replay" ? (
        <div
          style={{
            position: "absolute",
            right: 24,
            bottom: 24,
            fontSize: 12,
            letterSpacing: "0.18em",
            textTransform: "uppercase",
            opacity: 0.64,
          }}
        >
          Replay mode
        </div>
      ) : null}
    </div>
  );
}

