            ? "radial-gradient(circle at 50% 78%, rgba(23,47,92,0.32), rgba(2,3,10,1) 38%, rgba(2,3,10,1) 100%)"
            : phase === "replay"
              ? "radial-gradient(circle at 50% 52%, rgba(18,30,64,0.3), rgba(2,3,10,1) 48%, rgba(2,3,10,1) 100%)"
              : "radial-gradient(circle at 50% 58%, rgba(11,22,46,0.22), rgba(2,3,10,1) 52%, rgba(2,3,10,1) 100%)",
      }}
    >
      <Canvas
        dpr={[1, 1.75]}
        gl={{ antialias: true, alpha: false }}
        camera={{ position: [0, 0.95, 7.25], fov: 42, near: 0.1, far: 260 }}
        onPointerMissed={() => {
          if (phase === "focus") {
            setHoveredId(null);
            setPhase("lifemap");
          setPhaseTick((value) => value + 1);
    setPhaseTick((value) => value + 1);
          }
        }}
      >
        <SceneField
          phase={phase}
          stars={stars}
          selectedId={selectedId}
          hoveredId={hoveredId}
          onHover={setHoveredId}
          onSelect={selectStar}
        />
      </Canvas>

      <Overlay phase={phase} selected={selected} />
    </div>
  );
}

