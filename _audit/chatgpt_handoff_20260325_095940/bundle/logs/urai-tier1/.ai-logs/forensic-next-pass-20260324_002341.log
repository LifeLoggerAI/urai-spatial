"use client";

import { useMemo } from "react";

export type SpatialStar = {
  id: string;
  position: [number, number, number];
  scale: number;
  opacity: number;
  color: string;
  featured?: boolean;
};

type ScenePhase =
  | "home"
  | "ascent"
  | "map"
  | "starFocus"
  | "arrival"
  | "replay"
  | "exitingToMap"
  | "returningHome";

type StarfieldProps = {
  visible: boolean;
  presence: number;
  interactive: boolean;
  selectedId: string | null;
  phase: ScenePhase;
  onSelectStar?: (star: SpatialStar) => void;
};

function fract(value: number) {
  return value - Math.floor(value);
}

function rand(seed: number) {
  return fract(Math.sin(seed * 127.1 + 311.7) * 43758.5453123);
}

function pickColor(seed: number) {
  const r = rand(seed);
  if (r > 0.92) return "#ffe2bf";
  if (r > 0.78) return "#eadbff";
  if (r > 0.58) return "#d9e6ff";
  return "#c9dbff";
}

function buildStars(): SpatialStar[] {
  const stars: SpatialStar[] = [];

  stars.push({
    id: "featured-core",
    position: [0.18, 6.15, -53],
    scale: 0.14,
    opacity: 0.98,
    color: "#edf4ff",
    featured: true,
  });

  for (let i = 0; i < 240; i += 1) {
    const seed = i + 1;
    const depthBand = i < 34 ? "near" : i < 104 ? "mid" : "far";

    const xSpread = depthBand === "near" ? 16 : depthBand === "mid" ? 26 : 44;
    const yMin = depthBand === "near" ? 2.0 : depthBand === "mid" ? 0.8 : -1.2;
    const yMax = depthBand === "near" ? 13.8 : depthBand === "mid" ? 17.5 : 22;
    const zBase = depthBand === "near" ? -18 : depthBand === "mid" ? -34 : -58;
    const zRange = depthBand === "near" ? 18 : depthBand === "mid" ? 28 : 52;

    const x = (rand(seed * 3.1) - 0.5) * xSpread;
    const y = yMin + rand(seed * 5.7) * (yMax - yMin);
    const z = zBase - rand(seed * 7.9) * zRange;
    const scale =
      depthBand === "near"
        ? 0.04 + rand(seed * 11.3) * 0.05
        : depthBand === "mid"
          ? 0.022 + rand(seed * 11.3) * 0.03
          : 0.01 + rand(seed * 11.3) * 0.018;
    const opacity =
      depthBand === "near"
        ? 0.18 + rand(seed * 13.7) * 0.22
        : depthBand === "mid"
          ? 0.12 + rand(seed * 13.7) * 0.18
          : 0.05 + rand(seed * 13.7) * 0.12;

    stars.push({
      id: `star-${i}`,
      position: [x, y, z],
      scale,
      opacity,
      color: pickColor(seed * 17.9),
    });
  }

  return stars;
}

export default function Starfield({
  visible,
  presence,
  interactive,
  selectedId,
  phase,
  onSelectStar,
}: StarfieldProps) {
  const stars = useMemo(() => buildStars(), []);

  if (!visible || presence <= 0.001) return null;

  const yOffset =
    phase === "home"
      ? 0
      : phase === "ascent"
        ? -1.4
        : phase === "returningHome"
          ? -0.4
          : -2.6;

  return (
    <group position={[0, yOffset, 0]}>
      {stars.map((star) => {
        const isSelected = star.id === selectedId;
        const otherDim = selectedId const otherDim = selectedId const otherDim = selectedId && !isSelected ? 0.33 : 1;const otherDim = selectedId && !isSelected ? 0.33 : 1; !isSelected ? 0.14 : 1;const otherDim = selectedId const otherDim = selectedId && !isSelected ? 0.33 : 1;const otherDim = selectedId && !isSelected ? 0.33 : 1; !isSelected ? 0.14 : 1; !isSelected ? 0.18 : 1;
        const featuredBoost = star.featured ? 1.45 : 1;
        const opacity = Math.max(
          0,
          Math.min(1, star.opacity * presence * otherDim * featuredBoost)
        );
        const scale = isSelected ? star.scale * 2.0 : star.scale;

        return (
          <group
            key={star.id}
            position={star.position}
            onClick={
              interactive && onSelectStar
                ? (event) => {
                    event.stopPropagation();
                    onSelectStar(star);
                  }
                : undefined
            }
          >
            <mesh>
              <sphereGeometry args={[scale, 12, 12]} />
              <meshBasicMaterial
                color={isSelected ? "#ffffff" : star.color}
                transparent
                opacity={opacity}
                depthWrite={false}
              />
            </mesh>

            <mesh>
              <sphereGeometry
                args={[scale * (isSelected ? 2.8 : star.featured ? 2.4 : 1.7), 12, 12]}
              />
              <meshBasicMaterial
                color={isSelected ? "#8fb8ff" : star.color}
                transparent
                opacity={
                  isSelected
                    ? 0.10 * presence
                    : star.featured
                      ? 0.04 * presence
                      : 0.03 * presence
                }
                depthWrite={false}
              />
            </mesh>
          </group>
        );
      })}
    </group>
  );
}

