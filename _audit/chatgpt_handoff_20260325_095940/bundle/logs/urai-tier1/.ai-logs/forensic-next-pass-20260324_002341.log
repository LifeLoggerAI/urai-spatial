"use client";

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import { Canvas, useFrame, useThree } from "@react-three/fiber";
import type { ThreeEvent } from "@react-three/fiber";
import { BackSide, Color, FogExp2, MathUtils, Vector3 } from "three";
import Orb from "./Orb";

type ScenePhase = "home" | "lifemap" | "focus" | "replay";

type StarPoint = {
  id: string;
  position: [number, number, number];
  color: string;
  size: number;
  title: string;
  summary: string;
  chapter: string;
};

const STAR_SEED = 19830414;
const STAR_COUNT = 42;

const TARGET_POS = new Vector3();
const TARGET_LOOK = new Vector3();
const TMP = new Vector3();

function mulberry32(seed: number) {
  let t = seed >>> 0;
  return function () {
    t += 0x6d2b79f5;
    let r = Math.imul(t ^ (t >>> 15), 1 | t);
    r ^= r + Math.imul(r ^ (r >>> 7), 61 | r);
    return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
  };
}

function buildStars(): StarPoint[] {
  const rand = mulberry32(STAR_SEED);
  const chapters = ["Origin", "Ascent", "Threshold", "Shift", "Recovery", "Signal", "Mirror"];

  return Array.from({ length: STAR_COUNT }, (_, i) => {
    const band = i % 7;
    const angle = rand() * Math.PI * 2;
    const radius = 3.4 + rand() * 9.6;
    const depth = -5 - rand() * 24 - band * 0.45;
    const x = Math.cos(angle) * radius * (0.78 + rand() * 0.38);
    const y = (rand() - 0.5) * (4.4 + band * 0.22);
    const hue = 202 + rand() * 34;
    const size = 0.05 + rand() * 0.11;
    const chapter = chapters[i % chapters.length];

    return {
      id: `star-${i + 1}`,
      position: [Number(x.toFixed(3)), Number(y.toFixed(3)), Number(depth.toFixed(3))],
      color: `hsl(${hue.toFixed(0)} 100% 88%)`,
      size,
      title: `${chapter} ${i + 1}`,
      summary: `Deterministic memory point ${i + 1} in the URAI spatial field.`,
      chapter,
    };
  });
}

function SceneEnvironment({ phase }: { phase: ScenePhase }) {
  const { scene, gl } = useThree();

  useEffect(() => {
    scene.background = new Color("#02030a");
    scene.fog = new FogExp2("#02030a", phase === "home" ? 0.034 : phase === "lifemap" ? 0.018 : phase === "focus" ? 0.014 : 0.011);
    gl.setClearColor("#02030a", 1);
  }, [gl, phase, scene]);

  return null;
}

function CameraRig({
  phase,
  selected,
}: {
  phase: ScenePhase;
  selected: StarPoint | null;
}) {
  const { camera } = useThree();
  const drift = useRef(0);

  useFrame(({ clock }, delta) => {
    const t = clock.getElapsedTime();
    drift.current = MathUtils.damp(drift.current, 1, 1.4, delta);

    let basePos: [number, number, number] = [0, 0.95, 7.25];
    let baseLook: [number, number, number] = [0, 0.08, -3];
    let wobble = 0.018;

    if (phase === "lifemap") {
      basePos = [0, 0.24, 11.6];
      baseLook = [0, 0.03, -10.8];
      wobble = 0.026;
    }

    if ((phase === "focus" || phase === "replay") && selected) {
      const [sx, sy, sz] = selected.position;
      if (phase === "focus") {
        basePos = [sx * 0.34, sy * 0.28 + 0.14, sz + 3.25];
        baseLook = [sx, sy, sz];
        wobble = 0.014;
      } else {
        basePos = [sx * 0.16, sy * 0.12 + 0.08, sz + 1.6];
        baseLook = [sx, sy, sz];
        wobble = 0.01;
      }
    }

    TARGET_POS.set(basePos[0], basePos[1], basePos[2]);
    TARGET_LOOK.set(baseLook[0], baseLook[1], baseLook[2]);

    TARGET_POS.x += Math.sin(t * 0.18) * wobble;
    TARGET_POS.y += Math.sin(t * 0.22) * wobble * 0.8;
    TARGET_LOOK.y += Math.sin(t * 0.2) * wobble * 0.45;

    const alpha = 1 - Math.exp(-delta * (phase === "replay" ? 3.6 : 2.9));
    camera.position.lerp(TARGET_POS, alpha);

    TMP.copy(TARGET_LOOK);
    camera.lookAt(TMP);
  });

  return null;
}

function SkyShell({ phase }: { phase: ScenePhase }) {
  const opacity = phase === "home" ? 0.16 : phase === "lifemap" ? 0.11 : 0.08;

  return (
    <mesh scale={[1, 1, 1]}>
      <sphereGeometry args={[82, 48, 48]} />
      <meshBasicMaterial color="#081223" side={BackSide} transparent opacity={opacity} />
    </mesh>
  );
}

function Ground({ visible }: { visible: boolean }) {
  return (
    <>
      <mesh visible={visible} rotation={[-Math.PI / 2, 0, 0]} position={[0, -1.2, -12]}>
        <planeGeometry args={[140, 140]} />
        <meshStandardMaterial color="#0a0d16" roughness={0.985} metalness={0.015} />
      </mesh>
      <mesh visible={visible} rotation={[-Math.PI / 2, 0, 0]} position={[0, -1.17, -8.2]}>
        <ringGeometry args={[0.8, 7.5, 64]} />
        <meshBasicMaterial color="#234a96" transparent opacity={0.055} />
      </mesh>
    </>
  );
}

function SelectedBeacon({ star, phase }: { star: StarPoint; phase: ScenePhase }) {
  const [x, y, z] = star.position;
  const replay = phase === "replay";

  return (
    <group position={[x, y, z]}>
      <mesh scale={replay ? 5.2 : 3.8}>
        <sphereGeometry args={[star.size, 24, 24]} />
        <meshBasicMaterial color={star.color} transparent opacity={replay ? 0.13 : 0.09} />
      </mesh>
      <mesh position={[0, replay ? -0.18 : -0.28, 0]} scale={[1, replay ? 1.8 : 1.3, 1]}>
        <cylinderGeometry args={[star.size * 0.09, star.size * 0.24, replay ? 1.6 : 1.15, 10]} />
        <meshBasicMaterial color={star.color} transparent opacity={replay ? 0.22 : 0.12} />
      </mesh>
    </group>
  );
}

function StarNode({
  star,
  phase,
  selected,
  hovered,
  onHover,
  onSelect,
}: {
  star: StarPoint;
  phase: ScenePhase;
  selected: boolean;
  hovered: boolean;
  onHover: (id: string | null) => void;
  onSelect: (id: string) => void;
}) {
  const interactive = phase === "lifemap";
  const [x, y, z] = star.position;

  const scale =
    phase === "home"
      ? 0.28
      : selected
        ? phase === "replay"
          ? 2.4
          : 1.95
        : hovered
          ? 1.32
          : 1;

  const opacity =
    phase === "home"
      ? 0.05
      : selected
        ? 1
        : hovered
          ? 0.94
          : phase === "lifemap"
            ? 0.74
            : 0.42;

  const emissiveIntensity =
    selected
      ? phase === "replay"
        ? 3.1
        : 2.35
      : hovered
        ? 1.5
        : phase === "home"
          ? 0.16
          : 0.78;

  return (
    <group position={[x, y, z]}>
      <mesh
        scale={scale}
        onPointerOver={(e: ThreeEvent<PointerEvent>) => {
          e.stopPropagation();
          if (interactive) onHover(star.id);
        }}
        onPointerOut={(e: ThreeEvent<PointerEvent>) => {
          e.stopPropagation();
          if (interactive) onHover(null);
        }}
        onClick={(e: ThreeEvent<MouseEvent>) => {
          e.stopPropagation();
          if (interactive) onSelect(star.id);
        }}
      >
        <sphereGeometry args={[star.size, 22, 22]} />
        <meshStandardMaterial
          color={star.color}
          emissive={star.color}
          emissiveIntensity={emissiveIntensity}
          transparent
          opacity={opacity}
          roughness={0.12}
          metalness={0.03}
        />
      </mesh>

      <mesh scale={selected ? (phase === "replay" ? 2.72 : 2.18) : hovered ? 1.68 : 1.36}>
        <sphereGeometry args={[star.size, 16, 16]} />
        <meshBasicMaterial color={star.color} transparent opacity={opacity * (selected ? 0.045 : 0.026)} />
      </mesh>
    </group>
  );

