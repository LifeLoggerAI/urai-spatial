import { Canvas, useFrame, useThree } from '@react-three/fiber'
import * as THREE from 'three'
import { useRef, useState, useMemo, useEffect } from 'react'

/* =========================
   CAMERA
========================= */

function CameraController({
  phase,
  transition,
  targetStar,
  onTransitionComplete
}) {
  const { camera } = useThree()
  const t = useRef(0)

  const HOME_POS = new THREE.Vector3(0, 1.6, 6)
  const HOME_LOOK = new THREE.Vector3(0, 1.2, 0)

  const LIFEMAP_POS = new THREE.Vector3(0, 0, 2)
  const LIFEMAP_LOOK = new THREE.Vector3(0, 0, -10)

  useFrame((_, delta) => {

    /* ASCENT */
    if (transition === 'ASCENT') {
      t.current += delta / 2
      const k = Math.min(t.current, 1)

      camera.position.lerpVectors(HOME_POS, LIFEMAP_POS, k)
      camera.lookAt(HOME_LOOK.clone().lerp(LIFEMAP_LOOK, k))

      if (k >= 1) {
        t.current = 0
        onTransitionComplete()
      }
    }

    /* FOCUS CONVERGENCE */
    else if (transition === 'FOCUS' && targetStar) {
      t.current += delta / 2
      const k = Math.min(t.current, 1)

      const target = targetStar.position
      const desired = target.clone().add(new THREE.Vector3(0, 0, 1.5))

      camera.position.lerpVectors(camera.position, desired, k)
      camera.lookAt(target)

      if (k >= 1) {
        t.current = 0
        onTransitionComplete()
      }
    }

    /* REPLAY DESCENT */
    else if (transition === 'DESCENT' && targetStar) {
      t.current += delta / 1.5
      const k = Math.min(t.current, 1)

      const target = targetStar.position

      const start = target.clone().add(new THREE.Vector3(0, 0, 1.5))
      const end = target.clone().add(new THREE.Vector3(0, -1.5, 0.5))

      camera.position.lerpVectors(start, end, k)
      camera.lookAt(target)

      if (k >= 1) {
        t.current = 0
        onTransitionComplete()
      }
    }

    /* IDLE STATES */
    else if (phase === 'HOME') {
      camera.position.lerp(HOME_POS, 0.05)
      camera.lookAt(HOME_LOOK)
    }

    else if (phase === 'LIFEMAP') {
      camera.position.lerp(LIFEMAP_POS, 0.02)
      camera.lookAt(LIFEMAP_LOOK)
    }

    else if (phase === 'FOCUS' && targetStar) {
      const target = targetStar.position
      const desired = target.clone().add(new THREE.Vector3(0, 0, 1.5))
      camera.position.lerp(desired, 0.05)
      camera.lookAt(target)
    }
  })

  return null
}

/* =========================
   STAR
========================= */

function Star({ data, onSelect, isHovered }) {
  const ref = useRef()

  useFrame((state) => {
    const t = state.clock.elapsedTime
    const pulse = 1 + Math.sin(t * 2 + data.id) * 0.15

    ref.current.scale.setScalar(
      data.size * pulse * (isHovered ? 1.6 : 1)
    )
  })

  return (
    <mesh
      ref={ref}
      position={data.position}
      userData={{ id: data.id }}
      onClick={(e) => {
        e.stopPropagation()
        onSelect(data)
      }}
    >
      <sphereGeometry args={[0.05, 8, 8]} />
      <meshStandardMaterial
        emissive={'#88ccff'}
        emissiveIntensity={isHovered ? 2 : 0.8 + data.intensity}
        color={'#ffffff'}
      />
    </mesh>
  )
}

/* =========================
   FIELD
========================= */

function generateStars(count) {
  const arr = []
  for (let i = 0; i < count; i++) {
    arr.push({
      id: i,
      position: new THREE.Vector3(
        (Math.random() - 0.5) * 20,
        (Math.random() - 0.5) * 20,
        -5 - Math.random() * 30
      ),
      size: 0.05 + Math.random() * 0.08,
      intensity: Math.random()
    })
  }
  return arr
}

function LifeMapField({ active, onSelect, hoveredId }) {
  const stars = useMemo(() => generateStars(200), [])
  if (!active) return null

  return (
    <>
      {stars.map((s) => (
        <Star
          key={s.id}
          data={s}
          onSelect={onSelect}
          isHovered={hoveredId === s.id}
        />
      ))}
    </>
  )
}

/* =========================
   MAIN
========================= */

export default function SpatialScene() {
  const [phase, setPhase] = useState('HOME')
  const [transition, setTransition] = useState('IDLE')
  const [inputLocked, setInputLocked] = useState(false)

  const [selectedStar, setSelectedStar] = useState(null)
  const [hoveredId, setHoveredId] = useState(null)

  /* ESC UNWIND */
  useEffect(() => {
    const handler = (e) => {
      if (e.key !== 'Escape' || inputLocked) return

      if (phase === 'REPLAY') {
        setPhase('FOCUS')
      } else if (phase === 'FOCUS') {
        setPhase('LIFEMAP')
      } else if (phase === 'LIFEMAP') {
        setPhase('HOME')
      }
    }

    window.addEventListener('keydown', handler)
    return () => window.removeEventListener('keydown', handler)
  }, [phase, inputLocked])

  const startAscent = () => {
    if (inputLocked || phase !== 'HOME') return
    setInputLocked(true)
    setTransition('ASCENT')
  }

  const startFocus = (star) => {
    if (inputLocked || phase !== 'LIFEMAP') return
    setSelectedStar(star)
    setInputLocked(true)
    setTransition('FOCUS')
  }

  const startReplay = () => {
    if (inputLocked || phase !== 'FOCUS') return
    setInputLocked(true)
    setTransition('DESCENT')
  }

  const completeTransition = () => {
    if (transition === 'ASCENT') setPhase('LIFEMAP')
    else if (transition === 'FOCUS') setPhase('FOCUS')
    else if (transition === 'DESCENT') setPhase('REPLAY')

    setTransition('IDLE')
    setInputLocked(false)
  }

  return (
    <Canvas camera={{ position: [0, 1.6, 6], fov: 50 }}>
      <ambientLight intensity={0.3} />

      <CameraController
        phase={phase}
        transition={transition}
        targetStar={selectedStar}
        onTransitionComplete={completeTransition}
      />

      {/* SKY CLICK */}
      <mesh position={[0, 0, -10]} onClick={startAscent}>
        <planeGeometry args={[100, 100]} />
        <meshBasicMaterial transparent opacity={0} />
      </mesh>

      {/* LIFEMAP */}
      <LifeMapField
        active={phase === 'LIFEMAP'}
        onSelect={startFocus}
        hoveredId={hoveredId}
      />

      {/* FOCUS CLICK → REPLAY */}
      {phase === 'FOCUS' && (
        <mesh position={[0, 0, 0]} onClick={startReplay}>
          <sphereGeometry args={[0.3, 16, 16]} />
          <meshBasicMaterial transparent opacity={0} />
        </mesh>
      )}
    </Canvas>
  )
}
