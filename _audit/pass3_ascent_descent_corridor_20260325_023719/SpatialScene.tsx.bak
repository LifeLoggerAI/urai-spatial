"use client";

import React, { useCallback, useEffect, useMemo, useRef, useState } from "react";
import * as THREE from "three";
import { Canvas, ThreeEvent, useFrame } from "@react-three/fiber";
import type { ScenePhase, SelectedStar, TransitionName } from "@/spatial/types/scene";

type StarNode = SelectedStar & {
  stability: number;
};

type TransitionState = {
  name: TransitionName;
  progress: number;
};

type WorldWeights = {
  home: number;
  lifemap: number;
  focus: number;
  replay: number;
  ascent: number;
  descent: number;
};

const DURATIONS: Record<TransitionName, number> = {
  home_to_lifemap: 2450,
  lifemap_to_home: 2600,
  lifemap_to_focus: 2050,
  focus_to_lifemap: 1880,
  focus_to_replay: 2550,
  replay_to_focus: 2150,
};

const HOME_BG = new THREE.Color("#03060c");
const LIFEMAP_BG = new THREE.Color("#020413");
const REPLAY_BG = new THREE.Color("#04070f");

function clamp01(v: number) {
  return Math.max(0, Math.min(1, v));
}

function easeIn(t: number) {
  const x = clamp01(t);
  return x * x * x;
}

function easeOut(t: number) {
  const x = clamp01(t);
  return 1 - Math.pow(1 - x, 3);
}

function easeInOut(t: number) {
  const x = clamp01(t);
  return x * x * (3 - 2 * x);
}

function heldRelease(t: number) {
  if (t <= 0.08) return t * 0.18;
  return 0.0144 + easeInOut((t - 0.08) / 0.92) * 0.9856;
}

function gravitationalPull(t: number) {
  const x = clamp01(t);
  return easeInOut(Math.pow(x, 0.82));
}

function resurfacing(t: number) {
  const x = clamp01(t);
  return 0.35 * easeIn(x) + 0.65 * easeOut(x);
}

function lerpVec(a: THREE.Vector3, b: THREE.Vector3, t: number) {
  return new THREE.Vector3(
    THREE.MathUtils.lerp(a.x, b.x, t),
    THREE.MathUtils.lerp(a.y, b.y, t),
    THREE.MathUtils.lerp(a.z, b.z, t),
  );
}

function seeded(seed: number) {
  let s = seed >>> 0;
  return () => {
    s = (1664525 * s + 1013904223) >>> 0;
    return s / 4294967296;
  };
}

function buildStars(): StarNode[] {
  const rand = seeded(19830414);
  const titles = [
    "Council",
    "Forge",
    "Anchor",
    "Echo",
    "Threshold",
    "Witness",
    "Sparrow",
    "Atlas",
    "Signal",
    "Harbor",
    "Pulse",
    "Grove",
  ];
  return titles.map((title, index) => {
    const angle = rand() * Math.PI * 2;
    const radius = 22 + rand() * 42;
    const depth = -28 - rand() * 90 - index * 2.5;
    const y = -6 + rand() * 18;
    const x = Math.cos(angle) * radius * (0.45 + rand() * 0.65);
    const size = 0.14 + rand() * 0.2;
    const intensity = 0.5 + rand() * 0.5;
    const hue = 205 + rand() * 32;
    const color = new THREE.Color(`hsl(${hue}, 70%, ${68 + rand() * 14}%)`).getStyle();
    return {
      id: `star-${index + 1}`,
      title,
      chapter: index % 2 === 0 ? "council" : "forge",
      position: [x, y, depth],
      color,
      size,
      intensity,
      stability: 0.55 + rand() * 0.45,
    };
  });
}

function buildDust(count: number, seedValue: number, minRadius: number, maxRadius: number) {
  const rand = seeded(seedValue);
  const positions = new Float32Array(count * 3);
  for (let i = 0; i < count; i += 1) {
    const theta = rand() * Math.PI * 2;
    const u = rand() * 2 - 1;
    const phi = Math.acos(u);
    const radius = minRadius + rand() * (maxRadius - minRadius);
    positions[i * 3] = radius * Math.sin(phi) * Math.cos(theta);
    positions[i * 3 + 1] = radius * Math.cos(phi) * 0.42;
    positions[i * 3 + 2] = -radius * (0.6 + rand() * 0.8);
  }
  return positions;
}

function computeWeights(phase: ScenePhase, transition: TransitionState | null): WorldWeights {
  if (!transition) {
    return {
      home: phase === "home" ? 1 : 0,
      lifemap: phase === "lifemap" ? 1 : 0,
      focus: phase === "focus" ? 1 : 0,
      replay: phase === "replay" ? 1 : 0,
      ascent: 0,
      descent: 0,
    };
  }

  const p =
    transition.name === "home_to_lifemap" || transition.name === "lifemap_to_home"
      ? heldRelease(transition.progress)
      : transition.name === "lifemap_to_focus" || transition.name === "focus_to_replay"
        ? gravitationalPull(transition.progress)
        : resurfacing(transition.progress);

  switch (transition.name) {
    case "home_to_lifemap":
      return { home: 1 - p, lifemap: p, focus: 0, replay: 0, ascent: p, descent: 0 };
    case "lifemap_to_home":
      return { home: p, lifemap: 1 - p, focus: 0, replay: 0, ascent: 0, descent: p };
    case "lifemap_to_focus":
      return { home: 0, lifemap: 1 - p, focus: p, replay: 0, ascent: 0, descent: 0 };
    case "focus_to_lifemap":
      return { home: 0, lifemap: p, focus: 1 - p, replay: 0, ascent: 0, descent: 0 };
    case "focus_to_replay":
      return { home: 0, lifemap: 0, focus: 1 - p, replay: p, ascent: 0, descent: 0 };
    case "replay_to_focus":
      return { home: 0, lifemap: 0, focus: p, replay: 1 - p, ascent: 0, descent: 0 };
    default:
      return { home: 0, lifemap: 0, focus: 0, replay: 0, ascent: 0, descent: 0 };
  }
}

function useTransitionDriver(
  phase: ScenePhase,
  setPhase: React.Dispatch<React.SetStateAction<ScenePhase>>,
  selectedId: string | null,
  setSelectedId: React.Dispatch<React.SetStateAction<string | null>>,
) {
  const [transition, setTransition] = useState<TransitionState | null>(null);

  const startTransition = useCallback(
    (name: TransitionName) => {
      if (transition) return;
      const startedAt = performance.now();
      let raf = 0;
      const step = (now: number) => {
        const duration = DURATIONS[name];
        const progress = clamp01((now - startedAt) / duration);
        setTransition({ name, progress });
        if (progress < 1) {
          raf = window.requestAnimationFrame(step);
          return;
        }

        switch (name) {
          case "home_to_lifemap":
            setPhase("lifemap");
            break;
          case "lifemap_to_home":
            setPhase("home");
            setSelectedId(null);
            break;
          case "lifemap_to_focus":
            setPhase("focus");
            break;
          case "focus_to_lifemap":
            setPhase("lifemap");
            break;
          case "focus_to_replay":
            setPhase("replay");
            break;
          case "replay_to_focus":
            setPhase("focus");
            break;
        }

        setTransition(null);
      };

      setTransition({ name, progress: 0 });
      raf = window.requestAnimationFrame(step);
      return () => window.cancelAnimationFrame(raf);
    },
    [setPhase, setSelectedId, transition],
  );

  const handleEscape = useCallback(() => {
    if (transition) return;
    if (phase === "replay") {
      startTransition("replay_to_focus");
      return;
    }
    if (phase === "focus") {
      startTransition("focus_to_lifemap");
      return;
    }
    if (phase === "lifemap") {
      startTransition("lifemap_to_home");
    }
  }, [phase, startTransition, transition]);

  useEffect(() => {
    const onKeyDown = (event: KeyboardEvent) => {
      if (event.key === "Escape") {
        event.preventDefault();
        handleEscape();
      }
    };
    window.addEventListener("keydown", onKeyDown);
    return () => window.removeEventListener("keydown", onKeyDown);
  }, [handleEscape]);

  return {
    transition,
    startTransition,
  };
}

function resolveCamera(
  phase: ScenePhase,
  transition: TransitionState | null,
  selectedStar: StarNode | null,
  elapsed: number,
) {
  const breath = Math.sin(elapsed * 0.35) * 0.08;
  const drift = Math.sin(elapsed * 0.13) * 0.15;

  const homePos = new THREE.Vector3(0, 1.68 + breath, 6.85 + drift * 0.35);
  const homeLook = new THREE.Vector3(0, 0.92, -0.3);

  const lifemapPos = new THREE.Vector3(0, 2.7 + breath * 0.7, 15.8 + drift * 0.4);
  const lifemapLook = new THREE.Vector3(0, 1.3, -54);

  const focusAnchor = selectedStar
    ? new THREE.Vector3(...selectedStar.position)
    : new THREE.Vector3(0, 1.2, -42);

  const focusPos = focusAnchor.clone().add(new THREE.Vector3(0.34, 0.44 + breath * 0.35, 5.4));
  const focusLook = focusAnchor.clone();

  const replayPos = focusAnchor.clone().add(new THREE.Vector3(0, 0.22 + breath * 0.25, 1.9));
  const replayLook = focusAnchor.clone().add(new THREE.Vector3(0, 0, -0.8));

  if (!transition) {
    if (phase === "home") return { pos: homePos, look: homeLook, fov: 53 };
    if (phase === "lifemap") return { pos: lifemapPos, look: lifemapLook, fov: 50.5 };
    if (phase === "focus") return { pos: focusPos, look: focusLook, fov: 46.8 };
    return { pos: replayPos, look: replayLook, fov: 42.2 };
  }

  const t = transition.progress;

  if (transition.name === "home_to_lifemap") {
    if (t < 0.08) {
      const q = t / 0.08;
      return {
        pos: lerpVec(homePos, new THREE.Vector3(0, 1.85, 6.55), q),
        look: lerpVec(homeLook, new THREE.Vector3(0, 0.96, -1.2), q),
        fov: THREE.MathUtils.lerp(53, 52.2, q),
      };
    }
    if (t < 0.72) {
      const q = easeInOut((t - 0.08) / 0.64);
      return {
        pos: lerpVec(new THREE.Vector3(0, 1.85, 6.55), new THREE.Vector3(0, 9.4, 11.7), q),
        look: lerpVec(new THREE.Vector3(0, 0.96, -1.2), new THREE.Vector3(0, 1.15, -24), q),
        fov: THREE.MathUtils.lerp(52.2, 50.2, q),
      };
    }
    const q = easeOut((t - 0.72) / 0.28);
    return {
      pos: lerpVec(new THREE.Vector3(0, 9.4, 11.7), lifemapPos, q),
      look: lerpVec(new THREE.Vector3(0, 1.15, -24), lifemapLook, q),
      fov: THREE.MathUtils.lerp(50.2, 50.5, q),
    };
  }

  if (transition.name === "lifemap_to_home") {
    if (t < 0.08) {
      const q = t / 0.08;
      return {
        pos: lerpVec(lifemapPos, new THREE.Vector3(0, 2.75, 15.5), q),
        look: lerpVec(lifemapLook, new THREE.Vector3(0, 1.2, -52), q),
        fov: THREE.MathUtils.lerp(50.5, 50.1, q),
      };
    }
    if (t < 0.76) {
      const q = easeInOut((t - 0.08) / 0.68);
      return {
        pos: lerpVec(new THREE.Vector3(0, 2.75, 15.5), new THREE.Vector3(0, 8.8, 11.3), q),
        look: lerpVec(new THREE.Vector3(0, 1.2, -52), new THREE.Vector3(0, 1.05, -16), q),
        fov: THREE.MathUtils.lerp(50.1, 51.8, q),
      };
    }
    const q = easeOut((t - 0.76) / 0.24);
    return {
      pos: lerpVec(new THREE.Vector3(0, 8.8, 11.3), homePos, q),
      look: lerpVec(new THREE.Vector3(0, 1.05, -16), homeLook, q),
      fov: THREE.MathUtils.lerp(51.8, 53, q),
    };
  }

  if (transition.name === "lifemap_to_focus") {
    const lockPos = new THREE.Vector3(focusAnchor.x * 0.1, 2.55, 14.4);
    const lockLook = focusAnchor.clone();
    if (t < 0.14) {
      const q = easeOut(t / 0.14);
      return {
        pos: lerpVec(lifemapPos, lockPos, q),
        look: lerpVec(lifemapLook, lockLook, q),
        fov: THREE.MathUtils.lerp(50.5, 49.2, q),
      };
    }
    const q = easeInOut((t - 0.14) / 0.86);
    return {
      pos: lerpVec(lockPos, focusPos, q),
      look: lerpVec(lockLook, focusLook, q),
      fov: THREE.MathUtils.lerp(49.2, 46.8, q),
    };
  }

  if (transition.name === "focus_to_lifemap") {
    const lockPos = new THREE.Vector3(focusAnchor.x * 0.1, 2.55, 14.4);
    const lockLook = focusAnchor.clone();
    if (t < 0.18) {
      const q = easeInOut(t / 0.18);
      return {
        pos: lerpVec(focusPos, new THREE.Vector3(focusPos.x, focusPos.y, focusPos.z + 0.35), q),
        look: lerpVec(focusLook, focusLook.clone().add(new THREE.Vector3(0, 0, -0.8)), q),
        fov: THREE.MathUtils.lerp(46.8, 47.4, q),
      };
    }
    const q = easeOut((t - 0.18) / 0.82);
    return {
      pos: lerpVec(lockPos, lifemapPos, q),
      look: lerpVec(lockLook, lifemapLook, q),
      fov: THREE.MathUtils.lerp(47.4, 50.5, q),
    };
  }

  if (transition.name === "focus_to_replay") {
    if (t < 0.12) {
      const q = easeOut(t / 0.12);
      return {
        pos: lerpVec(focusPos, focusAnchor.clone().add(new THREE.Vector3(0.18, 0.3, 4.7)), q),
        look: lerpVec(focusLook, focusLook, q),
        fov: THREE.MathUtils.lerp(46.8, 45.8, q),
      };
    }
    const q = easeInOut((t - 0.12) / 0.88);
    return {
      pos: lerpVec(focusAnchor.clone().add(new THREE.Vector3(0.18, 0.3, 4.7)), replayPos, q),
      look: lerpVec(focusLook, replayLook, q),
      fov: THREE.MathUtils.lerp(45.8, 42.2, q),
    };
  }

  const q = easeOut(t);
  return {
    pos: lerpVec(replayPos, focusPos, q),
    look: lerpVec(replayLook, focusLook, q),
    fov: THREE.MathUtils.lerp(42.2, 46.8, q),
  };
}

function Header({
  phase,
  transition,
  selectedStar,
}: {
  phase: ScenePhase;
  transition: TransitionState | null;
  selectedStar: StarNode | null;
}) {
  let text = "HOME — CLICK SKY OR BEGIN ASCENT";
  if (transition?.name === "home_to_lifemap") text = "ASCENT — RELEASE INTO LIFEMAP";
  else if (transition?.name === "lifemap_to_home") text = "DESCENT — RETURNING TO HOME";
  else if (phase === "lifemap") text = "LIFEMAP — CLICK A STAR TO ENTER FOCUS";
  else if (phase === "focus" && selectedStar) text = `${selectedStar.title.toUpperCase()} — ESC RETURNS TO LIFEMAP`;
  else if (phase === "replay" && selectedStar) text = `${selectedStar.title.toUpperCase()} — ESC RETURNS TO FOCUS`;

  return (
    <div
      style={{
        position: "absolute",
        inset: "0 auto auto 0",
        padding: "12px 14px",
        color: "rgba(235,244,255,0.92)",
        fontSize: 11,
        letterSpacing: "0.12em",
        fontFamily: "ui-monospace, SFMono-Regular, Menlo, monospace",
        pointerEvents: "none",
        zIndex: 20,
      }}
    >
      {text}
    </div>
  );
}

function Footer({
  phase,
  selectedStar,
  transition,
  onReplay,
}: {
  phase: ScenePhase;
  selectedStar: StarNode | null;
  transition: TransitionState | null;
  onReplay: () => void;
}) {
  const dim = transition ? 0.18 : 1;
  return (
    <>
      {selectedStar ? (
        <div
          style={{
            position: "absolute",
            left: "50%",
            bottom: 22,
            transform: "translateX(-50%)",
            padding: "10px 14px",
            borderRadius: 999,
            background: "rgba(3,8,16,0.54)",
            border: "1px solid rgba(124,164,255,0.18)",
            color: "rgba(240,246,255,0.92)",
            fontSize: 12,
            letterSpacing: "0.08em",
            textTransform: "uppercase",
            fontFamily: "ui-monospace, SFMono-Regular, Menlo, monospace",
            backdropFilter: "blur(10px)",
            opacity: dim,
            pointerEvents: "none",
            zIndex: 20,
          }}
        >
          {selectedStar.title}
        </div>
      ) : null}

      {phase === "focus" && selectedStar && !transition ? (
        <button
          onClick={onReplay}
          style={{
            position: "absolute",
            right: 20,
            bottom: 18,
            borderRadius: 999,
            border: "1px solid rgba(140,174,255,0.24)",
            background: "rgba(4,10,18,0.56)",
            color: "rgba(240,246,255,0.94)",
            padding: "10px 16px",
            fontSize: 12,
            letterSpacing: "0.08em",
            textTransform: "uppercase",
            fontFamily: "ui-monospace, SFMono-Regular, Menlo, monospace",
            backdropFilter: "blur(12px)",
            zIndex: 20,
            cursor: "pointer",
          }}
        >
          Replay
        </button>
      ) : null}
    </>
  );
}

