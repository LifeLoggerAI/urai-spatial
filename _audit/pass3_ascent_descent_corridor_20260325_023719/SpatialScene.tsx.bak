function LifemapField({
  stars,
  weights,
  selectedStar,
  phase,
  transition,
  onSelect,
}: {
  stars: StarNode[];
  weights: WorldWeights;
  selectedStar: StarNode | null;
  phase: ScenePhase;
  transition: TransitionState | null;
  onSelect: (id: string) => void;
}) {
  const nearDust = useMemo(() => buildDust(120, 7, 14, 40), []);
  const farDust = useMemo(() => buildDust(420, 11, 70, 190), []);
  const nearOpacity = clamp01(weights.lifemap * 0.18 + weights.focus * 0.08);
  const farOpacity = clamp01(weights.lifemap * 0.3 + weights.focus * 0.16);

  return (
    <group>
      <points>
        <bufferGeometry>
          <bufferAttribute
            attach="attributes-position"
            args={[farDust, 3]}
            count={farDust.length / 3}
            itemSize={3}
          />
        </bufferGeometry>
        <pointsMaterial
          color="#9cc5ff"
          size={0.5}
          sizeAttenuation
          transparent
          opacity={farOpacity}
          depthWrite={false}
          toneMapped={false}
        />
      </points>

      <points>
        <bufferGeometry>
          <bufferAttribute
            attach="attributes-position"
            args={[nearDust, 3]}
            count={nearDust.length / 3}
            itemSize={3}
          />
        </bufferGeometry>
        <pointsMaterial
          color="#b9d8ff"
          size={0.8}
          sizeAttenuation
          transparent
          opacity={nearOpacity}
          depthWrite={false}
          toneMapped={false}
        />
      </points>

      {stars.map((star, index) => {
        const selected = selectedStar?.id === star.id;
        const dim =
          phase === "focus" || phase === "replay" || transition?.name === "lifemap_to_focus"
            ? selected
              ? 1
              : 0.18
            : 1;
        const starOpacity = clamp01((weights.lifemap + weights.focus * 0.56) * dim);
        const haloOpacity = selected
          ? clamp01(weights.focus * 0.22 + weights.replay * 0.14 + (transition?.name === "lifemap_to_focus" ? transition.progress * 0.18 : 0))
          : 0;
        const scale =
          star.size *
          (selected ? 1.22 + weights.focus * 0.22 + weights.replay * 0.3 : 1) *
          (0.95 + Math.sin(index + Date.now() * 0.00015 * star.stability) * 0.02);

        return (
          <group
            key={star.id}
            position={star.position}
            onPointerDown={(event: ThreeEvent<PointerEvent>) => {
              event.stopPropagation();
              if (!transition && phase === "lifemap") onSelect(star.id);
            }}
          >
            {selected ? (
              <mesh>
                <sphereGeometry args={[star.size * 6.2, 24, 24]} />
                <meshBasicMaterial
                  color={star.color}
                  transparent
                  opacity={haloOpacity}
                  toneMapped={false}
                />
              </mesh>
            ) : null}

            <mesh>
              <sphereGeometry args={[Math.max(0.09, scale), 20, 20]} />
              <meshStandardMaterial
                color="#dfe9ff"
                emissive={star.color}
                emissiveIntensity={(0.65 + star.intensity * 0.8) * starOpacity}
                roughness={0.2}
                metalness={0}
                transparent
                opacity={starOpacity}
              />
            </mesh>
          </group>
        );
      })}
    </group>
  );
}

function FocusChamber({
  weights,
  selectedStar,
}: {
  weights: WorldWeights;
  selectedStar: StarNode | null;
}) {
  if (!selectedStar) return null;
  const opacity = clamp01(weights.focus * 0.22 + weights.replay * 0.14);
  return (
    <group position={selectedStar.position}>
      <mesh>
        <sphereGeometry args={[3.2, 24, 24]} />
        <meshBasicMaterial
          color={selectedStar.color}
          transparent
          opacity={0.07 * opacity}
          toneMapped={false}
        />
      </mesh>
      <mesh rotation={[Math.PI / 2, 0, 0]}>
        <torusGeometry args={[1.5, 0.02, 16, 64]} />
        <meshBasicMaterial
          color="#d9ebff"
          transparent
          opacity={0.25 * opacity}
          toneMapped={false}
        />
      </mesh>
    </group>
  );
}

function ReplayField({
  weights,
  selectedStar,
}: {
  weights: WorldWeights;
  selectedStar: StarNode | null;
}) {
  if (!selectedStar || weights.replay <= 0.001) return null;
  const opacity = clamp01(weights.replay);
  return (
    <group position={selectedStar.position}>
      <mesh position={[0, -0.1, -2.8]}>
        <planeGeometry args={[12, 4]} />
        <meshBasicMaterial
          color="#5ea1ff"
          transparent
          opacity={0.09 * opacity}
          toneMapped={false}
        />
      </mesh>

      <mesh position={[-1.6, 0.2, -1.4]} rotation={[0, 0.22, 0.18]}>
        <planeGeometry args={[3.6, 0.22]} />
        <meshBasicMaterial
          color="#8ebeff"
          transparent
          opacity={0.24 * opacity}
          toneMapped={false}
        />
      </mesh>

      <mesh position={[0, 0, -0.6]}>
        <sphereGeometry args={[2.1, 24, 24]} />
        <meshBasicMaterial
          color="#6da8ff"
          transparent
          opacity={0.06 * opacity}
          toneMapped={false}
        />
      </mesh>
    </group>
  );
}

function SceneWorld({
  phase,
  transition,
  stars,
  selectedStar,
  onAscend,
  onSelect,
}: {
  phase: ScenePhase;
  transition: TransitionState | null;
  stars: StarNode[];
  selectedStar: StarNode | null;
  onAscend: () => void;
  onSelect: (id: string) => void;
}) {
  const weights = computeWeights(phase, transition);
  const lookRef = useRef(new THREE.Vector3(0, 0.9, 0));

  useEffect(() => {
    lookRef.current.set(0, 0.9, 0);
  }, []);

  useFrame(({ camera, clock, scene }) => {
    if (!(scene.fog instanceof THREE.FogExp2)) {
      scene.fog = new THREE.FogExp2("#02040a", 0.012);
    }

    const bg = HOME_BG.clone().lerp(LIFEMAP_BG, weights.lifemap + weights.focus * 0.6);
    bg.lerp(REPLAY_BG, weights.replay);
    scene.background = bg;
    scene.fog.color.copy(bg);
    scene.fog.density =
      0.017 * weights.home +
      0.007 * weights.lifemap +
      0.012 * weights.focus +
      0.022 * weights.replay +
      0.01 * weights.ascent +
      0.012 * weights.descent;

    const elapsed = clock.getElapsedTime();
    const resolved = resolveCamera(phase, transition, selectedStar, elapsed);

    camera.position.lerp(resolved.pos, 0.08);
    lookRef.current.lerp(resolved.look, 0.09);
    camera.lookAt(lookRef.current);

    const pcam = camera as THREE.PerspectiveCamera;
    pcam.fov = THREE.MathUtils.lerp(pcam.fov, resolved.fov, 0.08);
    pcam.near = 0.1;
    pcam.far = 2000;
    pcam.updateProjectionMatrix();
  });

  return (
    <>
      <ambientLight intensity={0.36 * weights.home + 0.12 * weights.lifemap + 0.14 * weights.focus + 0.08 * weights.replay} />
      <directionalLight position={[3, 6, 5]} intensity={0.35 * weights.home + 0.08 * weights.lifemap} color="#d9e9ff" />

      <HomeWorld weights={weights} onAscend={onAscend} />

      <LifemapField
        stars={stars}
        weights={weights}
        selectedStar={selectedStar}
        phase={phase}
        transition={transition}
        onSelect={onSelect}
      />

      <FocusChamber weights={weights} selectedStar={selectedStar} />
      <ReplayField weights={weights} selectedStar={selectedStar} />
    </>
  );
}

export default function SpatialScene() {
  const stars = useMemo(() => buildStars(), []);
  const [phase, setPhase] = useState<ScenePhase>("home");
  const [selectedId, setSelectedId] = useState<string | null>(null);

  const selectedStar = useMemo(
    () => stars.find((star) => star.id === selectedId) ?? null,
    [selectedId, stars],
  );

  const { transition, startTransition } = useTransitionDriver(
    phase,
    setPhase,
    selectedId,
    setSelectedId,
  );

  const onAscend = useCallback(() => {
    if (!transition && phase === "home") startTransition("home_to_lifemap");
  }, [phase, startTransition, transition]);

  const onSelect = useCallback(
    (id: string) => {
      if (transition || phase !== "lifemap") return;
      setSelectedId(id);
      startTransition("lifemap_to_focus");
    },
    [phase, startTransition, transition],
  );

  const onReplay = useCallback(() => {
    if (!transition && phase === "focus" && selectedStar) {
      startTransition("focus_to_replay");
    }
  }, [phase, selectedStar, startTransition, transition]);

  return (
    <div style={{ position: "relative", width: "100%", height: "100%" }}>
      <Header phase={phase} transition={transition} selectedStar={selectedStar} />
      <Footer phase={phase} selectedStar={selectedStar} transition={transition} onReplay={onReplay} />

      <Canvas
        gl={{ antialias: true, alpha: false }}
        dpr={[1, 2]}
        camera={{ position: [0, 1.68, 6.85], fov: 53, near: 0.1, far: 2000 }}
        style={{ width: "100%", height: "100%", background: "#02040a" }}
      >
        <SceneWorld
          phase={phase}
          transition={transition}
          stars={stars}
          selectedStar={selectedStar}
          onAscend={onAscend}
          onSelect={onSelect}
        />
      </Canvas>
    </div>
  );
}

function Orb({ opacity }: { opacity: number }) {
  const coreRef = useRef<THREE.Mesh>(null);
  const innerRef = useRef<THREE.Mesh>(null);

  useFrame(({ clock }) => {
    const t = clock.getElapsedTime();

    const pulse = 1 + Math.sin(t * 0.55) * 0.025;

    if (coreRef.current) coreRef.current.scale.setScalar(pulse);
    if (innerRef.current) innerRef.current.scale.setScalar(1 + Math.sin(t * 0.8) * 0.015);
  });

  const o = Math.max(0, Math.min(1, opacity));

  return (
    <group position={[0, 0.6, 0]}>
      {/* buried glow (ground interaction) */}
      <mesh position={[0, -0.35, 0]} rotation={[-Math.PI / 2, 0, 0]}>
        <circleGeometry args={[2.4, 64]} />
        <meshBasicMaterial
          color="#5fa8ff"
          transparent
          opacity={0.08 * o}
          toneMapped={false}
        />
      </mesh>

      {/* outer dim shell */}
      <mesh>
        <sphereGeometry args={[0.9, 48, 48]} />
        <meshStandardMaterial
          color="#0f1c2e"
          emissive="#2f6bc3"
          emissiveIntensity={0.25 * o}
          roughness={0.85}
          metalness={0.05}
          transparent
          opacity={0.95 * o}
        />
      </mesh>

      {/* inner intelligence core */}
      <mesh ref={innerRef}>
        <sphereGeometry args={[0.55, 48, 48]} />
        <meshStandardMaterial
          color="#cfe6ff"
          emissive="#7db7ff"
          emissiveIntensity={1.1 * o}
          roughness={0.2}
          metalness={0.02}
        />
      </mesh>

      {/* pulse core */}
      <mesh ref={coreRef}>
        <sphereGeometry args={[0.25, 32, 32]} />
        <meshBasicMaterial
          color="#ffffff"
          transparent
          opacity={0.9 * o}
        />
      </mesh>

      <pointLight color="#6ea8ff" intensity={1.2 * o} distance={10} />
    </group>
  );
}

function HomeWorld({
  weights,
  onAscend,
}: {
  weights: WorldWeights;
  onAscend: () => void;
}) {
  const o = Math.max(0, Math.min(1, weights.home + weights.ascent * 0.3));

  return (
    <group>
      {/* deep ground mass */}
      <mesh rotation={[-Math.PI / 2, 0, 0]}>
        <circleGeometry args={[40, 128]} />
        <meshStandardMaterial
          color="#010308"
          roughness={1}
          metalness={0}
        />
      </mesh>

      {/* ground compression zone */}
      <mesh rotation={[-Math.PI / 2, 0, 0]} position={[0, 0.01, 0]}>
        <circleGeometry args={[8, 96]} />
        <meshBasicMaterial
          color="#3b6ec9"
          transparent
          opacity={0.06 * o}
          toneMapped={false}
        />
      </mesh>

      {/* subtle radial energy (NOT UI rings) */}
      <mesh rotation={[-Math.PI / 2, 0, 0]} position={[0, 0.02, 0]}>
        <circleGeometry args={[3, 64]} />
        <meshBasicMaterial
          color="#6ea8ff"
          transparent
          opacity={0.08 * o}
          toneMapped={false}
        />
      </mesh>

      {/* horizon depth */}
      <mesh position={[0, 2.2, -18]}>
        <planeGeometry args={[60, 10]} />
        <meshBasicMaterial
          color="#4c7ecf"
          transparent
          opacity={0.05 * o}
          toneMapped={false}
        />
      </mesh>

      {/* sky volume (click trigger hidden) */}
      <mesh
        position={[0, 10, -12]}
        onPointerDown={(e) => {
          e.stopPropagation();
          onAscend();
        }}
      >
        <planeGeometry args={[60, 40]} />
        <meshBasicMaterial transparent opacity={0.001} />
      </mesh>

      <Orb opacity={o} />
    </group>
  );
}
