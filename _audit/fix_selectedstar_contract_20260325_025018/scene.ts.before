export type ScenePhase = "home" | "lifemap" | "focus" | "replay";

export type TransitionName =
  | "home_to_lifemap"
  | "lifemap_to_home"
  | "lifemap_to_focus"
  | "focus_to_lifemap"
  | "focus_to_replay"
  | "replay_to_focus";

export type SelectedStar = {
  id: string;
  title: string;
  label?: string;
  chapter: string;
  position: [number, number, number];
  color: string;
  size: number;
  intensity: number;
};
