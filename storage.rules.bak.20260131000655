
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check for admin privileges
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // Published builds are publicly readable.
    match /spatial/assets/builds/{allPaths=**} {
      allow read: if true;
      // Client-side writes to the builds folder are disallowed.
      // Cloud Functions will bypass these rules using the Admin SDK.
      allow write: if false;
    }

    // Source assets are admin-only.
    match /spatial/assets/source/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
