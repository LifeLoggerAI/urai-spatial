{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist-runtime",
    "rootDir": "src",
    "types": ["node"]
  },
  "files": [
    "src/index.ts",
    "src/smoke/systemLoopSmoke.ts"
  ],
  "exclude": ["node_modules", "dist-runtime", "urai-tier1", "apps", "packages"]
}
