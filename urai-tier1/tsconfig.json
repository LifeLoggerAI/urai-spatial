{
"compilerOptions": {
"target": "ES2017",
"lib": ["dom", "dom.iterable", "esnext"],
"allowJs": false,
"skipLibCheck": true,
"strict": false,
"noEmit": true,
"esModuleInterop": true,
"module": "esnext",
"moduleResolution": "bundler",
"resolveJsonModule": true,
"isolatedModules": true,
"jsx": "react-jsx",
"incremental": true,
"plugins": [{ "name": "next" }],
"paths": {
"@/*": ["./src/*"]
}
},
"include": [
  "next-env.d.ts",
  ".next/types/**/*.ts",
  ".next/dev/types/**/*.ts",
  "src/**/*.d.ts",
  "src/app/**/*.ts",
  "src/app/**/*.tsx",
  "src/lib/**/*.ts",
  "src/lib/**/*.tsx",
  "src/spatial/components/**/*.ts",
  "src/spatial/components/**/*.tsx",
  "src/spatial/hooks/useSceneAuthority.ts",
  "src/spatial/scene/**/*.ts",
  "src/spatial/scene/**/*.tsx"
],
"exclude": [
  "node_modules",
  "src/spatial/ui/**",
  "src/spatial/narrator/**",
  "src/spatial/vault/**",
  "src/spatial/scene/LifeMap.tsx",
  "src/spatial/scene/sceneData.ts",
  "src/spatial/scene/starData.ts"
]
}
