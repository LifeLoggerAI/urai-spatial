{
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "src/**/*.d.ts",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/lib/**/*.ts",
    "src/lib/**/*.tsx",
    "src/spatial/components/**/*.ts",
    "src/spatial/components/**/*.tsx",
    "src/spatial/hooks/useSceneAuthority.ts",
    "src/spatial/scene/**/*.ts",
    "src/spatial/scene/**/*.tsx"
  ],
  "exclude": [
    "src/**/*.corrupt.*.ts",
    "src/**/*.corrupt.*.tsx",
    "src/**/*.bak.*",
    "src/**/*.backup.*",
    "src/**/*.broken.*.ts",
    "src/**/*.broken.*.tsx"
  ]
}
