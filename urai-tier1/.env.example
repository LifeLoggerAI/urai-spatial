# URAI Tier1 public Firebase config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Browser uses same-origin when empty. Android release builds bind this to the
# canonical HTTPS Hosting/Functions boundary so embedded WebView API calls do
# not resolve against the local Capacitor origin.
NEXT_PUBLIC_URAI_API_ORIGIN=

# V1 demo data
NEXT_PUBLIC_URAI_DEMO_USER_ID=demo-user

# Server ADC must use a protected external_account Workload Identity
# Federation configuration. Do not create or store service-account JSON keys.
GOOGLE_APPLICATION_CREDENTIALS=

# App URL used for Stripe checkout redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Workspace OAuth is served by Firebase Functions via /api/google/oauth/* rewrites.
# Keep the following values in Google Secret Manager / Firebase Functions secrets, not in the browser.
# GOOGLE_OAUTH_CLIENT_ID
# GOOGLE_OAUTH_CLIENT_SECRET
# GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY (32 random bytes, base64 encoded)
# Non-secret production callback: https://urai.app/api/google/oauth/callback

# Stripe server secrets
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe price IDs used by /api/stripe/create-checkout-session
NEXT_PUBLIC_STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PRICE_THERAPIST=
NEXT_PUBLIC_STRIPE_PRICE_FOUNDER=

# Optional narrator provider config
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
