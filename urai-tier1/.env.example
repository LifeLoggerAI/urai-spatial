# URAI Tier1 public Firebase config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# V1 demo data
NEXT_PUBLIC_URAI_DEMO_USER_ID=demo-user

# Firebase Admin Application Default Credentials for server routes.
# Prefer a managed runtime identity. For approved local/non-managed validation only,
# point this to an access-controlled ADC credential file outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=

# App URL used for Stripe checkout redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe server secrets
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe price IDs used by /api/stripe/create-checkout-session
NEXT_PUBLIC_STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PRICE_THERAPIST=
NEXT_PUBLIC_STRIPE_PRICE_FOUNDER=

# Optional narrator provider config
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
