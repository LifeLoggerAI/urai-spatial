# URAI Tier1 public Firebase config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# V1 demo data
NEXT_PUBLIC_URAI_DEMO_USER_ID=demo-user

# Firebase Admin service account JSON for legacy server routes only.
# Canonical authenticated provider routes use external-account ADC; never expose credentials to the browser.
FIREBASE_SERVICE_ACCOUNT_JSON=

# App origin used to allowlist Stripe checkout and customer-portal returns.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Workspace OAuth is served by Firebase Functions via /api/google/oauth/* rewrites.
# Keep the following values in Google Secret Manager / Firebase Functions secrets, not in the browser.
# GOOGLE_OAUTH_CLIENT_ID
# GOOGLE_OAUTH_CLIENT_SECRET
# GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY (32 random bytes, base64 encoded)
# Non-secret production callback: https://urai.app/api/google/oauth/callback

# Stripe runtime authority. Must be explicitly either test or production; any other/missing value fails closed.
# Non-production environments must use URAI_STRIPE_MODE=test with test-mode Stripe credentials and test Price IDs.
# Production activation is a separate governed step and is not authorized by test evidence.
URAI_STRIPE_MODE=test

# Stripe server secrets. Never commit values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Stripe Billing Portal configuration ID. The authenticated server route resolves customer identity itself.
STRIPE_BILLING_PORTAL_CONFIGURATION=

# Stripe Price IDs used by /api/stripe/create-checkout-session.
# Price IDs are not secrets, but each deployment must bind IDs from the same Stripe mode as STRIPE_SECRET_KEY.
NEXT_PUBLIC_STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PRICE_THERAPIST=
NEXT_PUBLIC_STRIPE_PRICE_FOUNDER=

# Optional narrator provider config
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
