{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UrAi multilingual speech policy evaluation result v1",
  "description": "Normalized synthetic-case output. Cross-field and per-case policy checks are enforced by evaluate.mjs.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[A-Z]{2}[0-9]{2}$"
    },
    "status": {
      "enum": [
        "unknown",
        "disputed",
        "reported",
        "disabled",
        "revoked"
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      },
      "maxItems": 1
    },
    "interpretations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interpretation"
      },
      "maxItems": 1
    },
    "language_spans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/languageSpan"
      }
    },
    "evidence_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "conflict_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "baseline": {
      "$ref": "#/$defs/baseline"
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "effects": {
      "$ref": "#/$defs/effects"
    }
  },
  "required": [
    "case_id",
    "status",
    "observations",
    "assertions",
    "interpretations",
    "language_spans",
    "evidence_flags",
    "conflict_refs",
    "baseline",
    "presentation",
    "lifecycle",
    "effects"
  ],
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "feature": {
          "enum": [
            "mean_f0_hz",
            "energy_dbfs",
            "syllables_per_second",
            "pause_ratio"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "enum": [
            "Hz",
            "dBFS",
            "syllables/s",
            "ratio"
          ]
        },
        "truth_kind": {
          "const": "observation"
        },
        "origin": {
          "const": "synthetic-feature-stub"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "feature",
        "value",
        "unit",
        "truth_kind",
        "origin",
        "source_ref"
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "enum": [
            "speaker-self-report",
            "typed-owner-correction",
            "manual-choice"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "truth_kind": {
          "const": "user-assertion"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^synthetic-owner-"
        },
        "scope": {
          "const": "utterance:current"
        }
      },
      "required": [
        "label",
        "attribution",
        "source_ref",
        "truth_kind",
        "actor_id",
        "scope"
      ]
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "const": "empathetic-language"
        },
        "truth_kind": {
          "const": "interpretation"
        },
        "qualifier": {
          "const": "possible"
        },
        "scope": {
          "const": "utterance-style"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "label",
        "truth_kind",
        "qualifier",
        "scope",
        "evidence_refs"
      ]
    },
    "languageSpan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "language",
        "text"
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": [
            "none",
            "session-only"
          ]
        },
        "speaker_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "z_f0": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "scope",
        "speaker_key",
        "z_f0"
      ]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "enum": [
            "speech.you_said",
            "speech.unknown",
            "speech.unresolved",
            "speech.disabled",
            "speech.revoked"
          ]
        },
        "qualifier": {
          "enum": [
            "you-said",
            "uncertain",
            "none"
          ]
        },
        "emotion_is_fact": {
          "const": false
        },
        "inference_enabled": {
          "type": "boolean"
        },
        "manual_weather": {
          "enum": [
            null,
            "Calm",
            "Reflective",
            "Energized",
            "Heavy",
            "Uncertain",
            "Hopeful"
          ]
        }
      },
      "required": [
        "key",
        "qualifier",
        "emotion_is_fact",
        "inference_enabled",
        "manual_weather"
      ]
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_unchanged": {
          "const": true
        },
        "applied_revision": {
          "type": "integer",
          "minimum": 0
        },
        "superseded_claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "stale_reply_dropped": {
          "type": "boolean"
        }
      },
      "required": [
        "source_unchanged",
        "applied_revision",
        "superseded_claim_ids",
        "stale_reply_dropped"
      ]
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider_calls": {
          "type": "integer",
          "const": 0
        },
        "persistence_writes": {
          "type": "integer",
          "const": 0
        },
        "raw_audio_bytes_retained": {
          "type": "integer",
          "const": 0
        },
        "biometric_template_writes": {
          "type": "integer",
          "const": 0
        },
        "training_writes": {
          "type": "integer",
          "const": 0
        },
        "sensitive_log_entries": {
          "type": "integer",
          "const": 0
        },
        "purged_inflight": {
          "type": "boolean"
        },
        "baseline_read_owner": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "provider_calls",
        "persistence_writes",
        "raw_audio_bytes_retained",
        "biometric_template_writes",
        "training_writes",
        "sensitive_log_entries",
        "purged_inflight",
        "baseline_read_owner"
      ]
    }
  }
}
