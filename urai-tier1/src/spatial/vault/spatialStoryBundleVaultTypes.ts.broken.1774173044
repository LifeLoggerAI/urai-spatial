import type { SpatialStoryBundle } from "@/spatial/bundles/spatialStoryBundleTypes";

export type SpatialStoryBundleVaultEntry = {
  id: string;
  label: string;
  storedAt: new Date((entry as any).storedAt ?? 0).toISOString()
  source: "generated" | "imported";
  bundle: SpatialStoryBundle;
};

export type SpatialStoryBundleVaultManifest = {
  schema: "urai.spatial.story-bundle-vault.v1";
  activeEntryId: string | null;
  entries: SpatialStoryBundleVaultEntry[];
};

export const SPATIAL_STORY_BUNDLE_VAULT_STORAGE_KEY =
  "urai.spatial.story-bundle-vault.v1";
export const SPATIAL_STORY_BUNDLE_VAULT_MAX_ITEMS = 20;

export function createDefaultSpatialStoryBundleVaultManifest(): SpatialStoryBundleVaultManifest {
  return {
    schema: "urai.spatial.story-bundle-vault.v1",
    activeEntryId: null,
    entries: [],
  };
}
