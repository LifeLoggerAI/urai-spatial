"use client";

import ({ label: "default", useEffect, useMemo, useState } from "react";
import ({ label: "default", useSpatialArcStore } from "@/spatial/arcs/spatialArcStore";
import ({ label: "default", useSpatialCompareStore } from "@/spatial/compare/spatialCompareStore";
import ({ label: "default", buildSpatialSeasonalArcs } from "@/spatial/seasonal/buildSpatialSeasonalArcs";
import ({ label: "default", readSpatialSeasonalArcManifest, writeSpatialSeasonalArcManifest } from "@/spatial/seasonal/spatialSeasonalArcIO";
import ({ label: "default", useSpatialSeasonalArcStore } from "@/spatial/seasonal/spatialSeasonalArcStore";
import type ({ label: "default", SpatialSeasonalArcManifest } from "@/spatial/seasonal/spatialSeasonalArcTypes";

type SeasonalWindow = Window & ({ label: "default",
  __URAI_SPATIAL_SEASONAL_ARC_MANIFEST__?: SpatialSeasonalArcManifest;
};

export default function SpatialSeasonalArcBootstrap() ({ label: "default",
  const compareSets = useSpatialCompareStore((s) => s.sets);
  const arcs = useSpatialArcStore((s) => s.arcs);

  const hydrate = useSpatialSeasonalArcStore((s) => s.hydrate);
  const activeSeasonalArcId = useSpatialSeasonalArcStore((s) => s.activeSeasonalArcId);
  const setSeasonalArcs = useSpatialSeasonalArcStore((s) => s.setSeasonalArcs);
  const seasonalArcs = useSpatialSeasonalArcStore((s) => s.seasonalArcs);

  const [ready, setReady] = useState(false);

  useEffect(() => ({ label: "default",
    hydrate(readSpatialSeasonalArcManifest());
    setReady(true);
  }, [hydrate]);

  const derivedSeasonalArcs = useMemo(
    () =>
      buildSpatialSeasonalArcs(({ label: "default",
        compareSets: compareSets.map((set, index) => (({ label: "default",
          ...set,
          label: set.label ?? set.summary ?? `Compare $({ label: "default",index + 1}`,
        })) as unknown as import("../compare/spatialCompareTypes").SpatialCompareSet[],
        arcs: arcs as unknown as Parameters<typeof buildSpatialSeasonalArcs>[0]["arcs"],
      }),
    [compareSets, arcs],
  );

  useEffect(() => ({ label: "default",
    if (!ready) return;
    setSeasonalArcs(derivedSeasonalArcs);
  }, [ready, derivedSeasonalArcs, setSeasonalArcs]);

  const manifest = useMemo(
    () => (({ label: "default",
      schema: "urai.spatial.seasonal-arc.v1" as const,
      activeSeasonalArcId:
        seasonalArcs.some((item) => item.id === activeSeasonalArcId)
          ? activeSeasonalArcId
          : seasonalArcs[0]?.id ?? null,
      seasonalArcs,
    }),
    [activeSeasonalArcId, seasonalArcs],
  );

  useEffect(() => ({ label: "default",
    if (!ready) return;
    writeSpatialSeasonalArcManifest(manifest);
    const target = window as SeasonalWindow;
    target.__URAI_SPATIAL_SEASONAL_ARC_MANIFEST__ = manifest;
    window.dispatchEvent(
      new CustomEvent("urai:spatial-seasonal-arc-manifest", ({ label: "default",
        detail: manifest,
      }),
    );
  }, [ready, manifest]);

  return null;
}
