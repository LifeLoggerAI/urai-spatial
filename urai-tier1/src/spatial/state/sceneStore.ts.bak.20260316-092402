import { create } from "zustand";

export type SceneMode = "home" | "lifemap" | "focus" | "replay";

export type SelectedStar = {
  id: string;
  position: [number, number, number];
  color: string;
  size: number;
  title: string;
  label: string;
  signature: string;
  chapter: string;
  timeband: string;
};

type SceneState = {
  mode: SceneMode;
  selectedStar: SelectedStar | null;
  detailOpen: boolean;
  replayEnteredAt: number | null;
  setMode: (mode: SceneMode) => void;
  enterHome: () => void;
  enterLifeMap: () => void;
  focusStar: (star: SelectedStar) => void;
  clearFocus: () => void;
  enterReplay: () => void;
  exitReplay: () => void;
  setDetailOpen: (open: boolean) => void;
};

export const useSceneStore = create<SceneState>((set) => ({
  mode: "home",
  selectedStar: null,
  detailOpen: false,
  replayEnteredAt: null,

  setMode: (mode) =>
    set((state) => {
      const enteringReplay = mode === "replay";
      const leavingReplay = state.mode === "replay" && mode !== "replay";

      return {
        mode,
        replayEnteredAt: enteringReplay
          ? Date.now()
          : leavingReplay
            ? null
            : state.replayEnteredAt,
      };
    }),

  enterHome: () =>
    set({
      mode: "home",
      selectedStar: null,
      detailOpen: false,
      replayEnteredAt: null,
    }),

  enterLifeMap: () =>
    set((state) => ({
      mode: "lifemap",
      replayEnteredAt: null,
      detailOpen: state.selectedStar ? state.detailOpen : false,
    })),

  focusStar: (star) =>
    set({
      mode: "focus",
      selectedStar: star,
      detailOpen: true,
      replayEnteredAt: null,
    }),

  clearFocus: () =>
    set((state) => ({
      mode: state.mode === "home" ? "home" : "lifemap",
      selectedStar: null,
      detailOpen: false,
      replayEnteredAt: null,
    })),

  enterReplay: () =>
    set((state) => ({
      mode: state.selectedStar ? "replay" : state.mode,
      detailOpen: !!state.selectedStar,
      replayEnteredAt: state.selectedStar ? Date.now() : state.replayEnteredAt,
    })),

  exitReplay: () =>
    set((state) => ({
      mode: state.selectedStar ? "focus" : "lifemap",
      replayEnteredAt: null,
    })),

  setDetailOpen: (open) => set({ detailOpen: open }),
}));
