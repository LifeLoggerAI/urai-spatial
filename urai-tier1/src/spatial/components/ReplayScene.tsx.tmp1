'use client'

import * as THREE from 'three'
import { useEffect, useMemo, useRef } from 'react'
import { useFrame } from '@react-three/fiber'
import type { SpatialMemory } from '@/spatial/data/spatialMemory'

type Props = {
  starId?: string
  memory?: SpatialMemory | null
  visible?: boolean
  opacity?: number
  onExit?: () => void
}

type ReplayPalette = {
  particle: string
  glow: string
  core: string
  bg: string
  fog: string
}

function getReplayPalette(memory: SpatialMemory | null | undefined): ReplayPalette {
  const emotion = memory?.emotion ?? 'clarity'
  switch (emotion) {
    case 'calm':
      return { particle: '#c9f4ff', glow: '#d8f4ff', core: '#ffffff', bg: '#213f52', fog: '#8dd7ee' }
    case 'tension':
      return { particle: '#ffd0e3', glow: '#ffd7e7', core: '#fff8fb', bg: '#48192f', fog: '#ff97c6' }
    case 'weight':
      return { particle: '#dbe6ff', glow: '#dbe6ff', core: '#f8fbff', bg: '#243248', fog: '#8ea4cf' }
    case 'wonder':
      return { particle: '#edf1ff', glow: '#e3e9ff', core: '#ffffff', bg: '#213465', fog: '#8ba6ff' }
    case 'recovery':
      return { particle: '#dfffff', glow: '#ddf8ff', core: '#ffffff', bg: '#1d4547', fog: '#74d8cf' }
    case 'clarity':
    default:
      return { particle: '#e8efff', glow: '#dfe9ff', core: '#ffffff', bg: '#27426e', fog: '#7aaeff' }
  }
}

function getBaseFlowVector(memory: SpatialMemory | null | undefined) {
  const emotion = memory?.emotion ?? 'clarity'
  switch (emotion) {
    case 'calm':
      return new THREE.Vector3(0.0011, 0.00012, 0.0)
    case 'tension':
      return new THREE.Vector3(0.0032, 0.0021, 0.0)
    case 'weight':
      return new THREE.Vector3(0.00012, -0.00185, 0.0)
    case 'wonder':
      return new THREE.Vector3(0.0012, 0.00255, 0.0)
    case 'recovery':
      return new THREE.Vector3(0.0008, 0.00155, 0.0)
    case 'clarity':
    default:
      return new THREE.Vector3(0.00012, 0.00245, 0.0)
  }
}

function clamp(n: number, lo: number, hi: number) {
  return Math.max(lo, Math.min(hi, n))
}

function lerp(a: number, b: number, t: number) {
  return a + (b - a) * t
}

function smooth01(t: number) {
  const x = clamp(t, 0, 1)
  return x * x * (3 - 2 * x)
}

function wrap(v: number, min: number, max: number) {
  const range = max - min
  let out = v
  while (out < min) out += range
  while (out > max) out -= range
  return out
}

function tintHex(hex: string, amount: number) {
  const c = new THREE.Color(hex)
  const hsl = { h: 0, s: 0, l: 0 }
  c.getHSL(hsl)
  hsl.h = (hsl.h + amount + 1) % 1
  hsl.s = clamp(hsl.s * lerp(0.90, 1.03, Math.random()), 0, 1)
  hsl.l = clamp(hsl.l * lerp(0.90, 1.04, Math.random()), 0, 1)
  const out = new THREE.Color()
  out.setHSL(hsl.h, hsl.s, hsl.l)
}

function emotionTuning(memory: SpatialMemory | null | undefined) {
  const emotion = memory?.emotion ?? 'clarity'
  switch (emotion) {
    case 'calm':
      return { flowAmp: 0.72, jitter: 0.55, density: 0.92, coherence: 1.18, downBias: 0.0, upBias: 0.10 }
    case 'tension':
      return { flowAmp: 1.28, jitter: 1.35, density: 1.08, coherence: 0.82, downBias: 0.02, upBias: 0.04 }
    case 'weight':
      return { flowAmp: 0.86, jitter: 0.92, density: 1.18, coherence: 0.96, downBias: 0.20, upBias: 0.0 }
    case 'wonder':
      return { flowAmp: 1.08, jitter: 0.88, density: 0.90, coherence: 1.08, downBias: 0.0, upBias: 0.20 }
    case 'recovery':
      return { flowAmp: 0.94, jitter: 0.72, density: 0.96, coherence: 1.12, downBias: 0.0, upBias: 0.12 }
    case 'clarity':
    default:
      return { flowAmp: 1.02, jitter: 0.78, density: 0.94, coherence: 1.16, downBias: 0.0, upBias: 0.18 }
  }
}

export default function ReplayScene({
  starId: _starId,
  memory = null,
  visible = true,
  opacity = 1,
    onExit,
}: Props) {
  const __URAI_PASS08_REPLAY_POLISH__ = true
  const replayOpacityFloor = 0.22
  const replayGlowBoost = 1.18
  const __URAI_PASS09_REPLAY_HOLD_STRUCTURE__ = true
  const replayNearFieldBoost = 1.24
  const replayFarFieldDim = 0.76
  const replayCoreShellBoost = 1.20
  const __URAI_REPLAY_DWELL_LOCK__ = true
  const replayEmergeSec = 2.95
  const replayExitUnlockSec = 1.65
  const __URAI_REPLAY_DEPTH_TUNING__ = true
  const replayDepthScalar = 1.28
  const replayForegroundScalar = 1.40
  const replayBackgroundScalar = 0.82
  const replayContrastScalar = 1.18
  const group = useRef<THREE.Group>(null!)
  const bgSphereRef = useRef<THREE.Mesh>(null!)
  const glowRef = useRef<THREE.Mesh>(null!)
  const coreRef = useRef<THREE.Mesh>(null!)
  const occlusionARef = useRef<THREE.Mesh>(null!)
  const occlusionBRef = useRef<THREE.Mesh>(null!)
  const pointsRef = useRef<THREE.Points>(null!)
  const fgPointsRef = useRef<THREE.Points>(null!)
  const bornAtRef = useRef<number | null>(null)
  const exitUnlockedRef = useRef(false)
  const eventStateRef = useRef({ start: 0, duration: 0, amp: 0, dir: 0, initialized: false })

  const intensity = memory?.intensity ?? 0.5
  const palette = useMemo(() => getReplayPalette(memory), [memory])
  const baseFlow = useMemo(() => getBaseFlowVector(memory), [memory])
  const tune = useMemo(() => emotionTuning(memory), [memory])

  const spread = (4.6 + intensity * 5.8) * tune.density
  const density = Math.floor((170 + intensity * 210) * tune.density)
  const fgCount = 30

  const coreOffset = useMemo(() => {
    const emotion = memory?.emotion ?? 'clarity'
    if (emotion === 'tension') return new THREE.Vector3(-0.26, 0.11, 0)
    if (emotion === 'wonder') return new THREE.Vector3(0.20, 0.07, 0)
    if (emotion === 'weight') return new THREE.Vector3(-0.15, -0.05, 0)
    if (emotion === 'recovery') return new THREE.Vector3(0.09, 0.03, 0)
    return new THREE.Vector3(0.06, 0.02, 0)
  }, [memory])

  useEffect(() => {
    if (visible) {
      bornAtRef.current = null
      eventStateRef.current = { start: 0, duration: 0, amp: 0, dir: 0, initialized: false }
    }
  }, [visible, memory?.id])

  const particleState = useMemo(() => {
    const basePositions = new Float32Array(density * 3)
    const colors = new Float32Array(density * 3)
    const sizes = new Float32Array(density)
    const alphas = new Float32Array(density)
    const seeds = new Float32Array(density)
    const clusterIds = new Float32Array(density)
    const zoneIds = new Float32Array(density)

    const baseColor = new THREE.Color(palette.particle)

    const clusterCount = 6
    const clusters: Array<[number, number, number]> = []
    for (let c = 0; c < clusterCount; c++) {
      clusters.push([
        (Math.random() - 0.5) * spread * 0.78,
        (Math.random() - 0.5) * spread * 0.56,
        (Math.random() - 0.5) * spread * 0.72,
      ])
    }

    for (let i = 0; i < density; i++) {
      const seed = Math.random() * 1000
      seeds[i] = seed

      const clusterId = i % clusterCount
      clusterIds[i] = clusterId
      const cluster = clusters[clusterId]
      const useCluster = Math.random() < 0.74

      let x: number
      let y: number
      let z: number

      if (useCluster) {
        x = cluster[0] + (Math.random() - 0.5) * spread * lerp(0.20, 0.60, Math.random())
        y = cluster[1] + (Math.random() - 0.5) * spread * lerp(0.16, 0.46, Math.random())
        z = cluster[2] + (Math.random() - 0.5) * spread * lerp(0.20, 0.54, Math.random())
      } else {
        const r = spread * Math.pow(Math.random(), 0.66)
        const theta = Math.random() * Math.PI * 2
        const phi = Math.random() * Math.PI
        x = r * Math.sin(phi) * Math.cos(theta)
        y = r * Math.sin(phi) * Math.sin(theta) * 0.70
        z = r * Math.cos(phi)
      }

      basePositions[i * 3 + 0] = x
      basePositions[i * 3 + 1] = y
      basePositions[i * 3 + 2] = z

      const zoneNoise = Math.sin(x * 0.22 + y * 0.17 + z * 0.11)
      const zoneId = zoneNoise > 0.28 ? 2 : zoneNoise < -0.22 ? 0 : 1
      zoneIds[i] = zoneId

      const contam = (Math.random() - 0.5) * 0.06
      const dimmer =
        zoneId === 0
          ? lerp(0.35, 0.70, Math.random())
          : zoneId === 2
          ? lerp(0.78, 1.00, Math.random())
          : lerp(0.52, 0.88, Math.random())

      tinted.multiplyScalar(dimmer)

      colors[i * 3 + 0] = tinted.r
      colors[i * 3 + 1] = tinted.g
      colors[i * 3 + 2] = tinted.b

      sizes[i] =
        zoneId === 0
          ? lerp(0.010, 0.050, Math.pow(Math.random(), 1.9))
          : zoneId === 2
          ? lerp(0.020, 0.088, Math.pow(Math.random(), 1.45))
          : lerp(0.014, 0.070, Math.pow(Math.random(), 1.7))

      alphas[i] =
        zoneId === 0
          ? lerp(0.08, 0.42, Math.pow(Math.random(), 1.4))
          : zoneId === 2
          ? lerp(0.26, 1.00, Math.pow(Math.random(), 1.18))
          : lerp(0.12, 0.78, Math.pow(Math.random(), 1.3))
    }

    return { basePositions, colors, sizes, alphas, seeds, clusterIds, zoneIds }
  }, [density, palette.particle, spread])

  const geometry = useMemo(() => {
    const g = new THREE.BufferGeometry()
    g.setAttribute('position', new THREE.BufferAttribute(particleState.basePositions.slice(), 3))
    g.setAttribute('color', new THREE.BufferAttribute(particleState.colors, 3))
    g.setAttribute('size', new THREE.BufferAttribute(particleState.sizes.slice(), 1))
    g.setAttribute('alpha', new THREE.BufferAttribute(particleState.alphas.slice(), 1))
    return g
  }, [particleState])

  const fgState = useMemo(() => {
    const basePositions = new Float32Array(fgCount * 3)
    const colors = new Float32Array(fgCount * 3)
    const sizes = new Float32Array(fgCount)
    const alphas = new Float32Array(fgCount)
    const seeds = new Float32Array(fgCount)
    const base = new THREE.Color(palette.core)

    for (let i = 0; i < fgCount; i++) {
      basePositions[i * 3 + 0] = (Math.random() - 0.5) * 3.3
      basePositions[i * 3 + 1] = (Math.random() - 0.5) * 2.5
      basePositions[i * 3 + 2] = -Math.random() * 2.7

      const contam = (Math.random() - 0.5) * 0.03
      colors[i * 3 + 0] = c.r
      colors[i * 3 + 1] = c.g
      colors[i * 3 + 2] = c.b

      sizes[i] = lerp(0.035, 0.19, Math.random())
      alphas[i] = lerp(0.18, 0.98, Math.random())
      seeds[i] = Math.random() * 1000
    }

    return { basePositions, colors, sizes, alphas, seeds }
  }, [fgCount, palette.core])

  const fgGeometry = useMemo(() => {
    const g = new THREE.BufferGeometry()
    g.setAttribute('position', new THREE.BufferAttribute(fgState.basePositions.slice(), 3))
    g.setAttribute('color', new THREE.BufferAttribute(fgState.colors, 3))
    g.setAttribute('size', new THREE.BufferAttribute(fgState.sizes.slice(), 1))
    g.setAttribute('alpha', new THREE.BufferAttribute(fgState.alphas.slice(), 1))
    return g
  }, [fgState])

  const pointsMaterial = useMemo(() => {
    return new THREE.ShaderMaterial({
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
      vertexColors: true,
      uniforms: {
        uOpacity: { value: opacity },
      },
        attribute float size;
        attribute float alpha;
        varying vec3 vColor;
        varying float vAlpha;
        varying float vDepthFade;
        void main() {
          vColor = color;
          vAlpha = alpha;
          vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
          float z = -mvPosition.z;
          vDepthFade = clamp(1.0 - smoothstep(1.8, 12.8, z), 0.08, 1.0);
          gl_PointSize = size * 720.0 / max(z, 0.001);
          gl_Position = projectionMatrix * mvPosition;
        }
        uniform float uOpacity;
        varying vec3 vColor;
        varying float vAlpha;
        varying float vDepthFade;
        void main() {
          vec2 uv = gl_PointCoord.xy - 0.5;
          float d = length(uv);
          float radial = smoothstep(0.5, 0.0, d);
          float finalAlpha = radial * vAlpha * vDepthFade * uOpacity;
          gl_FragColor = vec4(vColor, finalAlpha);
        }
    })
  }, [opacity])

  const fgMaterial = useMemo(() => {
    return new THREE.ShaderMaterial({
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
      vertexColors: true,
      uniforms: {
        uOpacity: { value: opacity },
      },
        attribute float size;
        attribute float alpha;
        varying vec3 vColor;
        varying float vAlpha;
        void main() {
          vColor = color;
          vAlpha = alpha;
          vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
          float z = -mvPosition.z;
          gl_PointSize = size * 520.0 / max(z, 0.001);
          gl_Position = projectionMatrix * mvPosition;
        }
        uniform float uOpacity;
        varying vec3 vColor;
        varying float vAlpha;
        void main() {
          vec2 uv = gl_PointCoord.xy - 0.5;
          float d = length(uv);
          float radial = smoothstep(0.5, 0.0, d);
          gl_FragColor = vec4(vColor, radial * vAlpha * uOpacity);
        }
    })
  }, [opacity])

  useFrame(({ clock }) => {
    const t = clock.getElapsedTime()

    if (bornAtRef.current == null) bornAtRef.current = t
    const visibleTime = t - bornAtRef.current
    exitUnlockedRef.current = visibleTime >= replayExitUnlockSec
    const emerge = smooth01(visibleTime / replayEmergeSec)

    if (!eventStateRef.current.initialized) {
      eventStateRef.current = {
        start: t + 2.5 + Math.random() * 3.5,
        duration: 1.8 + Math.random() * 1.2,
        amp: 0.08 + Math.random() * 0.08,
        dir: Math.random() * Math.PI * 2,
        initialized: true,
      }
    }

    let eventAmp = 0
    if (t >= eventStateRef.current.start) {
      const local = (t - eventStateRef.current.start) / eventStateRef.current.duration
      if (local <= 1) {
        eventAmp = Math.sin(local * Math.PI) * eventStateRef.current.amp
      } else {
        eventStateRef.current = {
          start: t + 6 + Math.random() * 6,
          duration: 1.8 + Math.random() * 1.4,
          amp: 0.08 + Math.random() * 0.08,
          dir: Math.random() * Math.PI * 2,
          initialized: true,
        }
      }
    }

    const flowAngle =
      Math.sin(t * 0.10 + intensity * 0.7) * 0.65 +
      Math.sin(t * 0.037 + 0.8) * 0.18 +
      eventAmp * Math.cos(eventStateRef.current.dir)

    const cosA = Math.cos(flowAngle)
    const sinA = Math.sin(flowAngle)
    const fx = (baseFlow.x * cosA - baseFlow.y * sinA) * tune.flowAmp
    const fy = (baseFlow.x * sinA + baseFlow.y * cosA) * tune.flowAmp

    const fieldBreath =
      1 +
      Math.sin(t * 0.14 + 0.4) * (0.020 + intensity * 0.012) +
      Math.sin(t * 0.067 + 1.2) * (0.016 + intensity * 0.010) +
      eventAmp * 0.18

    if (group.current) {
      group.current.rotation.z = Math.sin(t * 0.05) * 0.026
      group.current.position.y = Math.sin(t * 0.09) * 0.022
      group.current.scale.set(fieldBreath, fieldBreath * 0.988, 1)
    }

    if (bgSphereRef.current) {
      bgSphereRef.current.position.x = coreOffset.x * 0.14
      bgSphereRef.current.position.y = Math.sin(t * 0.06) * 0.03
      bgSphereRef.current.rotation.z = Math.sin(t * 0.03) * 0.05
      const m = bgSphereRef.current.material as THREE.MeshBasicMaterial
      const noisy = 0.965 + 0.035 * Math.sin(t * 0.51 + 0.4) * Math.sin(t * 0.22 + 1.1)
      m.opacity = (0.20 + intensity * 0.14) * ((opacity < replayOpacityFloor ? replayOpacityFloor : opacity) * replayContrastScalar * replayGlowBoost * replayCoreShellBoost) * noisy
    }

    if (occlusionARef.current) {
      occlusionARef.current.position.x = coreOffset.x * -0.22 + Math.sin(t * 0.05 + 0.9) * 0.18
      occlusionARef.current.position.y = Math.sin(t * 0.07 + 0.3) * 0.12
      occlusionARef.current.rotation.z = Math.sin(t * 0.04 + 0.5) * 0.18
      const m = occlusionARef.current.material as THREE.MeshBasicMaterial
      m.opacity = (0.050 + intensity * 0.030) * ((opacity < replayOpacityFloor ? replayOpacityFloor : opacity) * replayDepthScalar * replayNearFieldBoost) * (0.94 + 0.06 * Math.sin(t * 0.18 + 0.7))
    }

    if (occlusionBRef.current) {
      occlusionBRef.current.position.x = coreOffset.x * 0.28 + Math.sin(t * 0.04 + 1.5) * -0.15
      occlusionBRef.current.position.y = Math.sin(t * 0.06 + 1.1) * -0.10
      occlusionBRef.current.rotation.z = Math.sin(t * 0.03 + 1.3) * -0.14
      const m = occlusionBRef.current.material as THREE.MeshBasicMaterial
      m.opacity = (0.024 + intensity * 0.016) * opacity * replayBackgroundScalar * replayFarFieldDim * (0.95 + 0.05 * Math.sin(t * 0.16 + 1.2))
    }

    if (glowRef.current) {
      const influenceRadius = 0.72 + intensity * 0.34 + eventAmp * 0.55
      glowRef.current.position.x = coreOffset.x * 0.76
      glowRef.current.position.y = coreOffset.y * 0.76
      const s = lerp(0.82, 1.0, emerge) * influenceRadius *
        (1 + Math.sin(t * (0.62 + intensity * 0.4)) * (0.05 + intensity * 0.04))
      glowRef.current.scale.set(
        s * (1 + Math.sin(t * 0.29 + 0.3) * 0.05),
        s * (1 + Math.sin(t * 0.23 + 1.0) * 0.04),
        s
      )
      const m = glowRef.current.material as THREE.MeshBasicMaterial
      const noisy = 0.95 + 0.05 * Math.sin(t * 0.78 + 0.5) * Math.sin(t * 0.44 + 1.0)
      m.opacity = (0.16 + intensity * 0.15) * opacity * noisy * lerp(0.56, 1.0, emerge)
    }

    if (coreRef.current) {
      coreRef.current.position.x = coreOffset.x
      coreRef.current.position.y = coreOffset.y
      const s = lerp(0.76, 1.0, emerge) * (1 + Math.sin(t * (0.90 + intensity * 0.45)) * (0.028 + intensity * 0.030))
      coreRef.current.scale.set(
        s * (1 + Math.sin(t * 0.34 + 0.1) * 0.020),
        s * (1 + Math.sin(t * 0.27 + 1.1) * 0.014),
        s
      )
      const m = coreRef.current.material as THREE.MeshBasicMaterial
      const noisy = 0.958 + 0.042 * Math.sin(t * 0.98 + 0.8) * Math.sin(t * 0.59 + 0.2)
      m.opacity = (0.06 + intensity * 0.10) * opacity * noisy * lerp(0.20, 1.0, emerge)
    }

    if (pointsRef.current) {
      const pos = pointsRef.current.geometry.attributes.position as THREE.BufferAttribute
      const alpha = pointsRef.current.geometry.attributes.alpha as THREE.BufferAttribute
      const size = pointsRef.current.geometry.attributes.size as THREE.BufferAttribute

      for (let i = 0; i < pos.count; i++) {
        const bx = particleState.basePositions[i * 3 + 0]
        const by = particleState.basePositions[i * 3 + 1]
        const bz = particleState.basePositions[i * 3 + 2]
        const seed = particleState.seeds[i]
        const zone = particleState.zoneIds[i]

        const dx = bx - coreOffset.x
        const dy = by - coreOffset.y
        const dz = bz
        const dist = Math.sqrt(dx * dx + dy * dy + dz * dz)
        const influence = clamp(1 - dist / (spread * 0.80), 0, 1)

        const tx = bx + fx * t * (1.30 - influence * 0.82) * tune.coherence
        const ty = by + (fy * t * (1.18 - influence * 0.68) * tune.coherence) - (tune.downBias * 0.02 * t) + (tune.upBias * 0.018 * t)
        const tz = bz + Math.sin(t * 0.06 + seed) * 0.032

        const jitterScale =
          zone === 0 ? 0.45 :
          zone === 2 ? 1.10 :
          0.72

        const jitterX =
          ((Math.sin(t * 0.71 + seed * 0.011) + Math.sin(t * 1.33 + seed * 0.007)) * 0.016 * tune.jitter * jitterScale) +
          eventAmp * 0.10 * Math.cos(eventStateRef.current.dir)
        const jitterY =
          ((Math.cos(t * 0.65 + seed * 0.013) + Math.sin(t * 1.09 + seed * 0.009)) * 0.013 * tune.jitter * jitterScale) +
          eventAmp * 0.08 * Math.sin(eventStateRef.current.dir)
        const jitterZ =
          Math.sin(t * 0.48 + seed * 0.005) * 0.010 * tune.jitter * jitterScale

        const x = wrap(tx + jitterX, -spread, spread)
        const y = wrap(ty + jitterY, -spread * 0.78, spread * 0.78)
        const z = wrap(tz + jitterZ, -spread, spread)

        pos.setXYZ(i, x, y, z)

        const baseA = particleState.alphas[i]
        const baseS = particleState.sizes[i]
        const zoneStill =
          zone === 0 ? 0.72 :
          zone === 2 ? 1.16 :
          0.92
        const dimZone = Math.sin((x + y + z) * 0.36 + t * 0.10 + particleState.clusterIds[i]) * 0.5 + 0.5
        const noisy = 0.93 + 0.07 * Math.sin(t * 1.58 + seed * 0.021) * Math.sin(t * 0.79 + seed * 0.015)
        const attention =
          clamp(1 - Math.sqrt((x - coreOffset.x) ** 2 + (y - coreOffset.y) ** 2) / (spread * 0.56), 0, 1)

        alpha.setX(
          i,
          baseA *
            lerp(0.48, 1.22, influence) *
            lerp(0.70, 1.0, dimZone) *
            noisy *
            zoneStill *
            lerp(0.88, 1.22, attention)
        )
        size.setX(
          i,
          baseS *
            lerp(0.80, 1.26, influence) *
            lerp(0.94, 1.06, Math.sin(t * 0.27 + seed * 0.01) * 0.5 + 0.5) *
            lerp(0.92, 1.18, attention)
        )
      }

      pos.needsUpdate = true
      alpha.needsUpdate = true
      size.needsUpdate = true
      pointsRef.current.rotation.z = Math.sin(t * 0.028) * 0.04
      ;(pointsRef.current.material as THREE.ShaderMaterial).uniforms.uOpacity.value = ((opacity < replayOpacityFloor ? replayOpacityFloor : opacity) * replayDepthScalar * replayNearFieldBoost) * lerp(0.90, 1.0, emerge)
    }

    if (fgPointsRef.current) {
      const pos = fgPointsRef.current.geometry.attributes.position as THREE.BufferAttribute
      const alpha = fgPointsRef.current.geometry.attributes.alpha as THREE.BufferAttribute

      for (let i = 0; i < pos.count; i++) {
        const bx = fgState.basePositions[i * 3 + 0]
        const by = fgState.basePositions[i * 3 + 1]
        const bz = fgState.basePositions[i * 3 + 2]
        const seed = fgState.seeds[i]

        let x = bx + fx * t * 2.0 + Math.sin(t * 0.79 + seed * 0.01) * 0.07
        let y = by + fy * t * 1.7 + Math.cos(t * 0.61 + seed * 0.013) * 0.06
        let z = bz + t * 0.013 + Math.sin(t * 0.25 + seed * 0.02) * 0.020

        x = wrap(x, -1.7, 1.7)
        y = wrap(y, -1.25, 1.25)
        if (z > -0.10) z = -2.6

        pos.setXYZ(i, x, y, z)

        const noisy = 0.88 + 0.12 * Math.sin(t * 1.08 + seed * 0.018)
        alpha.setX(i, fgState.alphas[i] * noisy)
      }

      pos.needsUpdate = true
      alpha.needsUpdate = true
      ;(fgPointsRef.current.material as THREE.ShaderMaterial).uniforms.uOpacity.value = ((opacity < replayOpacityFloor ? replayOpacityFloor : opacity) * replayForegroundScalar * replayGlowBoost * replayNearFieldBoost) * lerp(0.92, 1.0, emerge)
    }
  })

  if (!visible) return null

  return (
    <group ref={group}>
      <mesh ref={bgSphereRef}>
        <sphereGeometry args={[9.5, 32, 32]} />
        <meshBasicMaterial
          color={palette.bg}
          side={THREE.BackSide}
          transparent
          opacity={(0.18 + intensity * 0.12) * ((opacity < replayOpacityFloor ? replayOpacityFloor : opacity) * replayContrastScalar * replayGlowBoost)}
          blending={THREE.AdditiveBlending}
          depthWrite={false}
        />
      </mesh>

      <mesh ref={occlusionARef} position={[0, 0, -1.25]}>
        <planeGeometry args={[4.6, 3.4]} />
        <meshBasicMaterial
          color={palette.fog}
          transparent
          opacity={(0.044 + intensity * 0.026) * ((opacity < replayOpacityFloor ? replayOpacityFloor : opacity) * replayDepthScalar)}
          blending={THREE.AdditiveBlending}
          depthWrite={false}
        />
      </mesh>

      <mesh ref={occlusionBRef} position={[0, 0, -0.85]}>
        <planeGeometry args={[3.6, 2.8]} />
        <meshBasicMaterial
          color={palette.fog}
          transparent
          opacity={(0.030 + intensity * 0.020) * opacity * replayBackgroundScalar}
          blending={THREE.AdditiveBlending}
          depthWrite={false}
        />
      </mesh>

      <mesh ref={glowRef} position={[coreOffset.x * 0.76, coreOffset.y * 0.76, -0.8]}>
        <sphereGeometry args={[1.25, 28, 28]} />
        <meshBasicMaterial
          color={palette.glow}
          transparent
          opacity={(0.24 + intensity * 0.20) * ((opacity < replayOpacityFloor ? replayOpacityFloor : opacity) * replayForegroundScalar * replayGlowBoost * replayNearFieldBoost)}
          blending={THREE.AdditiveBlending}
          depthWrite={false}
        />
      </mesh>

      <mesh ref={coreRef} position={[coreOffset.x, coreOffset.y, -0.7]}>
        <sphereGeometry args={[0.24, 18, 18]} />
        <meshBasicMaterial
          color={palette.core}
          transparent
          opacity={(0.092 + intensity * 0.12) * ((opacity < replayOpacityFloor ? replayOpacityFloor : opacity) * replayDepthScalar * 0.92)}
          blending={THREE.AdditiveBlending}
          depthWrite={false}
        />
      </mesh>

      <points ref={pointsRef} geometry={geometry} material={pointsMaterial} />
      <points ref={fgPointsRef} geometry={fgGeometry} material={fgMaterial} />

      {onExit ? (
        <group
          onClick={(e) => {
            e.stopPropagation()
            if (!exitUnlockedRef.current) return
            if (!exitUnlockedRef.current) return
            onExit()
          }}
        />
      ) : null}
    </group>
  )
}
