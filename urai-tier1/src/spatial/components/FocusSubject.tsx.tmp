'use client'

import { useMemo, useRef } from 'react'
import { useFrame } from '@react-three/fiber'
import { AdditiveBlending } from 'three'
import type { Group, MeshBasicMaterial, Mesh } from 'three'
import type { SpatialMemory } from '@/spatial/data/spatialMemory'

type Props = {
  starId?: string
  memory?: SpatialMemory | null
  position?: [number, number, number]
  visible?: boolean
  opacity?: number
  onEnterReplay?: () => void
  focusBoost?: number
  backgroundSuppression?: number
}

function getEmotionPalette(memory: SpatialMemory | null | undefined) {
  const __URAI_PASS15_FOCUS_VISUALS__ = true
  const resolvedFocusBoost = typeof focusBoost === "number" ? focusBoost : 1
  const resolvedBackgroundSuppression = typeof backgroundSuppression === "number" ? backgroundSuppression : 1
  const emotion = memory?.emotion ?? 'clarity'
  switch (emotion) {
    case 'calm':
      return { auraOuter: '#59c7ff', auraMid: '#a8e8ff', core: '#f2fcff', inner: '#ffffff' }
    case 'tension':
      return { auraOuter: '#a78bff', auraMid: '#ffd6ea', core: '#fff5fa', inner: '#ffffff' }
    case 'weight':
      return { auraOuter: '#6d86c8', auraMid: '#bed0f2', core: '#eef4ff', inner: '#ffffff' }
    case 'wonder':
      return { auraOuter: '#74a7ff', auraMid: '#d9e7ff', core: '#fbfdff', inner: '#ffffff' }
    case 'recovery':
      return { auraOuter: '#66d1d8', auraMid: '#cdf6ff', core: '#f2fdff', inner: '#ffffff' }
    case 'clarity':
    default:
      return { auraOuter: '#7aaeff', auraMid: '#d4e4ff', core: '#f7faff', inner: '#ffffff' }
  }
}

export default function FocusSubject({
  starId: _starId,
  memory = null,
  position = [0.04, 0.01, 0],
  visible = true,
  opacity = 1,
  focusBoost = 1,
  backgroundSuppression = 1,
  onEnterReplay,
}: Props) {
  const rootRef = useRef<Group>(null)
  const auraOuterRef = useRef<Mesh>(null)
  const auraMidRef = useRef<Mesh>(null)
  const coreRef = useRef<Mesh>(null)
  const innerRef = useRef<Mesh>(null)

  const palette = useMemo(() => getEmotionPalette(memory), [memory])
  const intensity = memory?.intensity ?? 0.72

  useFrame(({ clock }) => {
    const t = clock.getElapsedTime()

    const ampBase = 0.012 + intensity * 0.012
    const pulseA = 1 + Math.sin(t * (0.88 + intensity * 0.10)) * (ampBase * 0.85)
    const pulseB = 1 + Math.sin(t * (1.14 + intensity * 0.16) + 0.8) * ampBase
    const pulseC = 1 + Math.sin(t * (1.46 + intensity * 0.18) + 1.7) * (ampBase * 0.62)

    if (rootRef.current) {
      rootRef.current.rotation.z = Math.sin(t * (0.15 + intensity * 0.05)) * (0.010 + intensity * 0.010)
      rootRef.current.rotation.x = Math.sin(t * 0.11 + 0.4) * 0.035
      rootRef.current.rotation.y = Math.sin(t * 0.09 + 1.1) * 0.035
    }

    if (auraOuterRef.current) {
      auraOuterRef.current.scale.set(
        pulseA * (1 + Math.sin(t * 0.41 + 0.2) * 0.032),
        pulseA * (1 + Math.sin(t * 0.35 + 1.2) * 0.026),
        pulseA * (1 + Math.sin(t * 0.29 + 2.0) * 0.038),
      )
      const m = auraOuterRef.current.material as MeshBasicMaterial
      m.opacity =
        (0.050 + intensity * 0.035) *
        (0.90 + 0.10 * Math.sin(t * 0.72 + 0.4)) *
        (0.985 + 0.015 * Math.sin(t * 3.2 + 0.7))
    }

    if (auraMidRef.current) {
      auraMidRef.current.scale.set(
        pulseB * (1 + Math.sin(t * 0.53 + 0.6) * 0.024),
        pulseB * (1 + Math.sin(t * 0.47 + 1.7) * 0.030),
        pulseB * (1 + Math.sin(t * 0.39 + 2.3) * 0.028),
      )
      const m = auraMidRef.current.material as MeshBasicMaterial
      m.opacity =
        (0.10 + intensity * 0.05) *
        (0.93 + 0.10 * Math.sin(t * 1.02 + 1.2)) *
        (0.987 + 0.013 * Math.sin(t * 2.7 + 1.1))
    }

    if (coreRef.current) {
      coreRef.current.scale.set(
        pulseC * (1 + Math.sin(t * 0.72 + 0.1) * 0.016),
        pulseC * (1 + Math.sin(t * 0.61 + 0.8) * 0.012),
        pulseC * (1 + Math.sin(t * 0.55 + 1.5) * 0.020),
      )
      const m = coreRef.current.material as MeshBasicMaterial
      m.opacity =
        (0.982 + 0.018 * Math.sin(t * (1.25 + intensity * 0.25))) *
        (0.992 + 0.008 * Math.sin(t * 4.1 + 0.4))
    }

    if (innerRef.current) {
      const s = 1 + Math.sin(t * (1.7 + intensity * 0.20) + 0.5) * (0.018 + intensity * 0.012)
      innerRef.current.scale.set(
        s * (1 + Math.sin(t * 0.92 + 0.3) * 0.020),
        s * (1 + Math.sin(t * 0.84 + 1.4) * 0.012),
        s * (1 + Math.sin(t * 0.76 + 2.0) * 0.026),
      )
      const m = innerRef.current.material as MeshBasicMaterial
      m.opacity =
        (0.12 + intensity * 0.08) *
        (0.91 + 0.12 * Math.sin(t * 1.65 + 2.1)) *
        (0.988 + 0.012 * Math.sin(t * 5.0 + 0.9))
    }
  })

  if (!visible) return null

  return (
    <group ref={rootRef} position={position}>
      <mesh ref={auraOuterRef}>
        <sphereGeometry args={[1.28, 40, 40]} />
        <meshBasicMaterial
          color={palette.auraOuter}
          transparent
          blending={AdditiveBlending}
          depthWrite={false}
          opacity={(0.050 + intensity * 0.035) * opacity}
        />
      </mesh>

      <mesh ref={auraMidRef}>
        <sphereGeometry args={[0.92, 36, 36]} />
        <meshBasicMaterial
          color={palette.auraMid}
          transparent
          blending={AdditiveBlending}
          depthWrite={false}
          opacity={(0.10 + intensity * 0.05) * opacity}
        />
      </mesh>

      <mesh
        ref={coreRef}
        onClick={(e) => {
          e.stopPropagation()
          onEnterReplay?.()
        }}
      >
        <sphereGeometry args={[0.44, 28, 28]} />
        <meshBasicMaterial
          color={palette.core}
          transparent
          blending={AdditiveBlending}
          depthWrite={false}
          opacity={opacity}
        />
      </mesh>

      <mesh ref={innerRef}>
        <sphereGeometry args={[0.18, 20, 20]} />
        <meshBasicMaterial
          color={palette.inner}
          transparent
          blending={AdditiveBlending}
          depthWrite={false}
          opacity={(0.12 + intensity * 0.08) * opacity}
        />
      </mesh>
    </group>
  )
}
