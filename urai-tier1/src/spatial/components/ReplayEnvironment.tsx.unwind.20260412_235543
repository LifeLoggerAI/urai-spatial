"use client"

import { useRef } from "react"
import { useFrame } from "@react-three/fiber"
import * as THREE from "three"

function clamp01(v: number) {
  if (v < 0) return 0
  if (v > 1) return 1
  return v
}

// fast drop → slow settle
function dropCurve(t: number) {
  return 1 - Math.pow(1 - t, 4)
}

export default function ReplayEnvironment({ active }: { active: boolean }) {
  const fog = useRef<THREE.Fog>(new THREE.Fog("#04030a", 2, 22))
  const tRef = useRef(0)

  useFrame((_, delta) => {
    const target = active ? 1 : 0

    // faster entry than exit
    const speed = active ? 4.2 : 2.2
    tRef.current += (target - tRef.current) * Math.min(delta * speed, 1)

    const t = clamp01(tRef.current)
    const d = dropCurve(t)

    // aggressive early compression
    fog.current.near = 2 + d * 9.5
    fog.current.far = 22 - d * 14.0

    // subtle color shift toward deep violet/black
    const r = 5 - d * 3
    const g = 3 - d * 2
    const b = 10 - d * 6
    fog.current.color = new THREE.Color(`rgb(${r},${g},${b})`)
  })

  return <primitive object={fog.current} attach="fog" />
}
