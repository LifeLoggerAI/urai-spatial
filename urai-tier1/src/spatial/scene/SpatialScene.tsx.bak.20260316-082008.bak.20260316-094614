"use client";

import { Canvas } from "@react-three/fiber";
import { Suspense, useEffect } from "react";
import Starfield from "@/spatial/scene/Starfield";
import CameraRig from "@/spatial/components/CameraRig";
import { useSceneStore } from "@/spatial/state/sceneStore";
import MemorySphere from "@/spatial/scene/MemorySphere";

function HudButton({
  label,
  active,
  onClick,
}: {
  label: string;
  active: boolean;
  onClick: () => void;
}) {
  return (
    <button
      onClick={onClick}
      style={{
        padding: "10px 14px",
        borderRadius: 10,
        border: active ? "1px solid rgba(255,255,255,0.45)" : "1px solid rgba(255,255,255,0.18)",
        background: active ? "rgba(255,255,255,0.16)" : "rgba(255,255,255,0.06)",
        color: "white",
        cursor: "pointer",
        fontSize: 13,
        letterSpacing: "0.02em",
        backdropFilter: "blur(8px)",
      }}
    >
      {label}
    </button>
  );
}

function TagPill({ label }: { label: string }) {
  return (
    <span
      style={{
        padding: "6px 10px",
        borderRadius: 999,
        background: "rgba(255,255,255,0.08)",
        border: "1px solid rgba(255,255,255,0.10)",
        fontSize: 12,
        opacity: 0.9,
      }}
    >
      {label}
    </span>
  );
}

function FocusPanel() {
  const mode = useSceneStore((s) => s.mode);
  const selectedStar = useSceneStore((s) => s.selectedStar);
  const setDetailOpen = useSceneStore((s) => s.setDetailOpen);

  if (mode !== "focus" || !selectedStar) return null;

  return (
    <div
      style={{
        position: "absolute",
        top: 18,
        right: 18,
        zIndex: 120,
        width: 340,
        padding: 16,
        borderRadius: 16,
        background: "rgba(255,255,255,0.06)",
        border: "1px solid rgba(255,255,255,0.14)",
        backdropFilter: "blur(12px)",
        color: "white",
        fontFamily: "Arial, sans-serif",
        pointerEvents: "auto",
      }}
      onPointerDown={(e) => e.stopPropagation()}
    >
      <div style={{ fontSize: 11, opacity: 0.68, textTransform: "uppercase", letterSpacing: "0.14em" }}>
        Focused Memory
      </div>

      <div style={{ marginTop: 10, display: "flex", alignItems: "center", gap: 10 }}>
        <span
          style={{
            width: 14,
            height: 14,
            borderRadius: 999,
            background: selectedStar.color,
            display: "inline-block",
            boxShadow: `0 0 16px ${selectedStar.color}`,
            flex: "0 0 auto",
          }}
        />
        <div>
          <div style={{ fontSize: 22, fontWeight: 600, lineHeight: 1.1 }}>{selectedStar.title}</div>
          <div style={{ marginTop: 4, fontSize: 12, opacity: 0.72 }}>
            {selectedStar.signature} · {selectedStar.label}
          </div>
        </div>
      </div>

      <div style={{ marginTop: 12, fontSize: 13, opacity: 0.82, lineHeight: 1.5 }}>
        {selectedStar.summary}
      </div>

      <div
        style={{
          marginTop: 14,
          display: "grid",
          gridTemplateColumns: "92px 1fr",
          rowGap: 8,
          columnGap: 8,
          fontSize: 13,
        }}
      >
        <div style={{ opacity: 0.65 }}>Chapter</div>
        <div>{selectedStar.chapter}</div>

        <div style={{ opacity: 0.65 }}>Timeband</div>
        <div>{selectedStar.timeband}</div>

        <div style={{ opacity: 0.65 }}>Era</div>
        <div>{selectedStar.dateLabel}</div>

        <div style={{ opacity: 0.65 }}>Intensity</div>
        <div>{selectedStar.size.toFixed(2)}</div>
      </div>

      <div style={{ marginTop: 14, display: "flex", flexWrap: "wrap", gap: 8 }}>
        {selectedStar.tags.map((tag) => (
          <TagPill key={tag} label={tag} />
        ))}
      </div>

      <div style={{ marginTop: 14, display: "flex", gap: 8 }}>
        <button
          onClick={() => setDetailOpen(true)}
          style={{
            padding: "10px 14px",
            borderRadius: 10,
            border: "1px solid rgba(255,255,255,0.25)",
            background: "rgba(255,255,255,0.10)",
            color: "white",
            cursor: "pointer",
            fontSize: 13,
          }}
        >
          Open Memory
        </button>
      </div>

      <div style={{ marginTop: 14, fontSize: 12, opacity: 0.68 }}>
        Press Esc or click empty space to exit focus
      </div>
    </div>
  );
}

