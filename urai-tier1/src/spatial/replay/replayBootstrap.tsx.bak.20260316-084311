"use client";

import React, { useEffect, useMemo, useState } from "react";
import { createRoot, Root } from "react-dom/client";
import { useSceneStore } from "../state/sceneStore";

declare global {
  interface Window {
    __URAI_REPLAY_BOOTED__?: boolean;
  }
}

const HOST_ID = "urai-replay-overlay-root";
const STEP_MS = 1800;

type ReplayStep = {
  id: string;
  eyebrow: string;
  title: string;
  body: string;
};

const shellStyle: React.CSSProperties = {
  position: "fixed",
  inset: 0,
  zIndex: 70,
  pointerEvents: "none",
};

const pillWrapStyle: React.CSSProperties = {
  position: "fixed",
  right: 24,
  bottom: 24,
  display: "flex",
  gap: 12,
  alignItems: "center",
  pointerEvents: "none",
};

const pillButtonStyle: React.CSSProperties = {
  pointerEvents: "auto",
  border: "1px solid rgba(255,255,255,0.18)",
  background: "rgba(10,12,18,0.82)",
  color: "#ffffff",
  borderRadius: 999,
  padding: "10px 16px",
  fontSize: 12,
  letterSpacing: "0.12em",
  textTransform: "uppercase",
  cursor: "pointer",
  backdropFilter: "blur(12px)",
  WebkitBackdropFilter: "blur(12px)",
  boxShadow: "0 10px 40px rgba(0,0,0,0.35)",
};

const overlayStyle: React.CSSProperties = {
  position: "fixed",
  inset: 0,
  background: "rgba(2,4,10,0.76)",
  display: "grid",
  placeItems: "center",
  pointerEvents: "auto",
  padding: 24,
};

const panelStyle: React.CSSProperties = {
  width: "min(760px, calc(100vw - 32px))",
  borderRadius: 24,
  border: "1px solid rgba(255,255,255,0.12)",
  background:
    "linear-gradient(180deg, rgba(16,20,30,0.96) 0%, rgba(8,10,16,0.96) 100%)",
  color: "#ffffff",
  boxShadow: "0 24px 80px rgba(0,0,0,0.45)",
  overflow: "hidden",
};

const topStyle: React.CSSProperties = {
  padding: "22px 24px 16px 24px",
  borderBottom: "1px solid rgba(255,255,255,0.08)",
};

const metaStyle: React.CSSProperties = {
  display: "flex",
  flexWrap: "wrap",
  gap: 8,
  marginTop: 12,
};

const chipStyle: React.CSSProperties = {
  border: "1px solid rgba(255,255,255,0.12)",
  borderRadius: 999,
  padding: "6px 10px",
  fontSize: 11,
  letterSpacing: "0.08em",
  textTransform: "uppercase",
  color: "rgba(255,255,255,0.82)",
};

const bodyStyle: React.CSSProperties = {
  padding: 24,
  display: "grid",
  gap: 18,
};

const frameStyle: React.CSSProperties = {
  minHeight: 260,
  borderRadius: 18,
  border: "1px solid rgba(255,255,255,0.10)",
  display: "grid",
  placeItems: "center",
  textAlign: "center",
  padding: 24,
  overflow: "hidden",
  position: "relative",
};

const progressWrapStyle: React.CSSProperties = {
  display: "grid",
  gridTemplateColumns: "repeat(3, minmax(0, 1fr))",
  gap: 8,
  marginTop: 14,
};

const footerStyle: React.CSSProperties = {
  display: "flex",
  justifyContent: "space-between",
  gap: 12,
  padding: "0 24px 24px 24px",
  flexWrap: "wrap",
};

const transportStyle: React.CSSProperties = {
  display: "flex",
  gap: 10,
  alignItems: "center",
  flexWrap: "wrap",
};

function Button(
  props: React.ButtonHTMLAttributes<HTMLButtonElement> & { quiet?: boolean }
) {
  const { quiet, style, ...rest } = props;
  return (
    <button
      {...rest}
      style={{
        ...pillButtonStyle,
        ...(quiet
          ? {
              background: "rgba(255,255,255,0.04)",
              color: "rgba(255,255,255,0.90)",
            }
          : {}),
        ...style,
      }}
    />
  );
}

function clampIndex(value: number, max: number) {
  if (value < 0) return 0;
  if (value > max) return max;
  return value;
}

function ReplayHud() {
  const mode = useSceneStore((s) => s.mode);
  const selectedStar = useSceneStore((s) => s.selectedStar);
  const setMode = useSceneStore((s) => s.setMode);
  const clearFocus = useSceneStore((s) => s.clearFocus);

  const steps = useMemo<ReplayStep[]>(() => {
    if (!selectedStar) return [];
    return [
      {
        id: "memory",
        eyebrow: "Memory",
        title: selectedStar.title,
        body: selectedStar.label,
      },
      {
        id: "signature",
        eyebrow: "Signature",
        title: selectedStar.signature,
        body: `${selectedStar.chapter} • ${selectedStar.timeband}`,
      },
      {
        id: "return",
        eyebrow: "Return Vector",
        title: "Replay locked",
        body: "Esc or Back to Focus returns to the selected star.",
      },
    ];
  }, [selectedStar]);

  const [stepIndex, setStepIndex] = useState(0);
  const [playing, setPlaying] = useState(true);

  useEffect(() => {
    setStepIndex(0);
    setPlaying(true);
  }, [selectedStar?.id, mode]);

  useEffect(() => {
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape" && mode === "replay") {
        setMode("focus");
        return;
      }

      if ((e.key === "r" || e.key === "R") && mode === "focus" && selectedStar) {
        setMode("replay");
        return;
      }

      if (mode !== "replay") return;

      if (e.key === " ") {
        e.preventDefault();
        setPlaying((v) => !v);
        return;
      }

      if (e.key === "ArrowRight") {
        setPlaying(false);
        setStepIndex((v) => clampIndex(v + 1, Math.max(steps.length - 1, 0)));
        return;
      }

      if (e.key === "ArrowLeft") {
        setPlaying(false);
        setStepIndex((v) => clampIndex(v - 1, Math.max(steps.length - 1, 0)));
      }
    };

    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [mode, selectedStar, setMode, steps.length]);

  useEffect(() => {
    if (mode !== "replay" || !playing || steps.length <= 1) return;
    const timer = window.setInterval(() => {
      setStepIndex((v) => (v >= steps.length - 1 ? 0 : v + 1));
    }, STEP_MS);
    return () => window.clearInterval(timer);
  }, [mode, playing, steps.length]);

  if (!selectedStar) return null;

  if (mode === "focus") {
    return (
      <div style={shellStyle}>
        <div style={pillWrapStyle}>
          <Button
            aria-label="Replay selected star"
            onClick={() => setMode("replay")}
            title="Replay selected star"
          >
            Replay
          </Button>
        </div>
      </div>
    );
  }

  if (mode !== "replay") return null;

  const step = steps[stepIndex] ?? steps[0];
  const glow = selectedStar.color || "#ffffff";

  return (
    <div style={shellStyle}>
      <div style={overlayStyle} onClick={() => setMode("focus")}>
        <div style={panelStyle} onClick={(e) => e.stopPropagation()}>
          <div style={topStyle}>
            <div
              style={{
                fontSize: 11,
                letterSpacing: "0.16em",
                textTransform: "uppercase",
                color: "rgba(255,255,255,0.62)",
              }}
            >
              Replay Sequence
            </div>

            <div style={metaStyle}>
              <div style={chipStyle}>{selectedStar.chapter}</div>
              <div style={chipStyle}>{selectedStar.timeband}</div>
              <div style={chipStyle}>{selectedStar.signature}</div>
              <div style={chipStyle}>{playing ? "Playing" : "Paused"}</div>
            </div>

            <div style={progressWrapStyle}>
              {steps.map((s, idx) => (
                <div
                  key={s.id}
                  style={{
                    height: 6,
                    borderRadius: 999,
                    background:
                      idx <= stepIndex
                        ? glow
                        : "rgba(255,255,255,0.12)",
                    opacity: idx === stepIndex ? 1 : 0.5,
                    boxShadow:
                      idx === stepIndex
                        ? `0 0 24px ${glow}`
                        : "none",
                  }}
                />
              ))}
            </div>
          </div>

          <div style={bodyStyle}>
            <div
              style={{
                ...frameStyle,
                background: `radial-gradient(circle at 50% 30%, ${glow}33, rgba(0,0,0,0) 40%), linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01))`,
              }}
            >
              <div
                style={{
                  position: "absolute",
                  inset: 0,
                  background:
                    "linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0))",
                  pointerEvents: "none",
                }}
              />
              <div style={{ position: "relative", zIndex: 1 }}>
                <div
                  style={{
                    fontSize: 12,
                    letterSpacing: "0.14em",
                    textTransform: "uppercase",
                    color: "rgba(255,255,255,0.56)",
                    marginBottom: 14,
                  }}
                >
                  {step.eyebrow}
                </div>
                <div
                  style={{
                    fontSize: 36,
                    lineHeight: 1.05,
                    marginBottom: 12,
                    color: glow,
                    textShadow: `0 0 32px ${glow}55`,
                  }}
                >
                  {step.title}
                </div>
                <div
                  style={{
                    fontSize: 16,
                    lineHeight: 1.6,
                    color: "rgba(255,255,255,0.82)",
                    maxWidth: 560,
                    margin: "0 auto",
                  }}
                >
                  {step.body}
                </div>
              </div>
            </div>

            <div
              style={{
                display: "flex",
                gap: 8,
                flexWrap: "wrap",
                color: "rgba(255,255,255,0.62)",
                fontSize: 12,
                letterSpacing: "0.06em",
                textTransform: "uppercase",
              }}
            >
              <span>R from focus opens replay</span>
              <span>•</span>
              <span>Space pause/play</span>
              <span>•</span>
              <span>← → step</span>
              <span>•</span>
              <span>Esc back to focus</span>
            </div>
          </div>

          <div style={footerStyle}>
            <div style={transportStyle}>
              <Button
                quiet
                onClick={() => {
                  setPlaying(false);
                  setStepIndex((v) => clampIndex(v - 1, steps.length - 1));
                }}
              >
                Prev
              </Button>
              <Button
                quiet
                onClick={() => setPlaying((v) => !v)}
              >
                {playing ? "Pause" : "Play"}
              </Button>
              <Button
                quiet
                onClick={() => {
                  setPlaying(false);
                  setStepIndex((v) => clampIndex(v + 1, steps.length - 1));
                }}
              >
                Next
              </Button>
            </div>

            <div style={transportStyle}>
              <Button quiet onClick={() => clearFocus()}>
                Exit to LifeMap
              </Button>
              <Button onClick={() => setMode("focus")}>Back to Focus</Button>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}

let root: Root | null = null;

function ensureHost() {
  let host = document.getElementById(HOST_ID);
  if (!host) {
    host = document.createElement("div");
    host.id = HOST_ID;
    document.body.appendChild(host);
  }
  return host;
}

function boot() {
  if (typeof window === "undefined") return;
  if (window.__URAI_REPLAY_BOOTED__) return;
  window.__URAI_REPLAY_BOOTED__ = true;
  const host = ensureHost();
  root = createRoot(host);
  root.render(<ReplayHud />);
}

if (typeof window !== "undefined") {
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot, { once: true });
  } else {
    boot();
  }
}

export {};
