{
  "name": "urai-tier1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:unit": "node --import tsx --test tests/*.test.mjs",
    "test:lifemap": "node --import tsx --test tests/lifemap-scene-behavior.test.mjs tests/lifemap*.test.mjs tests/lifemap-*.test.mjs",
    "test:visual:home": "playwright test tests/home-cinematic.visual.spec.ts --update-snapshots",
    "test:visual:spatial-flow": "playwright test tests/spatial-flow.visual.spec.ts --update-snapshots",
    "test:visual:spatial": "node ../tests/spatial-tier-lock-hardening.mjs --suite=visual",
    "test:e2e:navigation-stack": "node ../tests/spatial-tier-lock-hardening.mjs --suite=navigation",
    "test:e2e:camera-transitions": "node ../tests/spatial-tier-lock-hardening.mjs --suite=camera",
    "test:e2e:race-conditions": "node ../tests/spatial-tier-lock-hardening.mjs --suite=race",
    "test:e2e:data-states": "node ../tests/spatial-tier-lock-hardening.mjs --suite=data",
    "test:tier-lock-hardening": "node ../tests/spatial-tier-lock-hardening.mjs --suite=all",
    "audit:final": "pnpm run audit:final-visual && pnpm run audit:visual-lock",
    "audit:final-visual": "node ../scripts/audit-video-frames.mjs",
    "audit:visual-lock": "node ../tests/spatial-tier-lock-hardening.mjs --suite=visual"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "^0.183.2",
    "@react-three/fiber": "^9.5.0",
    "@react-three/drei": "^10.7.7",
    "zustand": "^5.0.11",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.7.0",
    "stripe": "^19.3.0",
    "@react-three/postprocessing": "^3.0.4",
    "postprocessing": "^6.38.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.1",
    "eslint-config-next": "15.5.4",
    "@playwright/test": "^1.57.0",
    "@types/three": "^0.183.1"
  }
}
