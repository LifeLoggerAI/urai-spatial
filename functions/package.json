{
  "name": "urai-spatial-functions",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --outfile=lib/index.js --external:@google-cloud/functions-framework",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "draco3dgltf": "^1.5.7",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "esbuild": "^0.20.0"
  },
  "version": "1.0.0"
}