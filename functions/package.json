{
  "name": "functions",
  "description": "URAI-Spatial Cloud Functions",
  "main": "lib/index.js",
  "private": true,
  "scripts": {
    "build": "npx tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@gltf-transform/core": "^3.9.2",
    "@gltf-transform/extensions": "^3.9.2",
    "@gltf-transform/functions": "^3.9.2",
    "firebase-admin": "^13.6.1",
    "firebase-functions": "^7.0.5"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
