
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check for admin privileges
    function isSpatialAdmin() {
      return request.auth.token.role == 'spatialAdmin';
    }

    // Scenes: Published releases are public, drafts are admin-only
    match /scenes/{sceneId} {
      allow read, write: if isSpatialAdmin();
    }

    match /sceneReleases/{releaseId} {
      allow read: if resource.data.status == 'published' || isSpatialAdmin();
      allow write: if isSpatialAdmin();
    }

    match /sceneManifests/{manifestId} {
      allow read: if get(/databases/$(database)/documents/sceneReleases/$(resource.data.releaseId)).data.status == 'published' || isSpatialAdmin();
      allow write: if isSpatialAdmin();
    }

    // Asset builds are public, but only service accounts can write them.
    match /assetBuilds/{buildId} {
      allow read: if true;
      allow write: if false; // Only allow writes from service accounts
    }

    // Asset build jobs are admin-only.
    match /assetBuildJobs/{jobId} {
      allow read, write: if isSpatialAdmin();
    }

    // Deny all other reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
