rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isStar(data) {
      return data.size() == 9 &&
             data.keys().hasAll(['schemaVersion', 'userId', 'position', 'type', 'intensity', 'emotionScore', 'year', 'archetype', 'createdAt']) &&
             data.schemaVersion is number &&
             data.userId is string &&
             data.position.x is number &&
             data.position.y is number &&
             data.position.z is number &&
             data.type is string &&
             data.intensity is number &&
             data.emotionScore is number &&
             data.year is number &&
             data.archetype is string &&
             data.createdAt is timestamp;
    }

    match /lifemapStars/{starId} {
      allow read: if request.auth.uid == resource.data.userId ||
                   (exists(/databases/$(database)/documents/groups/$(resource.data.groupId)) &&
                    get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members.hasAny([request.auth.uid]));

      allow create: if request.auth.uid == request.resource.data.userId && isStar(request.resource.data);
      allow update, delete: if request.auth.uid == resource.data.userId;
    }

    match /groups/{groupId} {
      allow read, create, update, delete: if request.auth.uid in resource.data.admins;
    }
    
    // Prevent public writes entirely.
    match /{path=**} {
        allow write: if false;
    }
  }
}
