rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && (
          request.auth.token.admin == true
          || request.auth.token.founder == true
        );
    }

    function isLaunchDemoOwner(ownerId) {
      return ownerId == 'launch-demo';
    }

    function isManifestOwner() {
      return isSignedIn()
        && resource.data.ownerId is string
        && resource.data.ownerId == request.auth.uid;
    }

    function isValidSpatialManifestCreate() {
      return request.resource.data.manifestId is string
        && request.resource.data.manifestVersion == '1.0'
        && request.resource.data.ownerId is string
        && request.resource.data.projectId is string
        && request.resource.data.assetType is string
        && request.resource.data.artifacts is list
        && request.resource.data.spatialCompatibility is map;
    }

    function hasOnlyHomeWorldStateFields() {
      return request.resource.data.keys().hasOnly([
        'version',
        'userId',
        'groundTier',
        'orbTier',
        'skyTier',
        'moodState',
        'recoveryState',
        'energyScore',
        'narratorSpeaking',
        'skyWeatherIntensity',
        'groundGrowthIntensity',
        'orbPulseIntensity',
        'rawScores',
        'smoothedScores',
        'confidence',
        'sourceCoverage',
        'lastDerivedAt',
        'lastMoodShiftAt',
        'lastRecoveryBloomAt',
        'lastTierUpgradeAt',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasOnlyHomeWorldExplanationFields() {
      return request.resource.data.keys().hasOnly([
        'version',
        'userId',
        'headline',
        'summary',
        'whyAmISeeingThis',
        'ground',
        'orb',
        'sky',
        'mood',
        'recovery',
        'confidence',
        'dataSources',
        'contributors',
        'privacy',
        'updatedAt'
      ]);
    }

    function isValidHomeWorldStateWrite(uid) {
      return isSelf(uid)
        && request.resource.data.userId == uid
        && hasOnlyHomeWorldStateFields()
        && request.resource.data.groundTier in [1, 2, 3, 4, 5]
        && request.resource.data.orbTier in [1, 2, 3, 4, 5]
        && request.resource.data.skyTier in [1, 2, 3, 4, 5]
        && request.resource.data.moodState in ['calm', 'low', 'recovery', 'dream', 'shadow', 'focused', 'joy']
        && request.resource.data.recoveryState in ['dormant', 'recovering', 'stable', 'growing', 'awakened']
        && request.resource.data.updatedAt == request.time;
    }

    function isValidHomeWorldExplanationWrite(uid) {
      return isSelf(uid)
        && request.resource.data.userId == uid
        && hasOnlyHomeWorldExplanationFields()
        && request.resource.data.version == 3
        && request.resource.data.privacy is map
        && request.resource.data.privacy.rawSignalsStored == false
        && request.resource.data.privacy.usedRawAudio == false
        && request.resource.data.privacy.usedContactIdentity == false
        && request.resource.data.updatedAt == request.time;
    }

    function isUserOwnedCreate(uid) {
      return isSelf(uid)
        && (!('userId' in request.resource.data) || request.resource.data.userId == uid)
        && (!('uid' in request.resource.data) || request.resource.data.uid == uid)
        && (!('ownerId' in request.resource.data) || request.resource.data.ownerId == uid);
    }

    function isUserOwnedUpdate(uid) {
      return isSelf(uid)
        && (!('userId' in resource.data) || resource.data.userId == uid)
        && (!('uid' in resource.data) || resource.data.uid == uid)
        && (!('ownerId' in resource.data) || resource.data.ownerId == uid)
        && (!('userId' in request.resource.data) || request.resource.data.userId == uid)
        && (!('uid' in request.resource.data) || request.resource.data.uid == uid)
        && (!('ownerId' in request.resource.data) || request.resource.data.ownerId == uid);
    }

    function isPrivateSpatialPayloadSafe() {
      return !('rawAudioUrl' in request.resource.data)
        && !('privateMediaUrl' in request.resource.data)
        && !('providerSecret' in request.resource.data)
        && !('apiKey' in request.resource.data);
    }

    function isValidConsentDomain(value) {
      return value is map
        && value.keys().hasOnly([
          'mode', 'retentionDays', 'precise', 'replayVisible', 'lifeMapVisible',
          'modelContext', 'sharingEnabled', 'automationEnabled', 'likenessEnabled', 'updatedAt'
        ])
        && value.mode in ['granted', 'limited', 'paused', 'denied']
        && (value.retentionDays == null || value.retentionDays in [30, 90, 365])
        && value.precise is bool
        && value.replayVisible is bool
        && value.lifeMapVisible is bool
        && value.modelContext is bool
        && value.sharingEnabled is bool
        && value.automationEnabled is bool
        && value.likenessEnabled is bool;
    }

    function isValidConsentPolicy(uid) {
      return request.resource.data.keys().hasOnly(['version', 'revision', 'ownerId', 'domains', 'updatedAt'])
        && request.resource.data.version == 1
        && request.resource.data.ownerId == uid
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.domains is map
        && request.resource.data.domains.keys().hasOnly(['memory', 'location', 'models', 'exports', 'workforce', 'identity'])
        && isValidConsentDomain(request.resource.data.domains.memory)
        && isValidConsentDomain(request.resource.data.domains.location)
        && isValidConsentDomain(request.resource.data.domains.models)
        && isValidConsentDomain(request.resource.data.domains.exports)
        && isValidConsentDomain(request.resource.data.domains.workforce)
        && isValidConsentDomain(request.resource.data.domains.identity)
        && request.resource.data.updatedAt == request.time;
    }

    function isValidConsentAudit(uid) {
      return request.resource.data.keys().hasOnly([
          'ownerId', 'domain', 'previousMode', 'nextMode', 'previousState', 'nextState',
          'revision', 'result', 'createdAt', 'receiptId'
        ])
        && request.resource.data.ownerId == uid
        && request.resource.data.domain in ['memory', 'location', 'models', 'exports', 'workforce', 'identity']
        && request.resource.data.previousMode in ['granted', 'limited', 'paused', 'denied']
        && request.resource.data.nextMode in ['granted', 'limited', 'paused', 'denied']
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.result == 'enforced'
        && request.resource.data.createdAt == request.time
        && request.resource.data.receiptId is string;
    }

    match /features/{flagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /assetManifests/{manifestId} {
      allow get, list: if isAdmin()
        || isManifestOwner()
        || isLaunchDemoOwner(resource.data.ownerId);
      allow create: if isAdmin() && isValidSpatialManifestCreate();
      allow update: if isAdmin() && isValidSpatialManifestCreate();
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && !(
          ('entitlementTier' in request.resource.data)
          || ('isAdmin' in request.resource.data)
          || ('founderOverride' in request.resource.data)
        );
      allow update: if isSelf(uid)
        && !('entitlementTier' in request.resource.data.diff(resource.data).changedKeys())
        && !('isAdmin' in request.resource.data.diff(resource.data).changedKeys())
        && !('founderOverride' in request.resource.data.diff(resource.data).changedKeys());
      allow delete: if false;

      match /tierLockAudit/{auditId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }

      match /privacyPolicy/{docId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if docId == 'current' && isSelf(uid) && isValidConsentPolicy(uid) && request.resource.data.revision == 1;
        allow update: if docId == 'current'
          && isSelf(uid)
          && resource.data.ownerId == uid
          && isValidConsentPolicy(uid)
          && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if false;
      }

      match /privacyAudit/{auditId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid) && isValidConsentAudit(uid) && request.resource.data.receiptId == auditId;
        allow update, delete: if false;
      }

      match /homeWorld/{docId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if isAdmin() || (docId == 'state' && isValidHomeWorldStateWrite(uid));
        allow delete: if isAdmin();
      }

      match /homeWorldExplainability/{docId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if isAdmin() || (docId == 'latest' && isValidHomeWorldExplanationWrite(uid));
        allow delete: if isAdmin();
        match /history/{historyId} {
          allow read: if isSelf(uid) || isAdmin();
          allow create: if isAdmin() || isValidHomeWorldExplanationWrite(uid);
          allow update, delete: if isAdmin();
        }
      }

      match /replayEvents/{eventId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isAdmin() || (isUserOwnedCreate(uid) && isPrivateSpatialPayloadSafe());
        allow update: if isAdmin() || (isUserOwnedUpdate(uid) && isPrivateSpatialPayloadSafe());
        allow delete: if isAdmin() || isSelf(uid);
      }

      match /spatialMemories/{memoryId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isAdmin() || (isUserOwnedCreate(uid) && isPrivateSpatialPayloadSafe());
        allow update: if isAdmin() || (isUserOwnedUpdate(uid) && isPrivateSpatialPayloadSafe());
        allow delete: if isAdmin() || isSelf(uid);
      }

      match /canonChains/{chainId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isAdmin() || (isUserOwnedCreate(uid) && isPrivateSpatialPayloadSafe());
        allow update: if isAdmin() || (isUserOwnedUpdate(uid) && isPrivateSpatialPayloadSafe());
        allow delete: if isAdmin() || isSelf(uid);
      }

      match /focusStates/{stateId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isAdmin() || (isUserOwnedCreate(uid) && isPrivateSpatialPayloadSafe());
        allow update: if isAdmin() || (isUserOwnedUpdate(uid) && isPrivateSpatialPayloadSafe());
        allow delete: if isAdmin() || isSelf(uid);
      }

      match /transitionStates/{transitionId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isAdmin() || (isUserOwnedCreate(uid) && isPrivateSpatialPayloadSafe());
        allow update: if isAdmin() || (isUserOwnedUpdate(uid) && isPrivateSpatialPayloadSafe());
        allow delete: if isAdmin() || isSelf(uid);
      }

      match /bodyBiometricSnapshots/{snapshotId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isAdmin() || (isUserOwnedCreate(uid) && isPrivateSpatialPayloadSafe());
        allow update: if isAdmin() || (isUserOwnedUpdate(uid) && isPrivateSpatialPayloadSafe());
        allow delete: if isAdmin() || isSelf(uid);
      }

      match /orbCompanionEvents/{eventId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isAdmin() || (isUserOwnedCreate(uid) && isPrivateSpatialPayloadSafe());
        allow update: if isAdmin() || (isUserOwnedUpdate(uid) && isPrivateSpatialPayloadSafe());
        allow delete: if isAdmin() || isSelf(uid);
      }

      match /spatialAnchors/{anchorId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isAdmin() || (isUserOwnedCreate(uid) && isPrivateSpatialPayloadSafe());
        allow update: if isAdmin() || (isUserOwnedUpdate(uid) && isPrivateSpatialPayloadSafe());
        allow delete: if isAdmin() || isSelf(uid);
      }

      match /userSpatialPreferences/{preferenceId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isAdmin() || isUserOwnedCreate(uid);
        allow update: if isAdmin() || isUserOwnedUpdate(uid);
        allow delete: if isAdmin() || isSelf(uid);
      }

      match /spatialSessions/{sessionId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isAdmin() || (isUserOwnedCreate(uid) && isPrivateSpatialPayloadSafe());
        allow update: if isAdmin() || (isUserOwnedUpdate(uid) && isPrivateSpatialPayloadSafe());
        allow delete: if isAdmin() || isSelf(uid);
      }

      match /spatialNodes/{nodeId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isAdmin() || (isUserOwnedCreate(uid) && isPrivateSpatialPayloadSafe());
        allow update: if isAdmin() || (isUserOwnedUpdate(uid) && isPrivateSpatialPayloadSafe());
        allow delete: if isAdmin() || isSelf(uid);
      }

      match /lifemapNodes/{nodeId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isAdmin() || (isUserOwnedCreate(uid) && isPrivateSpatialPayloadSafe());
        allow update: if isAdmin() || (isUserOwnedUpdate(uid) && isPrivateSpatialPayloadSafe());
        allow delete: if isAdmin() || isSelf(uid);
      }

      match /lifemapReplays/{replayId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isAdmin() || (isUserOwnedCreate(uid) && isPrivateSpatialPayloadSafe());
        allow update: if isAdmin() || (isUserOwnedUpdate(uid) && isPrivateSpatialPayloadSafe());
        allow delete: if isAdmin() || isSelf(uid);
      }
    }

    match /spatial/{doc=**} {
      allow read, write: if isAdmin();
    }
  }
}
