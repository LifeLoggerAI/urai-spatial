+/** Keep original GLB untouched; densify selected coarse authored ground before projection. */
+export function projectRefinedHomeGroundGeometry(source: THREE.BufferGeometry, worldTransform = new THREE.Matrix4(), subdivisions = 5) {
+  const steps = Math.max(1, Math.min(8, Math.floor(subdivisions)))
+  if (steps === 1) return projectHomeTerrainGeometry(source, worldTransform)
+  const src = source.getAttribute('position') as THREE.BufferAttribute
+  const srcIndices = source.index
+  const triangles = srcIndices ? Math.floor(srcIndices.count / 3) : Math.floor(src.count / 3)
+  const positions: number[] = [], indices: number[] = []
+  const a = new THREE.Vector3(), b = new THREE.Vector3(), c = new THREE.Vector3()
+  for (let triangle = 0; triangle < triangles; triangle += 1) {
+    const index = (j: number) => srcIndices ? srcIndices.getX(triangle * 3 + j) : triangle * 3 + j
+    a.fromBufferAttribute(src, index(0)); b.fromBufferAttribute(src, index(1)); c.fromBufferAttribute(src, index(2))
+    const rows: number[][] = []
+    for (let i = 0; i <= steps; i += 1) {
+      rows[i] = []
+      for (let j = 0; j <= steps - i; j += 1) {
+        const u = i / steps, v = j / steps
+        rows[i][j] = positions.length / 3
+        positions.push(a.x * (1-u-v) + b.x*u + c.x*v,
+          a.y * (1-u-v) + b.y*u + c.y*v,
+          a.z * (1-u-v) + b.z*u + c.z*v)
+      }
+    }
+    for (let i = 0; i < steps; i += 1) for (let j = 0; j < steps-i; j += 1) {
+      indices.push(rows[i][j], rows[i+1][j], rows[i][j+1])
+      if (j < steps-i-1) indices.push(rows[i+1][j], rows[i+1][j+1], rows[i][j+1])
+    }
+  }
+  const dense = new THREE.BufferGeometry()
+  dense.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3))
+  dense.setIndex(indices)
+  const result = projectHomeTerrainGeometry(dense, worldTransform)
+  dense.dispose()
+  return result
+}
