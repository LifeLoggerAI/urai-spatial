
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Published builds are publicly readable
    match /spatial/assets/builds/{assetId}/{sourceSha256}/{pipelineVersion}/{allPaths=**} {
      allow read: if true;
    }

    // Source assets are admin-uploadable only
    match /spatial/assets/source/{assetId}/{filename} {
      allow write: if request.auth.token.admin == true;
    }

    // Scene JSON mirrors are admin-writable
    match /spatial/scenes/{sceneId}/scene.json {
      allow write: if request.auth.token.admin == true;
    }

    // Allow anyone to read public assets
    match /public/{allPaths=**} {
      allow read: if true;
    }
  }
}
