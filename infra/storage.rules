
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check for admin privileges
    function isAdmin() {
      // This relies on a custom claim being set by a trusted backend process.
      return request.auth.token.admin == true;
    }

    // Published builds are publicly readable, but only writable by admins
    match /spatial/assets/builds/{assetId}/{buildId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Source assets are private and only accessible by admins
    match /spatial/assets/source/{assetId}/{filename} {
      allow read, write: if isAdmin();
    }

    // Scene JSON definitions are publicly readable, but only writable by admins
    match /spatial/scenes/{sceneId}/scene.json {
      allow read: if true;
      allow write: if isAdmin();
    }

    // General public assets
    match /public/{allPaths=**} {
      allow read: if true;
    }

    // --- USER DATA LOCK ---
    // Users can only manage their own files.
    // Content type is validated to only allow images and GLB models.
    // This is the gatekeeper for the deterministic asset pipeline.
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId &&
                    request.resource.size < 100 * 1024 * 1024 && // 100MB limit for models
                    (request.resource.contentType.matches('image/.*') || 
                     request.resource.contentType.matches('model/gltf-binary'));
    }
  }
}
