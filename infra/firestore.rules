rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================
    // INFRASTRUCTURE GOVERNANCE
    // v1.1.0: System Flags (Kill Switch)
    //
    // Allows clients to read system state but prevents any client-side modification.
    // Only backend admin processes can change these flags.
    // ============================
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ============================
    // USER DATA (v1.0.0 LOCK)
    //
    // Enforces that users can only read and write data within their own
    // user document. This prevents any cross-user data access.
    // ============================
    match /users/{userId}/{document=**} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // ============================
    // DEPRECATED v1.0.0-alpha DATA MODEL
    // To be removed in v1.2.0
    // ============================
    match /lifemapStars/{starId} {
        // No new writes.
        allow write: if false;
        // Reads allowed for data migration purposes.
        allow read: if request.auth != null;
    }
  }
}
