
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isUserAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isUserAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isUserAuthenticated() && getUserData().isAdmin == true;
    }

    // --- Data Validation Functions ---

    function isValidUser(data) {
      return data.email is string &&
             data.createdAt is timestamp &&
             (data.isAdmin == null || data.isAdmin is bool);
    }

    function isValidMemory(data) {
      return data.title is string && data.title.size() < 100 &&
             data.description is string && data.description.size() < 1000 &&
             data.position is map &&
             data.position.x is number &&
             data.position.y is number &&
             data.position.z is number &&
             data.color is string &&
             data.ownerId == request.auth.uid && // Enforce ownerId
             data.createdAt is timestamp &&
             (data.isPublic == null || data.isPublic is bool);
    }

    function isValidPublicMemory(data) {
      return isValidMemory(data) && data.isPublic == true;
    }


    // --- Security Rules ---

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isUserAuthenticated() && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isAdmin();
    }

    match /memories/{memoryId} {
      // Users can only read their own memories
      allow read: if isOwner(resource.data.ownerId);

      // Users can only write their own memories, with strict validation
      allow create: if isUserAuthenticated() && isValidMemory(request.resource.data);
      allow update: if isOwner(resource.data.ownerId) && isValidMemory(request.resource.data);
      allow delete: if isOwner(resource.data.ownerId);
    }

    match /publicMemories/{memoryId} {
      // Anyone can read public memories
      allow read: if true;

      // Only authenticated users can write public memories, with strict validation
      allow create: if isUserAuthenticated() && isValidPublicMemory(request.resource.data);
      allow update: if isOwner(resource.data.ownerId) && isValidPublicMemory(request.resource.data);
      allow delete: if isOwner(resource.data.ownerId);
    }

    // Lock down all other collections
    match /{path=**}/{document=**} {
      allow read, write: if false;
    }
  }
}
