{
  "schemaVersion": "urai-geographic-maps-policy-2",
  "authority": {
    "repository": "LifeLoggerAI/urai-spatial",
    "firebaseProject": "urai-4dc1d",
    "legacyProjectProhibitedUnlessReauthorized": "urai-web-frontend"
  },
  "productBoundary": {
    "symbolicLifeMapRemainsPrimary": true,
    "geographicLayerIsSupporting": true,
    "backgroundCollectionBeforeConsent": false,
    "preciseLocationAnalytics": false
  },
  "apiAllowlist": [
    "maps-javascript-api",
    "map-tiles-api",
    "places-api-new",
    "geocoding-api",
    "routes-api",
    "maps-elevation-api",
    "roads-api",
    "time-zone-api",
    "weather-api",
    "aerial-view-api",
    "arcore-api"
  ],
  "apiDenylistUntilDirectlyRequired": [],
  "credentials": {
    "separateKeys": [
      "development-browser",
      "preview-browser",
      "production-browser",
      "server-world-services",
      "native-arcore-when-implemented"
    ],
    "browserKeysMustUseHttpReferrerRestrictions": true,
    "serverCredentialMustNotBeExposedToBrowser": true,
    "apiRestrictionsRequired": true,
    "unrestrictedKeysAllowed": false,
    "repositorySecretsAllowed": false,
    "expectedEnvironmentVariables": [
      "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY",
      "GOOGLE_MAPS_SERVER_API_KEY"
    ],
    "browserKeyApiRestrictions": [
      "maps-javascript-api",
      "map-tiles-api",
      "places-api-new-when-used-in-browser"
    ],
    "serverKeyApiRestrictions": [
      "places-api-new",
      "geocoding-api",
      "routes-api",
      "maps-elevation-api",
      "roads-api",
      "time-zone-api",
      "weather-api",
      "aerial-view-api"
    ],
    "arcoreCredentialBoundary": "native platform credential/OAuth when ARCore client is implemented; do not reuse unrestricted server key"
  },
  "referrerPolicy": {
    "development": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*"
    ],
    "preview": [
      "https://*.web.app/*",
      "https://*.firebaseapp.com/*"
    ],
    "production": [
      "https://urai.app/*",
      "https://www.urai.app/*"
    ]
  },
  "initialCostControls": {
    "monthlyBudgetUsd": 50,
    "budgetAlertPercentages": [
      50,
      75,
      90,
      100
    ],
    "dailyRequestCaps": {
      "maps-javascript-api": 2500,
      "map-tiles-api": 1500,
      "places-api-new": 1000,
      "geocoding-api": 1000,
      "routes-api": 500,
      "maps-elevation-api": 500,
      "roads-api": 500,
      "time-zone-api": 500,
      "weather-api": 500,
      "aerial-view-api": 100,
      "arcore-api": 500
    },
    "increaseOnlyAfterMeasuredDemand": true
  },
  "requiredReceiptsBeforeProductionUse": [
    "project-id-verification",
    "enabled-api-list",
    "key-name-and-restriction-summary-without-secret-values",
    "quota-configuration",
    "budget-and-alert-configuration",
    "preview-origin-smoke-test",
    "production-origin-smoke-test-after-protected-deploy",
    "rollback-and-key-rotation-drill"
  ],
  "providerServiceState": {
    "status": "requires-fresh-read-only-wif-audit",
    "expectedServices": [
      "maps-backend.googleapis.com",
      "tile.googleapis.com",
      "places-backend.googleapis.com",
      "geocoding-backend.googleapis.com",
      "routes.googleapis.com",
      "elevation-backend.googleapis.com",
      "roads.googleapis.com",
      "timezone-backend.googleapis.com",
      "weather.googleapis.com",
      "aerialview.googleapis.com",
      "arcore.googleapis.com"
    ],
    "previousVerifiedSubset": [
      "maps-backend.googleapis.com",
      "geocoding-backend.googleapis.com"
    ],
    "previousObservedByNonMutatingAuditRun": "30703085166",
    "serviceEnablementMutationPerformedByThisLane": false,
    "note": "User reported enabling the broader stack on 2026-09-25; repository authority does not promote that report to VERIFIED until dedicated read-only WIF observes the exact service list."
  },
  "activation": {
    "restrictedKeysCreated": false,
    "quotasConfigured": false,
    "budgetAlertsConfigured": false,
    "previewOriginVerified": false,
    "productionOriginVerified": false,
    "rollbackAndRotationDrillVerified": false,
    "productionUseAuthorized": false,
    "reason": "Full world-stack allowlist is governed in source, but fresh read-only service-state proof, key restriction readback, quotas/budgets, origin smoke and runtime integration remain required."
  }
}
