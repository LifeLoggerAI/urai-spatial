{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git branch*)",
      "Bash(git worktree*)",
      "Bash(pnpm doctor*)",
      "Bash(pnpm check:types*)",
      "Bash(pnpm test:canon*)",
      "Bash(pnpm test:unit*)",
      "Bash(pnpm test:integration*)",
      "Bash(pnpm test:e2e*)",
      "Bash(pnpm test:visual:spatial*)",
      "Bash(pnpm runtime:authority*)",
      "Bash(pnpm home:invariant*)",
      "Bash(pnpm verify:release:critical*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/secrets/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git clean -xfd*)",
      "Bash(rm -rf *)"
    ]
  }
}
