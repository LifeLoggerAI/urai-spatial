{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urai://ewi/permission-grant/1.0.0",
  "title": "URAI EWI PermissionGrant v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "grantId", "subjectId", "resource", "capabilities", "purposes", "allowedActionClasses", "issuedAt", "status", "processing", "retention"],
  "properties": {
    "version": {"const": "1.0.0"},
    "grantId": {"type": "string", "minLength": 8, "maxLength": 160},
    "subjectId": {"type": "string", "minLength": 1, "maxLength": 160},
    "resource": {"type": "string", "minLength": 1, "maxLength": 200},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 160}, "uniqueItems": true},
    "purposes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 240}, "uniqueItems": true},
    "allowedActionClasses": {"type": "array", "items": {"enum": ["silent_auto", "reversible_auto", "ask_first", "strong_confirmation", "never_autonomous"]}, "uniqueItems": true},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["active", "revoked", "expired", "suspended"]},
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locations", "recipients"],
      "properties": {
        "locations": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 120}, "uniqueItems": true},
        "recipients": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 160}, "uniqueItems": true}
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["none", "session", "bounded", "policy_defined"]},
        "maxDays": {"type": "integer", "minimum": 0, "maximum": 36500}
      }
    },
    "revokedAt": {"type": "string", "format": "date-time"},
    "auditRef": {"type": "string", "maxLength": 240}
  }
}