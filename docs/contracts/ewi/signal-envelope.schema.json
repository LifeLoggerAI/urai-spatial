{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urai://ewi/signal-envelope/1.0.0",
  "title": "URAI EWI SignalEnvelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "signalId", "subjectId", "source", "eventType", "timestamp", "confidence", "sensitivity", "permissionRefs", "provenance", "payload"],
  "properties": {
    "version": {"const": "1.0.0"},
    "signalId": {"type": "string", "minLength": 8, "maxLength": 160},
    "subjectId": {"type": "string", "minLength": 1, "maxLength": 160},
    "deviceId": {"type": "string", "minLength": 1, "maxLength": 160},
    "source": {"type": "string", "minLength": 1, "maxLength": 160},
    "integrationId": {"type": "string", "minLength": 1, "maxLength": 160},
    "eventType": {"type": "string", "minLength": 1, "maxLength": 200},
    "timestamp": {"type": "string", "format": "date-time"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "sensitivity": {"enum": ["public", "internal", "personal", "sensitive", "highly_sensitive", "restricted"]},
    "dataClasses": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 120}, "uniqueItems": true},
    "permissionRefs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 200}, "uniqueItems": true},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "receivedAt"],
      "properties": {
        "origin": {"type": "string", "minLength": 1, "maxLength": 200},
        "providerEventId": {"type": "string", "maxLength": 256},
        "receivedAt": {"type": "string", "format": "date-time"},
        "derivedFrom": {"type": "array", "items": {"type": "string", "maxLength": 200}, "uniqueItems": true}
      }
    },
    "payload": {"type": "object"}
  }
}