{
  "name": "urai-spatial-monorepo",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "urai-tier1",
    "apps/functions",
    "packages/tier-locks"
  ],
  "scripts": {
    "dev": "pnpm --filter urai-tier1 dev",
    "dev:3001": "pnpm --dir urai-tier1 exec next dev --hostname 0.0.0.0 --port 3001",
    "build": "node scripts/prepare-low-disk-build.mjs && pnpm --filter urai-tier1 build",
    "build:static": "node scripts/prepare-low-disk-build.mjs && URAI_FIREBASE_STATIC_EXPORT=true pnpm --dir urai-tier1 exec next build",
    "start": "pnpm --filter urai-tier1 start",
    "lint": "pnpm --filter urai-tier1 lint",
    "next-export": "node scripts/prepare-low-disk-build.mjs && URAI_FIREBASE_STATIC_EXPORT=true pnpm --dir urai-tier1 exec next build",
    "clean:next": "node scripts/clean-next-state.mjs",
    "fresh:dev": "pnpm clean:next && pnpm dev:3001",
    "smoke:3001": "HOST=http://127.0.0.1:3001 pnpm smoke",
    "ship:check": "pnpm -r --if-present test",
    "check:lockfile": "node scripts/check-lockfile-present.mjs",
    "check:runtime-boundary": "node scripts/check-runtime-boundary.mjs",
    "verify:root": "pnpm check:runtime-boundary && pnpm runtime:authority",
    "check:source-integrity": "node scripts/check-source-integrity.mjs",
    "check:production-routes": "node scripts/check-production-route-exposure.mjs",
    "check:spatial-copy": "node scripts/check-spatial-copy.mjs",
    "check:public-copy": "pnpm check:spatial-copy",
    "check:launch-boundary-contract": "node scripts/check-launch-boundary-contract.mjs",
    "check:v1": "pnpm tier1:check",
    "check:types": "pnpm typecheck",
    "typecheck": "pnpm --filter urai-tier1 typecheck",
    "smoke": "node scripts/smoke-routes.mjs",
    "check:spatial": "node scripts/check-spatial-invariant.mjs",
    "launch:local": "node scripts/run-local-launch-check.mjs",
    "launch:check": "pnpm launch:local",
    "xr:contract": "pnpm --dir urai-tier1 run xr:contract",
    "xr:navmesh:bake": "pnpm --dir urai-tier1 run xr:navmesh:bake",
    "xr:verify": "pnpm --dir urai-tier1 run xr:verify && node scripts/xr-firebase-preflight.mjs",
    "deploy:xr:firebase": "pnpm xr:verify && firebase deploy --only hosting --project ${FIREBASE_PROJECT_ID:-urai-4dc1d}",
    "deploy:xr:firebase:static": "pnpm xr:verify && pnpm build:static && firebase deploy --config firebase.static.json --only hosting --project ${FIREBASE_PROJECT_ID:-urai-4dc1d}",
    "deploy:staging": "pnpm launch:check && firebase deploy --only hosting",
    "deploy:prod": "pnpm launch:check && firebase deploy --only hosting",
    "frb": "pnpm deploy:staging",
    "release:check": "pnpm launch:local",
    "release:p1": "pnpm release:check",
    "live:check": "node scripts/live-release.mjs --check",
    "live:deploy": "node scripts/live-release.mjs --deploy",
    "live:record": "node scripts/record-live-status.mjs",
    "publish:live": "pnpm live:deploy",
    "test:unit": "pnpm --filter urai-tier1 test:unit",
    "test:integration": "pnpm test:canon",
    "test:rules": "pnpm firebase:rules:check",
    "test:smoke": "pnpm smoke",
    "canon:lock": "node scripts/check-tier1-canon-lock.mjs",
    "test": "pnpm --filter urai-functions build && pnpm --filter urai-functions test && pnpm --filter urai-tier1 test && node scripts/run-optional-e2e.mjs && pnpm test:replay-tier5",
    "test:e2e": "pnpm playwright:check && node tests/spatial-lock.mjs",
    "test:e2e:lock": "pnpm test:e2e && pnpm test:tier-lock-hardening",
    "test:e2e:navigation-stack": "pnpm playwright:check && node tests/spatial-tier-lock-hardening.mjs --suite=navigation",
    "test:e2e:camera-transitions": "pnpm playwright:check && node tests/spatial-tier-lock-hardening.mjs --suite=camera",
    "test:e2e:race-conditions": "pnpm playwright:check && node tests/spatial-tier-lock-hardening.mjs --suite=race",
    "test:e2e:data-states": "pnpm playwright:check && node tests/spatial-tier-lock-hardening.mjs --suite=data",
    "test:visual:spatial": "pnpm playwright:check && node tests/spatial-tier-lock-hardening.mjs --suite=visual",
    "test:tier-lock-hardening": "pnpm playwright:check && node tests/spatial-tier-lock-hardening.mjs --suite=all",
    "audit:video-frames": "node scripts/audit-video-frames.mjs",
    "test:playwright": "node scripts/run-playwright-tests.mjs",
    "test:firestore-rules": "node scripts/run-firestore-rules-tests.mjs",
    "test:replay-contract": "node tests/replay-memory-theater-contract.mjs",
    "test:replay-tier5": "pnpm test:replay-contract && node tests/replay-tier5-lock.mjs",
    "playwright:install": "pnpm exec playwright install chromium",
    "playwright:install-deps": "pnpm exec playwright install-deps chromium",
    "playwright:check": "node scripts/check-playwright-runtime.mjs",
    "playwright:ensure": "node scripts/check-playwright-runtime.mjs --auto-install",
    "preflight": "node ./scripts/preflight.mjs",
    "runtime:authority": "node scripts/check-runtime-authority.mjs",
    "canon:check": "node scripts/canon-lock.mjs",
    "canon:drift": "node scripts/check-tier1-drift.mjs",
    "test:canon-lock": "node tests/canon-lock.mjs",
    "locs:check": "node scripts/check-locs-hierarchy.mjs",
    "tier:check": "node scripts/check-tier-drift.mjs",
    "test:canon": "pnpm tier1:immutable:check && pnpm tier1:redefinition:check && pnpm tier2:check && pnpm runtime:authority && pnpm canon:check && pnpm locs:check && pnpm tier:check && node scripts/check-canon-imports.mjs && pnpm migration:check && pnpm home:invariant && pnpm firebase:rules:check",
    "migration:check": "node scripts/check-migration-markers.mjs",
    "tier1:check": "pnpm canon:lock && pnpm tier1:immutable:check && pnpm tier1:redefinition:check && pnpm check:runtime-boundary && pnpm runtime:authority && pnpm home:invariant && pnpm firebase:rules:check",
    "audit:tier-one": "pnpm tier1:check && pnpm test:rules && pnpm typecheck && pnpm build",
    "tier1:drift": "node scripts/check-tier1-drift.mjs",
    "tier1:immutable:check": "node scripts/check-tier1-immutable-diff.mjs",
    "tier1:redefinition:check": "node scripts/check-tier1-redefinition.mjs",
    "home:invariant": "node scripts/check-home-invariant.mjs",
    "firebase:rules:check": "node scripts/check-firestore-tier1-boundaries.mjs",
    "tier2:check": "node scripts/check-tier2-governance.mjs",
    "urai:tier1": "pnpm --filter urai-tier1 urai:tier1",
    "urai:tier2": "pnpm --filter urai-tier1 urai:tier2",
    "urai:tier3": "pnpm --filter urai-tier1 urai:tier3",
    "urai:tier4": "pnpm --filter urai-tier1 urai:tier4",
    "urai:tier5": "pnpm --filter urai-tier1 urai:tier5",
    "verify:launch": "pnpm lock:static && pnpm lock:build && pnpm launch:check",
    "verify:release": "pnpm lock:all",
    "verify:release:full": "pnpm lock:all && pnpm test",
    "lock:static": "pnpm check:runtime-boundary && pnpm check:source-integrity && pnpm check:production-routes && pnpm check:spatial-copy && pnpm check:launch-boundary-contract && pnpm tier:check && pnpm migration:check && pnpm home:invariant && pnpm firebase:rules:check",
    "lock:build": "pnpm typecheck && pnpm build",
    "lock:e2e": "pnpm test:e2e",
    "lock:all": "pnpm lock:static && pnpm lock:build && pnpm lock:e2e",
    "tier3:check": "node scripts/check-tier3-governance.mjs",
    "tier4:check": "node scripts/check-tier4-governance.mjs",
    "tier5:check": "node scripts/check-tier5-governance.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/three": "^0.183.1",
    "firebase-tools": "^14.27.0",
    "pnpm": "^8.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.7.0",
    "postprocessing": "^6.38.3",
    "stripe": "^19.3.0",
    "three": "^0.183.2",
    "zustand": "^5.0.11"
  },
  "type": "module"
}
