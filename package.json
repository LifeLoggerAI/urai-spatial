{
  "name": "urai-spatial-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter spatial-web dev",
    "build": "pnpm --filter spatial-web build",
    "start": "pnpm --filter spatial-web start",
    "lint": "pnpm --filter spatial-web lint",
    "next-export": "pnpm --filter spatial-web next export",
    "ship:check": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "pnpm": "^8.0.0"
  }
}
