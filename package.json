{
  "name": "urai-spatial-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter urai-tier1 dev",
    "build": "pnpm --filter urai-tier1 build",
    "start": "pnpm --filter urai-tier1 start",
    "lint": "pnpm --filter urai-tier1 lint",
    "next-export": "pnpm --filter urai-tier1 next export",
    "ship:check": "pnpm -r --if-present test",
    "typecheck": "pnpm --filter urai-tier1 typecheck",
    "canon:lock": "node scripts/check-tier1-canon-lock.mjs",
    "test": "pnpm --filter urai-functions build && pnpm --filter urai-functions test && pnpm --filter urai-tier1 test && pnpm test:e2e && pnpm test:replay-tier5",
    "test:e2e": "node tests/run-e2e-guard.mjs",
    "test:replay-tier5": "node tests/run-replay-tier5-guard.mjs",
    "preflight": "node ./scripts/preflight.mjs",
    "canon:check": "node scripts/canon-lock.mjs",
    "canon:drift": "node scripts/canon-lock.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "test:canon-lock": "node tests/canon-lock.mjs",
    "locs:check": "node scripts/check-locs-hierarchy.mjs",
    "tier:check": "node scripts/check-tier-drift.mjs",
    "test:canon": "pnpm canon:check && pnpm locs:check && pnpm tier:check && node scripts/check-canon-imports.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/three": "^0.183.1",
    "pnpm": "^8.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.7.0",
    "postprocessing": "^6.38.3",
    "stripe": "^19.3.0",
    "three": "^0.183.2",
    "zustand": "^5.0.11"
  }
}
