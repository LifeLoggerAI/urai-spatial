# URAI Spatial local environment example
# Copy to .env.local for local development. Do not commit real secrets.

# Firebase public web config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=urai-spatial
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# V1 demo data
NEXT_PUBLIC_URAI_DEMO_USER_ID=demo-user

# Launch/runtime toggles
NEXT_PUBLIC_URAI_DEBUG_SPATIAL=false
NEXT_PUBLIC_URAI_MANIFEST_FIRESTORE=false
NEXT_PUBLIC_URAI_MANIFEST_OWNER_ID=launch-demo
NEXT_PUBLIC_URAI_DISABLE_DEMO_FALLBACK=false
NEXT_PUBLIC_URAI_REQUIRE_TIER_GATE=false

# Security / admin defaults
ADMIN_ALLOWLIST=@urai.app
SPATIAL_PUBLIC_PREVIEW=true

# Optional Core Adapter
CORE_DB_PATH=projects/urai-core/databases/(default)/documents

# Optional STT
STT_PROXY_ENABLED=false

# Optional voice/narrator integrations
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# CI / deploy secrets are configured in GitHub Actions or Firebase, not in .env.local
FIREBASE_SERVICE_ACCOUNT_URAI_SPATIAL=
URAI_SPATIAL_FIREBASE_PROJECT_ID=
URAI_SPATIAL_FIREBASE_WEB_CONFIG=
