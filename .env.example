# URAI Spatial local environment example
# Copy to .env.local for local development. Do not commit real secrets.

# Firebase public web config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=urai-spatial
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# V1 demo data
NEXT_PUBLIC_URAI_DEMO_USER_ID=demo-user

# Launch/runtime toggles
NEXT_PUBLIC_URAI_DEBUG_SPATIAL=false
NEXT_PUBLIC_URAI_MANIFEST_FIRESTORE=false
NEXT_PUBLIC_URAI_MANIFEST_OWNER_ID=launch-demo
NEXT_PUBLIC_URAI_DISABLE_DEMO_FALLBACK=false
NEXT_PUBLIC_URAI_REQUIRE_TIER_GATE=false

# Security / admin defaults
ADMIN_ALLOWLIST=@urai.app
SPATIAL_PUBLIC_PREVIEW=true

# Optional Core Adapter
CORE_DB_PATH=projects/urai-core/databases/(default)/documents

# Optional STT
STT_PROXY_ENABLED=false

# Optional voice/narrator integrations
# In Firebase production, store ELEVENLABS_API_KEY in Secret Manager. Never commit its value.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_DEFAULT_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_ALLOWED_VOICE_IDS=pNInz6obpgDQGcFmaJgB
NEXT_PUBLIC_URAI_ELEVENLABS_DEFAULT_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Non-secret Firebase release configuration.
URAI_SPATIAL_FIREBASE_PROJECT_ID=
URAI_SPATIAL_FIREBASE_WEB_CONFIG=

# Google/Firebase server authentication must use managed ADC or a protected
# external_account Workload Identity Federation configuration supplied by the
# runtime/CI environment. Do not place service-account JSON, private keys, or
# Firebase CI tokens in .env.local or repository secrets.
