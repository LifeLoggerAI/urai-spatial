{
  "hosting": {
    "public": "urai-tier1/out",
    "ignore": [
      "firebase.preview.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/api/urai/orb/openai",
        "function": {
          "functionId": "openAiOrbProvider",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/urai/narrator/elevenlabs",
        "function": {
          "functionId": "elevenLabsVoiceProvider",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/voice/elevenlabs",
        "function": {
          "functionId": "elevenLabsVoiceProvider",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/urai/adam/conversation",
        "function": {
          "functionId": "adamPresenceProvider",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/urai/adam/voice",
        "function": {
          "functionId": "adamFounderVoiceProvider",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/urai/council/anthropic",
        "function": {
          "functionId": "anthropicCouncilProvider",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/urai/council/gemini",
        "function": {
          "functionId": "geminiCouncilProvider",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/urai/council/xai",
        "function": {
          "functionId": "xaiCouncilProvider",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/urai/council/mistral",
        "function": {
          "functionId": "mistralCouncilProvider",
          "region": "us-central1"
        }
      }
    ]
  }
}
