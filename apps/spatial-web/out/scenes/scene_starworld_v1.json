        },
        {
          "kind": "Portal",
          "data": {
            "targetScene": "scene_memoryroom_v1",
            "transition": "warpZoom",
            "gateRadius": 1.0
          }
        },
        {
          "kind": "Interactable",
          "data": {
            "interaction": "tapOrGaze",
            "hint": "Enter Memory"
          }
        }
      ]
    },
    {
      "id": "trigger_room_assemble",
      "type": "prop",
      "name": "Room Assemble Trigger",
      "transform": {
        "position": { "x": 0, "y": 1.2, "z": 1.6 },
        "rotation": { "x": 0, "y": 0, "z": 0 },
        "scale": { "x": 2.2, "y": 2.2, "z": 2.2 }
      },
      "components": [
        {
          "kind": "TriggerZone",
          "data": {
            "shape": "sphere",
            "radius": 1.2,
            "onEnter": [{ "event": "memoryRoom.assemble", "targetEntityId": "assembler_01" }]
          }
        }
      ]
    },
    {
      "id": "assembler_01",
      "type": "room",
      "name": "Memory Room Assembler",
      "tags": ["memoryRoom", "assembler"],
      "transform": {
        "position": { "x": 0, "y": 0, "z": 0 },
        "rotation": { "x": 0, "y": 0, "z": 0 },
        "scale": { "x": 1, "y": 1, "z": 1 }
      },
      "components": [
        {
          "kind": "MemoryRoomAssembler",
          "data": {
            "template": "bedroom_basic_v1",
            "roomShell": { "assetId": "asset_room_shell_glb", "useBuild": "LATEST" },
            "props": { "assetId": "asset_room_props_glb", "useBuild": "LATEST" },
            "cast": [
