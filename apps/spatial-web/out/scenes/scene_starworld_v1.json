                "id": "char_01",
                "assetId": "asset_character_placeholder_glb",
                "spawn": { "anchor": "door_left", "delayMs": 2200 }
              },
              {
                "id": "char_02",
                "assetId": "asset_character_placeholder_glb",
                "spawn": { "anchor": "door_right", "delayMs": 3800 }
              }
            ],
            "phases": [
              { "name": "starfield_hold", "durationMs": 600, "fx": ["fog_pulse"] },
              { "name": "outline_walls", "durationMs": 900, "fx": ["wireframe_walls"] },
              { "name": "materialize_shell", "durationMs": 1200, "fx": ["dust_settle", "light_warmup"] },
              { "name": "spawn_props", "durationMs": 900, "fx": ["prop_pop_soft"] },
              { "name": "spawn_cast", "durationMs": 1800, "fx": ["door_bloom", "ambient_shift"] },
              { "name": "lock_in", "durationMs": 600, "fx": ["bloom_settle"] }
            ],
            "cameraBeats": [
              { "atPhase": "outline_walls", "action": "slowPushIn", "amount": 0.6 },
              { "atPhase": "spawn_cast", "action": "microOrbit", "amount": 0.35 }
            ],
            "narrationCues": [
              { "atPhase": "materialize_shell", "key": "narration.room_forms" },
              { "atPhase": "spawn_cast", "key": "narration.someone_enters" }
            ]
          }
        }
      ]
    }
