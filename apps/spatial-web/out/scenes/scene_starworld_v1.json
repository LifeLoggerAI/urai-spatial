        "scale": { "x": 1, "y": 1, "z": 1 }
      },
      "components": [
        {
          "kind": "Light",
          "data": { "lightType": "directional", "intensity": 1.2, "castShadows": true }
        }
      ]
    },
    {
      "id": "portal_01",
      "type": "portal",
