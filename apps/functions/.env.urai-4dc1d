# Non-secret ElevenLabs runtime configuration for URAI Spatial Firebase project.
# Keep ELEVENLABS_API_KEY in Google Secret Manager; never place it here.
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_ALLOWED_VOICE_IDS=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_MAX_CHARACTERS_PER_REQUEST=1200

# Adam Presence remains fail-closed until the accepted private Founder identity is configured.
ADAM_PRESENCE_ENABLED=false
FOUNDER_VOICE_ENABLED=false
FOUNDER_ELEVENLABS_VOICE_ID=
FOUNDER_VOICE_MAX_CHARACTERS_PER_REQUEST=900
