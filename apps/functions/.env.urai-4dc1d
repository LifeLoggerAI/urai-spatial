# Non-secret ElevenLabs runtime configuration for URAI Spatial Firebase project.
# Keep ELEVENLABS_API_KEY in Google Secret Manager; never place it here.
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_ALLOWED_VOICE_IDS=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_MAX_CHARACTERS_PER_REQUEST=1200
ELEVENLABS_MAX_RESPONSE_BYTES=8388608
