# Non-secret ElevenLabs runtime configuration for URAI Spatial Firebase project.
# Keep ELEVENLABS_API_KEY in Google Secret Manager; never place it here.
ELEVENLABS_DEFAULT_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_ALLOWED_VOICE_IDS=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_MAX_CHARACTERS_PER_REQUEST=1200


# DigitalOcean Serverless Inference canary. Secret value belongs in Google Secret Manager.
# Keep disabled until DIGITALOCEAN_MODEL_ACCESS_KEY exists and a bounded live canary is authorized.
URAI_ENABLE_DIGITALOCEAN=false
DIGITALOCEAN_MODEL_ID=openai-gpt-oss-20b
